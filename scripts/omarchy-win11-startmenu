def build_css(dark=True, transparent=True):
    if dark:
        bg_color = "rgba(32, 32, 36, 0.85)" if transparent else "#202024"
        sub_bg = "rgba(24, 24, 28, 0.90)" if transparent else "#18181c"
        border_color = "rgba(255, 255, 255, 0.12)"
        search_bg = "rgba(255, 255, 255, 0.08)"
        search_focus = "rgba(255, 255, 255, 0.12)"
        text_color = "#ffffff"
        text_muted = "rgba(255, 255, 255, 0.65)"
        hover_bg = "rgba(255, 255, 255, 0.09)"
        accent_color = "#60cdff"
    else:
        bg_color = "rgba(245, 245, 248, 0.88)" if transparent else "#f5f5f8"
        sub_bg = "rgba(235, 235, 240, 0.92)" if transparent else "#ebebf0"
        border_color = "rgba(0, 0, 0, 0.10)"
        search_bg = "rgba(0, 0, 0, 0.05)"
        search_focus = "rgba(0, 0, 0, 0.08)"
        text_color = "#1a1a1a"
        text_muted = "rgba(0, 0, 0, 0.60)"
        hover_bg = "rgba(0, 0, 0, 0.06)"
        accent_color = "#0067c0"

    return f"""
    window.win11-start-window {{
        background-color: {bg_color};
        border-radius: 16px;
        border: 1px solid {border_color};
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.65);
    }}

    .search-container {{
        background-color: {search_bg};
        border-radius: 20px;
        border: 1.5px solid {border_color};
        padding: 4px 12px;
        transition: all 0.15s ease;
    }}
    .search-container:focus-within {{
        background-color: {search_focus};
        border-color: {accent_color};
    }}

    .search-entry {{
        background: transparent;
        border: none;
        box-shadow: none;
        color: {text_color};
        font-family: 'Segoe UI', sans-serif;
        font-size: 13px;
    }}
    .search-entry:focus {{
        border: none;
        box-shadow: none;
        outline: none;
    }}

    .section-title {{
        font-family: 'Segoe UI', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: {text_color};
    }}

    .all-apps-btn {{
        background-color: transparent;
        border-radius: 6px;
        padding: 4px 10px;
        border: none;
        color: {accent_color};
        font-family: 'Segoe UI', sans-serif;
        font-size: 11.5px;
        font-weight: 600;
    }}
    .all-apps-btn:hover {{
        background-color: {hover_bg};
    }}

    .pinned-tile {{
        background-color: transparent;
        border-radius: 8px;
        padding: 6px 2px;
        min-width: 82px;
        min-height: 72px;
        border: none;
        transition: background-color 0.12s ease, transform 0.12s ease;
    }}
    .pinned-tile:hover {{
        background-color: {hover_bg};
    }}

    .pinned-icon {{
        font-size: 26px;
    }}

    .pinned-label {{
        font-family: 'Segoe UI', sans-serif;
        font-size: 11px;
        font-weight: 500;
        color: {text_color};
        margin-top: 2px;
    }}

    .rec-item {{
        background-color: transparent;
        border-radius: 8px;
        padding: 6px 10px;
        border: none;
        transition: background-color 0.12s ease;
    }}
    .rec-item:hover {{
        background-color: {hover_bg};
    }}

    .rec-title {{
        font-family: 'Segoe UI', sans-serif;
        font-size: 12px;
        font-weight: 600;
        color: {text_color};
    }}

    .rec-sub {{
        font-family: 'Segoe UI', sans-serif;
        font-size: 10.5px;
        color: {text_muted};
    }}

    .bottom-strip {
        background-color: {sub_bg};
        border-top: 1px solid {border_color};
        padding: 8px 16px;
        border-bottom-left-radius: 16px;
        border-bottom-right-radius: 16px;
    }

    .user-pill {
        background-color: transparent;
        border-radius: 8px;
        padding: 4px 10px;
        border: none;
    }
    .user-pill:hover {
        background-color: {hover_bg};
    }

    .user-avatar-badge {
        background: linear-gradient(135deg, #0078d4, #60cdff);
        color: #ffffff;
        font-weight: 700;
        font-size: 13px;
        border-radius: 50%;
        min-width: 32px;
        min-height: 32px;
    }

    .power-btn {
        background-color: transparent;
        border-radius: 8px;
        padding: 6px 12px;
        border: none;
        color: {text_color};
        font-size: 18px;
    }
    .power-btn:hover {
        background-color: {hover_bg};
    }

    .popover-acrylic {
        background-color: {bg_color};
        border-radius: 12px;
        border: 1px solid {border_color};
        padding: 6px;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
    }

    .power-action-row {
        background-color: transparent;
        border-radius: 8px;
        padding: 8px 12px;
        border: none;
        min-width: 220px;
        transition: background-color 0.12s ease;
    }
    .power-action-row:hover {
        background-color: {hover_bg};
    }

    .action-title {
        font-family: 'Segoe UI', sans-serif;
        font-size: 12.5px;
        font-weight: 600;
        color: {text_color};
    }

    .action-sub {
        font-family: 'Segoe UI', sans-serif;
        font-size: 10px;
        color: {text_muted};
    }

    .app-drawer-row {
        background-color: transparent;
        border-radius: 8px;
        padding: 6px 10px;
        border: none;
    }
    .app-drawer-row:hover {
        background-color: {hover_bg};
    }
    """

class Win11StartMenuWindow(Gtk.Window):
    def __init__(self, app):
        super().__init__(application=app, title="Windows 11 Start Menu")
        self.set_default_size(600, 680)
        self.set_resizable(False)
        self.set_decorated(False)
        self.add_css_class("win11-start-window")

        self.dark = is_dark_mode()
        self.transparent = is_transparency_enabled()

        # Load CSS
        css_data = build_css(dark=self.dark, transparent=self.transparent)
        provider = Gtk.CssProvider()
        provider.load_from_data(css_data.encode())
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        # Key controller for Escape key auto-dismiss
        key_controller = Gtk.EventControllerKey()
        key_controller.connect("key-pressed", self.on_key_pressed)
        self.add_controller(key_controller)

        # Focus / Click-away controller
        focus_controller = Gtk.EventControllerFocus()
        focus_controller.connect("leave", self.on_focus_leave)
        self.add_controller(focus_controller)

        # Main Layout Box
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_child(main_box)

        # Content container
        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        content_box.set_margin_top(18)
        content_box.set_margin_bottom(12)
        content_box.set_margin_start(20)
        content_box.set_margin_end(20)
        content_box.set_vexpand(True)
        main_box.append(content_box)

        # 1. Search Bar
        search_wrap = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        search_wrap.add_css_class("search-container")

        lbl_search_ico = Gtk.Label(label="🔍")
        lbl_search_ico.set_margin_start(4)
        search_wrap.append(lbl_search_ico)

        self.search_entry = Gtk.Entry()
        self.search_entry.set_placeholder_text("Type here to search apps, settings, and documents...")
        self.search_entry.add_css_class("search-entry")
        self.search_entry.set_hexpand(True)
        self.search_entry.connect("changed", self.on_search_changed)
        self.search_entry.connect("activate", self.on_search_activate)
        search_wrap.append(self.search_entry)

        # Clear button
        self.btn_clear = Gtk.Button(label="✕")
        self.btn_clear.add_css_class("all-apps-btn")
        self.btn_clear.set_visible(False)
        self.btn_clear.connect("clicked", lambda b: self.clear_search())
        search_wrap.append(self.btn_clear)

        content_box.append(search_wrap)

        # 2. Main View Stack (Pinned Grid vs All Apps vs Search Results)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(150)
        self.stack.set_vexpand(True)
        content_box.append(self.stack)

        # --- VIEW 0: PINNED & RECOMMENDED ---
        self.view_pinned = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        
        # Pinned Header
        pinned_hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        lbl_pinned = Gtk.Label(label="Pinned")
        lbl_pinned.add_css_class("section-title")
        lbl_pinned.set_halign(Gtk.Align.START)
        lbl_pinned.set_hexpand(True)
        pinned_hdr.append(lbl_pinned)

        btn_all_apps = Gtk.Button(label="All apps >")
        btn_all_apps.add_css_class("all-apps-btn")
        btn_all_apps.connect("clicked", lambda b: self.switch_view("all_apps"))
        pinned_hdr.append(btn_all_apps)
        self.view_pinned.append(pinned_hdr)

        # 6x3 Pinned Grid
        grid_pinned = Gtk.Grid()
        grid_pinned.set_column_spacing(6)
        grid_pinned.set_row_spacing(6)
        grid_pinned.set_column_homogeneous(True)

        for idx, (icon, name, cmd) in enumerate(PINNED_APPS):
            btn = Gtk.Button()
            btn.add_css_class("pinned-tile")
            
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            lbl_ico = Gtk.Label(label=icon)
            lbl_ico.add_css_class("pinned-icon")
            
            lbl_nm = Gtk.Label(label=name)
            lbl_nm.add_css_class("pinned-label")
            
            box.append(lbl_ico)
            box.append(lbl_nm)
            btn.set_child(box)
            btn.connect("clicked", lambda b, c=cmd: self.launch_cmd(c))
            
            grid_pinned.attach(btn, idx % 6, idx // 6, 1, 1)

        self.view_pinned.append(grid_pinned)

        # Recommended Section
        rec_hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        rec_hdr.set_margin_top(8)
        lbl_rec = Gtk.Label(label="Recommended")
        lbl_rec.add_css_class("section-title")
        lbl_rec.set_halign(Gtk.Align.START)
        rec_hdr.append(lbl_rec)
        self.view_pinned.append(rec_hdr)

        grid_rec = Gtk.Grid()
        grid_rec.set_column_spacing(10)
        grid_rec.set_row_spacing(4)
        grid_rec.set_column_homogeneous(True)

        for idx, (icon, name, time_ago, cmd) in enumerate(RECOMMENDED_ITEMS):
            btn = Gtk.Button()
            btn.add_css_class("rec-item")
            
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            lbl_ico = Gtk.Label(label=icon)
            lbl_ico.set_margin_start(4)
            
            txt_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            lbl_title = Gtk.Label(label=name)
            lbl_title.add_css_class("rec-title")
            lbl_title.set_halign(Gtk.Align.START)
            lbl_title.set_ellipsize(3) # PANGO_ELLIPSIZE_END
            
            lbl_sub = Gtk.Label(label=time_ago)
            lbl_sub.add_css_class("rec-sub")
            lbl_sub.set_halign(Gtk.Align.START)
            
            txt_box.append(lbl_title)
            txt_box.append(lbl_sub)
            
            row.append(lbl_ico)
            row.append(txt_box)
            btn.set_child(row)
            btn.connect("clicked", lambda b, c=cmd: self.launch_cmd(c))
            
            grid_rec.attach(btn, idx % 2, idx // 2, 1, 1)

        self.view_pinned.append(grid_rec)
        self.stack.add_named(self.view_pinned, "pinned")

        # --- VIEW 1: ALL APPS DRAWER ---
        self.view_all_apps = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        
        all_hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        btn_back = Gtk.Button(label="< Back")
        btn_back.add_css_class("all-apps-btn")
        btn_back.connect("clicked", lambda b: self.switch_view("pinned"))
        all_hdr.append(btn_back)

        lbl_all = Gtk.Label(label="All Apps")
        lbl_all.add_css_class("section-title")
        lbl_all.set_margin_start(8)
        all_hdr.append(lbl_all)
        self.view_all_apps.append(all_hdr)

        scroll_all = Gtk.ScrolledWindow()
        scroll_all.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll_all.set_vexpand(True)

        list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        for icon, name, category, cmd in ALL_APPS_LIST:
            btn = Gtk.Button()
            btn.add_css_class("app-drawer-row")
            
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            lbl_ico = Gtk.Label(label=icon)
            lbl_ico.set_margin_start(6)
            
            lbl_nm = Gtk.Label(label=name)
            lbl_nm.add_css_class("rec-title")
            lbl_nm.set_halign(Gtk.Align.START)
            lbl_nm.set_hexpand(True)
            
            row.append(lbl_ico)
            row.append(lbl_nm)
            btn.set_child(row)
            btn.connect("clicked", lambda b, c=cmd: self.launch_cmd(c))
            list_box.append(btn)

        scroll_all.set_child(list_box)
        self.view_all_apps.append(scroll_all)
        self.stack.add_named(self.view_all_apps, "all_apps")

        # --- VIEW 2: SEARCH RESULTS ---
        self.view_search = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scroll_search = Gtk.ScrolledWindow()
        scroll_search.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll_search.set_vexpand(True)

        self.search_results_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        scroll_search.set_child(self.search_results_box)
        self.view_search.append(scroll_search)
        self.stack.add_named(self.view_search, "search")

        # 3. Bottom User & Power Bar
        bottom_strip = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        bottom_strip.add_css_class("bottom-strip")

        # User Pill
        btn_user = Gtk.Button()
        btn_user.add_css_class("user-pill")
        user_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        
        # Initial letter avatar circle
        initial = (USERNAME[:1] if USERNAME else "U").upper()
        u_avatar = Gtk.Label(label=initial)
        u_avatar.add_css_class("user-avatar-badge")
        u_avatar.set_size_request(32, 32)

        user_text_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        u_name = Gtk.Label(label=USERNAME.capitalize())
        u_name.add_css_class("rec-title")
        u_name.set_halign(Gtk.Align.START)
        
        u_sub = Gtk.Label(label="Personal Account")
        u_sub.add_css_class("rec-sub")
        u_sub.set_halign(Gtk.Align.START)

        user_text_col.append(u_name)
        user_text_col.append(u_sub)

        user_box.append(u_avatar)
        user_box.append(user_text_col)
        btn_user.set_child(user_box)
        btn_user.connect("clicked", self.open_user_popover)

        # Power Button
        btn_power = Gtk.Button()
        btn_power.add_css_class("power-btn")
        p_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        p_ico = Gtk.Label(label="⏻")
        p_ico.set_margin_start(4)
        p_ico.set_margin_end(4)
        p_box.append(p_ico)
        btn_power.set_child(p_box)
        btn_power.connect("clicked", self.open_power_popover)

        bottom_strip.append(btn_user)
        sep = Gtk.Box()
        sep.set_hexpand(True)
        bottom_strip.append(sep)
        bottom_strip.append(btn_power)

        main_box.append(bottom_strip)

    def switch_view(self, name):
        self.stack.set_visible_child_name(name)

    def clear_search(self):
        self.search_entry.set_text("")
        self.btn_clear.set_visible(False)
        self.switch_view("pinned")

    def on_search_changed(self, entry):
        query = entry.get_text().strip().lower()
        if not query:
            self.btn_clear.set_visible(False)
            self.switch_view("pinned")
            return

        self.btn_clear.set_visible(True)
        self.switch_view("search")

        # Clear previous search results
        while True:
            child = self.search_results_box.get_first_child()
            if child is None:
                break
            self.search_results_box.remove(child)

        matched = 0
        for icon, name, cat, cmd in ALL_APPS_LIST:
            if query in name.lower() or query in cmd.lower():
                matched += 1
                btn = Gtk.Button()
                btn.add_css_class("app-drawer-row")
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                lbl_ico = Gtk.Label(label=icon)
                lbl_ico.set_margin_start(6)
                lbl_nm = Gtk.Label(label=name)
                lbl_nm.add_css_class("rec-title")
                lbl_nm.set_halign(Gtk.Align.START)
                lbl_nm.set_hexpand(True)
                row.append(lbl_ico)
                row.append(lbl_nm)
                btn.set_child(row)
                btn.connect("clicked", lambda b, c=cmd: self.launch_cmd(c))
                self.search_results_box.append(btn)

        # Web search option at the bottom
        web_btn = Gtk.Button()
        web_btn.add_css_class("app-drawer-row")
        web_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        web_ico = Gtk.Label(label="🌐")
        web_ico.set_margin_start(6)
        web_lbl = Gtk.Label(label=f"Search web for '{query}'")
        web_lbl.add_css_class("rec-title")
        web_lbl.set_halign(Gtk.Align.START)
        web_lbl.set_hexpand(True)
        web_row.append(web_ico)
        web_row.append(web_lbl)
        web_btn.set_child(web_row)
        web_cmd = f"omarchy-browser 'https://www.bing.com/search?q={query}'"
        web_btn.connect("clicked", lambda b, c=web_cmd: self.launch_cmd(c))
        self.search_results_box.append(web_btn)

    def on_search_activate(self, entry):
        text = entry.get_text().strip()
        if not text:
            return
        query = text.lower()
        for icon, name, cat, cmd in ALL_APPS_LIST:
            if query in name.lower():
                self.launch_cmd(cmd)
                return
        self.launch_cmd(f"omarchy-browser 'https://www.bing.com/search?q={text}'")

    def on_key_pressed(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.destroy()
            return True
        return False

    def on_focus_leave(self, controller):
        # Auto dismiss when clicking outside
        GLib.timeout_add(120, self.safe_dismiss)

    def safe_dismiss(self):
        if not self.is_active():
            self.destroy()
        return False

    def launch_cmd(self, cmd):
        self.destroy()
        subprocess.Popen(["bash", "-c", cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def open_user_popover(self, btn):
        pop = Gtk.Popover()
        pop.set_parent(btn)
        pop.add_css_class("popover-acrylic")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        box.set_margin_start(6)
        box.set_margin_end(6)

        user_actions = [
            ("⚙️", "Change Account Settings", "Open Undercover & system settings", lambda: self.launch_cmd("omarchy-undercover-settings")),
            ("🔒", "Lock Account", "Lock workstation immediately", self.action_lock),
            ("🚪", "Sign Out", "Close active session and apps", self.action_logout),
        ]

        for ico, title, desc, handler in user_actions:
            b = Gtk.Button()
            b.add_css_class("power-action-row")
            r = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            i = Gtk.Label(label=ico)
            i.set_margin_start(4)
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            t = Gtk.Label(label=title)
            t.add_css_class("action-title")
            t.set_halign(Gtk.Align.START)
            s = Gtk.Label(label=desc)
            s.add_css_class("action-sub")
            s.set_halign(Gtk.Align.START)
            col.append(t)
            col.append(s)
            r.append(i)
            r.append(col)
            b.set_child(r)
            b.connect("clicked", lambda x, h=handler: (pop.popdown(), h()))
            box.append(b)

        pop.set_child(box)
        pop.popup()

    def open_power_popover(self, btn):
        pop = Gtk.Popover()
        pop.set_parent(btn)
        pop.add_css_class("popover-acrylic")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        box.set_margin_start(6)
        box.set_margin_end(6)

        actions = [
            ("🌙", "Sleep", "Saves session and puts PC in low-power state", self.action_suspend),
            ("🔄", "Restart", "Closes apps, turns off PC, then turns it back on", self.action_reboot),
            ("⏻", "Shut Down", "Closes all open apps and powers off PC", self.action_shutdown),
            ("🔒", "Lock Screen", "Locks workstation to secure session", self.action_lock),
            ("🚪", "Sign Out", "Signs out of current user account", self.action_logout),
        ]

        for ico, title, desc, handler in actions:
            b = Gtk.Button()
            b.add_css_class("power-action-row")
            r = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            i = Gtk.Label(label=ico)
            i.set_margin_start(4)
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            t = Gtk.Label(label=title)
            t.add_css_class("action-title")
            t.set_halign(Gtk.Align.START)
            s = Gtk.Label(label=desc)
            s.add_css_class("action-sub")
            s.set_halign(Gtk.Align.START)
            col.append(t)
            col.append(s)
            r.append(i)
            r.append(col)
            b.set_child(r)
            b.connect("clicked", lambda x, h=handler: (pop.popdown(), h()))
            box.append(b)

        pop.set_child(box)
        pop.popup()

    def action_lock(self):
        self.destroy()
        subprocess.run(["loginctl", "lock-session"], check=False)

    def action_logout(self):
        self.destroy()
        subprocess.run(["hyprctl", "dispatch", "exit"], check=False)

    def action_suspend(self):
        self.destroy()
        subprocess.run(["systemctl", "suspend"], check=False)

    def action_hibernate(self):
        self.destroy()
        subprocess.run(["systemctl", "hibernate"], check=False)

    def action_reboot(self):
        self.destroy()
        subprocess.run(["systemctl", "reboot"], check=False)

    def action_shutdown(self):
        self.destroy()
        subprocess.run(["systemctl", "poweroff"], check=False)

class Win11StartMenuApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=None, flags=Gio.ApplicationFlags.NON_UNIQUE)

    def do_activate(self):
        # Process singleton check / toggle
        win = Win11StartMenuWindow(self)
        win.present()

def main():
    # Instant toggle if already running
    curr_pid = os.getpid()
    try:
        out = subprocess.check_output(["pgrep", "-f", "omarchy-win11-startmenu"], text=True)
        pids = [int(p.strip()) for p in out.strip().splitlines() if p.strip()]
        other_pids = [p for p in pids if p != curr_pid]
        if other_pids:
            for p in other_pids:
                try:
                    os.kill(p, signal.SIGTERM)
                except Exception:
                    pass
            sys.exit(0)
    except Exception:
        pass

    app = Win11StartMenuApp()
    sys.exit(app.run(sys.argv))

if __name__ == "__main__":
    main()
