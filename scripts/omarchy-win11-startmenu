USERNAME = getpass.getuser()
CONFIG_DIR = Path.home() / ".config" / "omarchy-undercover"
SETTINGS_FILE = CONFIG_DIR / "settings.conf"
STATE_FILE = CONFIG_DIR / "state"

def read_setting(key, default=""):
    if SETTINGS_FILE.exists():
        try:
            for line in SETTINGS_FILE.read_text().splitlines():
                if line.startswith(key + "="):
                    return line.split("=", 1)[1].strip()
        except OSError:
            pass
    return default

def is_dark_mode():
    state = "win11-dark"
    if STATE_FILE.exists():
        try:
            state = STATE_FILE.read_text().strip()
        except OSError:
            pass
    variant = read_setting("THEME_VARIANT", "dark").lower()
    return "light" not in state and variant != "light"

def is_transparency_enabled():
    val = read_setting("WIN11_TRANSPARENCY", "")
    if val == "":
        val = read_setting("BAR_TRANSPARENT", "true")
    return val.lower() == "true"

