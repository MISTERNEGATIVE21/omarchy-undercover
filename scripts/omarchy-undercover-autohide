#!/usr/bin/env python3
"""
Intelligent Mouse-Edge Auto-Hide Daemon for Omarchy Undercover (v2.5.0)
High-performance Wayland edge detection daemon for macOS Dock & Windows 11 Taskbar.
Supports both Quickshell (Omarchy 4.0+) and Waybar (legacy).
"""

import sys
import os
import time
import json
import shutil
import subprocess
import signal

CONFIG_DIR = os.path.expanduser("~/.config/omarchy-undercover")
PID_FILE = os.path.join(CONFIG_DIR, "autohide.pid")
STATE_FILE = os.path.join(CONFIG_DIR, "state")
SETTINGS_FILE = os.path.join(CONFIG_DIR, "settings.conf")
BAR_OFF_FLAG = os.path.expanduser("~/.local/state/omarchy/toggles/bar-off")

def get_backend():
    try:
        out = subprocess.check_output(["omarchy-detect-backend"], text=True)
        return out.strip()
    except Exception:
        pass
    if shutil.which("omarchy-shell") or shutil.which("quickshell"):
        return "quickshell"
    return "waybar"

def get_screen_metrics():
    try:
        out = subprocess.check_output(["hyprctl", "monitors", "-j"], text=True)
        data = json.loads(out)
        if data and len(data) > 0:
            focused = next((m for m in data if m.get("focused")), data[0])
            h = focused.get("height", 1080)
            scale = focused.get("scale", 1.0)
            # In Hyprland 0.40+, cursorpos reports logical coordinates (height / scale)
            return int(h / scale)
    except Exception:
        pass
    return 1080

def get_cursor_y():
    try:
        out = subprocess.check_output(["hyprctl", "cursorpos"], text=True)
        parts = out.strip().split(",")
        if len(parts) >= 2:
            return int(parts[1].strip())
    except Exception:
        pass
    return 0

def set_bar_visible(visible):
    backend = get_backend()
    if backend == "quickshell":
        os.makedirs(os.path.dirname(BAR_OFF_FLAG), exist_ok=True)
        if visible:
            if os.path.exists(BAR_OFF_FLAG):
                try:
                    os.remove(BAR_OFF_FLAG)
                except Exception:
                    pass
        else:
            if not os.path.exists(BAR_OFF_FLAG):
                try:
                    with open(BAR_OFF_FLAG, "w") as f:
                        pass
                except Exception:
                    pass
    else:
        # Waybar SIGUSR1
        try:
            out = subprocess.check_output(["hyprctl", "layers"], text=True)
            is_showing = ("waybar" in out)
            if (visible and not is_showing) or (not visible and is_showing):
                subprocess.run(["pkill", "-SIGUSR1", "-x", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

def is_bar_running():
    backend = get_backend()
    if backend == "quickshell":
        try:
            out = subprocess.check_output(["pgrep", "-f", "omarchy-shell|quickshell"], text=True)
            return bool(out.strip())
        except Exception:
            return True
    else:
        try:
            out = subprocess.check_output(["pgrep", "-x", "waybar"], text=True)
            return bool(out.strip())
        except Exception:
            return False

def run_daemon():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    screen_h = get_screen_metrics()
    trigger_y = screen_h - 12  # bottom 12px triggers reveal
    leave_y = screen_h - 75    # above dock/taskbar area

    bar_visible = True
    away_since = None

    # Initial hide after 1.2s
    time.sleep(1.2)
    if is_bar_running():
        set_bar_visible(False)
        bar_visible = False

    while True:
        time.sleep(0.05)
        if not is_bar_running():
            continue

        y = get_cursor_y()

        if y >= trigger_y:
            away_since = None
            if not bar_visible:
                set_bar_visible(True)
                bar_visible = True
        elif y < leave_y:
            if bar_visible:
                if away_since is None:
                    away_since = time.time()
                elif (time.time() - away_since) > 0.35:  # 350ms natural dwell time
                    set_bar_visible(False)
                    bar_visible = False
                    away_since = None
            else:
                away_since = None

def start_daemon():
    if is_running():
        print("Autohide daemon is already running.")
        return

    pid = os.fork()
    if pid > 0:
        print("Autohide daemon started.")
        sys.exit(0)

    # Detach from terminal
    os.setsid()
    run_daemon()

def stop_daemon():
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, signal.SIGTERM)
        except Exception:
            pass
        try:
            os.remove(PID_FILE)
        except Exception:
            pass
    # Kill lingering instances
    subprocess.run(["pkill", "-f", "omarchy-undercover-autohide"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # Ensure bar is visible
    time.sleep(0.1)
    set_bar_visible(True)
    print("Autohide daemon stopped (Bar kept visible).")

def is_running():
    if not os.path.exists(PID_FILE):
        return False
    try:
        with open(PID_FILE, "r") as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)
        return True
    except (ValueError, OSError):
        return False

def toggle_daemon():
    if is_running():
        stop_daemon()
    else:
        start_daemon()

def main():
    if len(sys.argv) < 2:
        toggle_daemon()
        return

    cmd = sys.argv[1]
    if cmd in ("--start", "-s", "start"):
        start_daemon()
    elif cmd in ("--stop", "-k", "stop"):
        stop_daemon()
    elif cmd in ("--toggle", "-t", "toggle"):
        toggle_daemon()
    elif cmd in ("--status", "status"):
        if is_running():
            print("Autohide daemon is running.")
        else:
            print("Autohide daemon is stopped.")
    else:
        print("Usage: omarchy-undercover-autohide [--start | --stop | --toggle | --status]")

if __name__ == "__main__":
    main()
