#!/usr/bin/env python3
"""
Intelligent Mouse-Edge Auto-Hide Daemon for Omarchy Undercover (v2.5.0)
High-performance Wayland edge detection daemon for macOS Dock & Windows 11 Taskbar.
Supports both Quickshell (Omarchy 4.0+) and Waybar (legacy).
Features:
- Sub-pixel mouse edge triggering (6px bottom strip)
- Active-flyout locking: taskbar stays locked visible while Start Menu, Quick Settings, Calendar or Widgets are open
- 250ms smooth dwell buffer preventing accidental hide or jitter
- Single-instance background daemon with start/stop/toggle/status commands
- Fully synced with ~/.config/omarchy-undercover/settings.conf
"""

import sys
import os
import time
import json
import shutil
import subprocess
import signal

CONFIG_DIR = os.path.expanduser("~/.config/omarchy-undercover")
PID_FILE = os.path.join(CONFIG_DIR, "autohide.pid")
STATE_FILE = os.path.join(CONFIG_DIR, "state")
SETTINGS_FILE = os.path.join(CONFIG_DIR, "settings.conf")
BAR_OFF_FLAG = os.path.expanduser("~/.local/state/omarchy/toggles/bar-off")

def get_backend():
    try:
        out = subprocess.check_output(["omarchy-detect-backend"], text=True)
        return out.strip()
    except Exception:
        pass
    if shutil.which("omarchy-shell") or shutil.which("quickshell"):
        return "quickshell"
    return "waybar"

def get_screen_metrics():
    try:
        out = subprocess.check_output(["hyprctl", "monitors", "-j"], text=True)
        data = json.loads(out)
        if data and len(data) > 0:
            focused = next((m for m in data if m.get("focused")), data[0])
            h = focused.get("height", 1080)
            scale = focused.get("scale", 1.0)
            return int(h / scale)
    except Exception:
        pass
    return 900

def get_cursor_pos():
    try:
        out = subprocess.check_output(["hyprctl", "cursorpos"], text=True)
        parts = out.strip().split(",")
        if len(parts) >= 2:
            return int(parts[0].strip()), int(parts[1].strip())
    except Exception:
        pass
    return 0, 0

def get_cursor_y():
    return get_cursor_pos()[1]

def is_flyout_open():
    """Returns True if Start Menu, Notifications, Quick Settings, or Widgets are active"""
    # 1. Check quick processes
    try:
        out = subprocess.check_output(
            ["pgrep", "-f", "quickshell.*win11-start|omarchy-win11-startmenu|omarchy-win11-notifications|omarchy-win11-widgets|omarchy-win11-bluetooth|omarchy-win11-sound|omarchy-mac-widgets|omarchy-mac-controlcenter"],
            text=True
        )
        if out.strip():
            return True
    except Exception:
        pass

    # 2. Check Hyprland layers
    try:
        layers = subprocess.check_output(["hyprctl", "layers", "-j"], text=True)
        if "omarchy-menu" in layers or "omarchy-notifications" in layers or "omarchy-osd" in layers:
            return True
    except Exception:
        pass

    return False

def set_bar_visible(visible):
    backend = get_backend()
    if backend == "quickshell":
        os.makedirs(os.path.dirname(BAR_OFF_FLAG), exist_ok=True)
        if visible:
            if os.path.exists(BAR_OFF_FLAG):
                try:
                    os.remove(BAR_OFF_FLAG)
                except Exception:
                    pass
        else:
            if not os.path.exists(BAR_OFF_FLAG):
                try:
                    with open(BAR_OFF_FLAG, "w") as f:
                        pass
                except Exception:
                    pass
    else:
        # Waybar SIGUSR1
        try:
            out = subprocess.check_output(["hyprctl", "layers"], text=True)
            is_showing = ("waybar" in out)
            if (visible and not is_showing) or (not visible and is_showing):
                subprocess.run(["pkill", "-SIGUSR1", "-x", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

def is_bar_running():
    backend = get_backend()
    if backend == "quickshell":
        try:
            out = subprocess.check_output(["pgrep", "-f", "omarchy-shell|quickshell"], text=True)
            return bool(out.strip())
        except Exception:
            return True
    else:
        try:
            out = subprocess.check_output(["pgrep", "-x", "waybar"], text=True)
            return bool(out.strip())
        except Exception:
            return False

def run_daemon():
    # Save PID
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    screen_h = get_screen_metrics()
    trigger_y = screen_h - 10         # Bottom 10px edge triggers immediate reveal when cursor is down
    taskbar_region_y = screen_h - 60 # Taskbar / dock region boundary

    bar_visible = True
    last_activity = time.time()
    last_pos = get_cursor_pos()
    INACTIVITY_TIMEOUT = 30.0        # 30 seconds delay to hide again if no activity

    # Initial hide after launch
    time.sleep(0.6)
    if is_bar_running() and not is_flyout_open():
        set_bar_visible(False)
        bar_visible = False

    while True:
        time.sleep(0.04)
        if not is_bar_running():
            continue

        now = time.time()
        pos = get_cursor_pos()
        y = pos[1]

        # If any start menu or flyout is open, lock the taskbar visible & reset activity
        if is_flyout_open():
            last_activity = now
            if not bar_visible:
                set_bar_visible(True)
                bar_visible = True
            continue

        # Detect cursor movement
        if pos != last_pos:
            last_pos = pos
            if y >= taskbar_region_y:
                last_activity = now

        # 1. When cursor is down at bottom edge: Reappear immediately
        if y >= trigger_y:
            last_activity = now
            if not bar_visible:
                set_bar_visible(True)
                bar_visible = True

        # 2. When bar is visible: Hide after 30 seconds of inactivity
        if bar_visible:
            if y >= taskbar_region_y and pos != last_pos:
                last_activity = now

            if (now - last_activity) >= INACTIVITY_TIMEOUT:
                set_bar_visible(False)
                bar_visible = False

def update_settings_autohide(enabled):
    if not os.path.exists(SETTINGS_FILE):
        return
    try:
        with open(SETTINGS_FILE, "r") as f:
            content = f.read()
        val = "true" if enabled else "false"
        import re
        if "AUTOHIDE=" in content:
            content = re.sub(r"AUTOHIDE=\w+", f"AUTOHIDE={val}", content)
        else:
            content += f"\nAUTOHIDE={val}\n"
        with open(SETTINGS_FILE, "w") as f:
            f.write(content)
    except Exception:
        pass

def start_daemon():
    update_settings_autohide(True)
    if is_running():
        print("Autohide daemon is already running.")
        return

    pid = os.fork()
    if pid > 0:
        print("Autohide daemon started.")
        sys.exit(0)

    # Detach from terminal
    os.setsid()
    run_daemon()

def stop_daemon():
    update_settings_autohide(False)
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, signal.SIGTERM)
        except Exception:
            pass
        try:
            os.remove(PID_FILE)
        except Exception:
            pass
    # Kill lingering instances
    subprocess.run(["pkill", "-f", "omarchy-undercover-autohide"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # Ensure bar is visible
    time.sleep(0.1)
    set_bar_visible(True)
    print("Autohide daemon stopped (Bar kept visible).")

def is_running():
    if not os.path.exists(PID_FILE):
        return False
    try:
        with open(PID_FILE, "r") as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)
        return True
    except (ValueError, OSError):
        return False

def toggle_daemon():
    if is_running():
        stop_daemon()
    else:
        start_daemon()

def main():
    if len(sys.argv) < 2:
        toggle_daemon()
        return

    cmd = sys.argv[1]
    if cmd in ("--start", "-s", "start"):
        start_daemon()
    elif cmd in ("--stop", "-k", "stop"):
        stop_daemon()
    elif cmd in ("--toggle", "-t", "toggle"):
        toggle_daemon()
    elif cmd in ("--status", "status"):
        if is_running():
            print("Autohide daemon is running.")
        else:
            print("Autohide daemon is stopped.")
    else:
        print("Usage: omarchy-undercover-autohide [--start | --stop | --toggle | --status]")

if __name__ == "__main__":
    main()
