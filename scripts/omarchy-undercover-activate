#!/usr/bin/env python3
"""
Omarchy Undercover Workspace Switcher & Window Activator
Intelligently finds running application windows across all Hyprland workspaces,
switches to the appropriate workspace, focuses the window, or launches the app.

Usage:
  omarchy-undercover-activate "<pattern1,pattern2,...>" "<command_to_launch_if_not_running>"

Copyright (C) 2026 misternegative21
License: GPL-3.0-or-later
"""

import sys
import json
import shutil
import subprocess

def main():
    if len(sys.argv) < 3:
        if len(sys.argv) == 2:
            patterns = [p.strip() for p in sys.argv[1].split(",") if p.strip()]
            exec_cmd = sys.argv[1]
        else:
            print("Usage: omarchy-undercover-activate <patterns_comma_separated> <exec_command>")
            sys.exit(1)
    else:
        patterns = [p.strip() for p in sys.argv[1].split(",") if p.strip()]
        exec_cmd = sys.argv[2]

    # Try finding window in Hyprland clients
    found = False
    if shutil.which("hyprctl"):
        try:
            raw_clients = subprocess.check_output(["hyprctl", "clients", "-j"], stderr=subprocess.DEVNULL)
            clients = json.loads(raw_clients.decode("utf-8", errors="replace"))

            for c in clients:
                cls = (c.get("class") or "").lower()
                initial_cls = (c.get("initialClass") or "").lower()
                title = (c.get("title") or "").lower()
                addr = c.get("address")
                ws_info = c.get("workspace", {})
                ws_id = ws_info.get("id") if isinstance(ws_info, dict) else None

                match = False
                for p in patterns:
                    p_lower = p.lower()
                    if p_lower in cls or p_lower in initial_cls or p_lower in title:
                        match = True
                        break

                if match and addr:
                    # Switch workspace if positive id
                    if ws_id and ws_id > 0:
                        subprocess.run(
                            ["hyprctl", "dispatch", f'hl.dsp.focus({{ workspace = {ws_id} }})'],
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                            check=False
                        )
                        # Legacy fallback for workspace switch
                        subprocess.run(
                            ["hyprctl", "dispatch", "workspace", str(ws_id)],
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                            check=False
                        )

                    # Focus window by address
                    subprocess.run(
                        ["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})'],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        check=False
                    )
                    # Legacy fallback
                    subprocess.run(
                        ["hyprctl", "dispatch", "focuswindow", f"address:{addr}"],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        check=False
                    )
                    found = True
                    break
        except Exception:
            pass

    if not found and exec_cmd:
        subprocess.Popen(["bash", "-c", exec_cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    main()
