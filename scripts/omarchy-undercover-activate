#!/usr/bin/env python3
"""
Omarchy Undercover Workspace Switcher & Window Activator
Finds running application window across Hyprland workspaces, focuses it, or launches the app.
"""

import sys
import json
import subprocess

def main():
    if len(sys.argv) < 2:
        sys.exit(1)
    patterns = [p.strip().lower() for p in sys.argv[1].split(",") if p.strip()]
    exec_cmd = sys.argv[2] if len(sys.argv) > 2 else sys.argv[1]

    try:
        clients = json.loads(subprocess.check_output(["hyprctl", "clients", "-j"], stderr=subprocess.DEVNULL))
        for c in clients:
            fields = " ".join([c.get("class", ""), c.get("initialClass", ""), c.get("title", "")]).lower()
            if any(p in fields for p in patterns):
                addr = c.get("address")
                ws_id = c.get("workspace", {}).get("id") if isinstance(c.get("workspace"), dict) else None
                if ws_id and ws_id > 0:
                    subprocess.run(["hyprctl", "dispatch", f"hl.dsp.focus({{ workspace = {ws_id} }})"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
                    subprocess.run(["hyprctl", "dispatch", "workspace", str(ws_id)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
                if addr:
                    subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
                    subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{addr}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
                return
    except Exception:
        pass

    if exec_cmd:
        subprocess.Popen(["bash", "-c", exec_cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    main()
