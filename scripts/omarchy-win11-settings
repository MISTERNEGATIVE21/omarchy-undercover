DIR="$HOME/.config/quickshell/win11-settings"
if [[ ! -d "$DIR" ]]; then
    REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    if [[ -d "$REPO_DIR/configs/quickshell/win11-settings" ]]; then
        DIR="$REPO_DIR/configs/quickshell/win11-settings"
    fi
fi

if command -v quickshell >/dev/null 2>&1 && [[ -d "$DIR" ]]; then
    exec quickshell -p "$DIR"
fi

exec omarchy-undercover-settings "$@"
