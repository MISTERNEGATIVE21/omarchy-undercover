#!/usr/bin/env bash
# ==============================================================================
# Copyright (C) 2026 misternegative21
# Omarchy Undercover - Windows 11 Settings & PowerToys QuickShell Application
# License: GPL-3.0-or-later
#
# omarchy:summary=Launch Windows 11 Fluent Settings and hardware controls panel
# omarchy:args=[--page|-p <page>]
# omarchy:examples=omarchy-win11-settings | omarchy-win11-settings --page displays
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

for cand in \
    "${REAL_SCRIPT_DIR}/.." \
    "${SCRIPT_DIR}/.." \
    "$HOME/.config/omarchy/plugins/omarchy-undercover" \
    "$HOME/omarchy-undercover"; do
    if [[ -f "$cand/manifest.json" ]]; then
        PLUGIN_DIR="$cand"
        break
    fi
done
PLUGIN_DIR="${PLUGIN_DIR:-$HOME/.config/omarchy/plugins/omarchy-undercover}"

DIR="$PLUGIN_DIR/configs/quickshell/win11-settings"
if [[ ! -d "$DIR" && -d "$PLUGIN_DIR/quickshell/win11-settings" ]]; then
    DIR="$PLUGIN_DIR/quickshell/win11-settings"
fi

PAGE_ARG=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --page|-p)
            PAGE_ARG="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

RUN_DIR="${XDG_RUNTIME_DIR:-/tmp/omarchy-${UID:-1000}}"
mkdir -p -m 0700 "$RUN_DIR" 2>/dev/null || true
PAGE_FILE="$RUN_DIR/omarchy-settings-page"
if [[ -n "$PAGE_ARG" ]]; then
    echo "$PAGE_ARG" > "$PAGE_FILE"
fi

if command -v hyprctl >/dev/null 2>&1; then
    # If Settings window is already open, focus it and bring it to top immediately
    TARGET_ADDR=$(hyprctl clients -j 2>/dev/null | jq -r '.[] | select((.class == "org.quickshell" and (.title == "Settings" or .title == "System Settings")) or .class == "org.omarchy.undercover.settings") | .address' 2>/dev/null | head -n1)
    if [[ -n "$TARGET_ADDR" && "$TARGET_ADDR" != "null" ]]; then
        hyprctl dispatch "hl.dsp.focus({ window = \"address:${TARGET_ADDR}\" })" >/dev/null 2>&1 || hyprctl dispatch focuswindow "address:${TARGET_ADDR}" >/dev/null 2>&1 || true
        hyprctl dispatch "hl.dsp.window.alter_zorder({ mode = \"top\", window = \"address:${TARGET_ADDR}\" })" >/dev/null 2>&1 || true
        hyprctl dispatch "hl.dsp.window.bring_to_top({ window = \"address:${TARGET_ADDR}\" })" >/dev/null 2>&1 || true
        exit 0
    fi

    hyprctl eval 'if hl and hl.window_rule then hl.window_rule({ match = { class = "^org.quickshell$", title = "^Settings$" }, float = true, center = true, size = { 980, 640 }, focus_on_activate = true }) end' >/dev/null 2>&1 || true
    hyprctl eval 'if o and o.window then o.window({ class = "^org.quickshell$", title = "^Settings$" }, { float = true, center = true, size = { 980, 640 }, focus_on_activate = true }) end' >/dev/null 2>&1 || true
    hyprctl keyword windowrulev2 "float,class:^(org.quickshell)$,title:^(Settings)$" >/dev/null 2>&1 || true
    hyprctl keyword windowrulev2 "center,class:^(org.quickshell)$,title:^(Settings)$" >/dev/null 2>&1 || true
    hyprctl keyword windowrulev2 "size 980 640,class:^(org.quickshell)$,title:^(Settings)$" >/dev/null 2>&1 || true
    hyprctl keyword windowrulev2 "focusonactivate,class:^(org.quickshell)$,title:^(Settings)$" >/dev/null 2>&1 || true
fi

if command -v quickshell >/dev/null 2>&1 && [[ -d "$DIR" ]]; then
    exec quickshell -p "$DIR"
fi

if command -v omarchy-undercover-settings >/dev/null 2>&1; then
    exec omarchy-undercover-settings "$@"
else
    exec "${SCRIPT_DIR}/omarchy-undercover-settings" "$@"
fi
