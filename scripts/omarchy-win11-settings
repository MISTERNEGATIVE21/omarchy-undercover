# License: GPL-3.0-or-later
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SCRIPT_DIR}/../manifest.json" ]]; then
    PLUGIN_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
elif [[ -d "$HOME/.config/omarchy/plugins/undercover" ]]; then
    PLUGIN_DIR="$HOME/.config/omarchy/plugins/undercover"
else
    PLUGIN_DIR="$HOME/.config/omarchy-undercover"
fi

DIR="$PLUGIN_DIR/configs/quickshell/win11-settings"
if [[ ! -d "$DIR" && -d "$PLUGIN_DIR/quickshell/win11-settings" ]]; then
    DIR="$PLUGIN_DIR/quickshell/win11-settings"
fi

if command -v hyprctl >/dev/null 2>&1; then
    hyprctl eval 'if o and o.window then o.window({ class = "^org.quickshell$", title = "^Settings$" }, { float = true, center = true, size = { 980, 640 } }) end' >/dev/null 2>&1 || true
    hyprctl keyword windowrulev2 "float,class:^(org.quickshell)$,title:^(Settings)$" >/dev/null 2>&1 || true
    hyprctl keyword windowrulev2 "center,class:^(org.quickshell)$,title:^(Settings)$" >/dev/null 2>&1 || true
    hyprctl keyword windowrulev2 "size 980 640,class:^(org.quickshell)$,title:^(Settings)$" >/dev/null 2>&1 || true
fi

if command -v quickshell >/dev/null 2>&1 && [[ -d "$DIR" ]]; then
    exec quickshell -p "$DIR"
fi

if command -v omarchy-undercover-settings >/dev/null 2>&1; then
    exec omarchy-undercover-settings "$@"
else
    exec "${SCRIPT_DIR}/omarchy-undercover-settings" "$@"
fi
