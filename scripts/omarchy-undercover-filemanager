#!/usr/bin/env bash
# ==============================================================================
# Omarchy Undercover File Manager Dispatcher
# Launches Flea with tailored UI/UX matching the active Undercover disguise
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SCRIPT_DIR}/../manifest.json" ]]; then
    PLUGIN_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
elif [[ -d "$HOME/.config/omarchy/plugins/omarchy-undercover" ]]; then
    PLUGIN_DIR="$HOME/.config/omarchy/plugins/omarchy-undercover"
elif [[ -d "$HOME/.config/omarchy/plugins/undercover" ]]; then
    PLUGIN_DIR="$HOME/.config/omarchy/plugins/undercover"
else
    PLUGIN_DIR="${SCRIPT_DIR}/.."
fi

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/undercover/state"
if [[ ! -f "$STATE_FILE" && -f "$HOME/.config/omarchy-undercover/state" ]]; then
    STATE_FILE="$HOME/.config/omarchy-undercover/state"
elif [[ ! -f "$STATE_FILE" && -f "$PLUGIN_DIR/state" ]]; then
    STATE_FILE="$PLUGIN_DIR/state"
fi
MODE="default"
if [[ -f "$STATE_FILE" ]]; then
    s=$(cat "$STATE_FILE" 2>/dev/null || echo "default")
    if [[ "$s" == *"mac"* || "$s" == *"apple"* ]]; then
        MODE="mac"
    elif [[ "$s" == *"win"* ]]; then
        MODE="windows"
    fi
fi

SETTINGS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-undercover/settings.conf"
if [[ ! -f "$SETTINGS_FILE" && -f "$PLUGIN_DIR/settings.conf" ]]; then
    SETTINGS_FILE="$PLUGIN_DIR/settings.conf"
fi

CONFIGURED_FM="auto"
if [[ -f "$SETTINGS_FILE" ]]; then
    cf=$(grep -E "^DEFAULT_FILE_MANAGER=" "$SETTINGS_FILE" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'" || true)
    if [[ -n "$cf" ]]; then
        CONFIGURED_FM="$cf"
    fi
fi

# Sanitize and normalize path arguments (expand trash URIs and tildes)
ARGS=()
for arg in "$@"; do
    if [[ "$arg" == "trash:///" || "$arg" == "trash:" ]]; then
        trash_dir="${XDG_DATA_HOME:-$HOME/.local/share}/Trash/files"
        mkdir -p "$trash_dir"
        ARGS+=("$trash_dir")
    elif [[ "$arg" == "~"* ]]; then
        ARGS+=("${arg/#\~/$HOME}")
    else
        ARGS+=("$arg")
    fi
done

# If user configured a specific alternative file manager that exists, prioritize it
if [[ "$CONFIGURED_FM" != "auto" && "$CONFIGURED_FM" != "flea" ]] && command -v "$CONFIGURED_FM" >/dev/null 2>&1; then
    if [[ ${#ARGS[@]} -eq 0 ]]; then
        exec "$CONFIGURED_FM" "$HOME"
    else
        exec "$CONFIGURED_FM" "${ARGS[@]}"
    fi
fi

# Primary: Flea QuickShell file manager with active disguise preset
if command -v flea >/dev/null 2>&1; then
    case "$MODE" in
        mac)
            flea --ui-state '{"view":"columns","density":"comfortable","keys":"mac","places":{"sidebarWidth":192,"showHome":true,"showNetwork":true,"showDevices":true,"showTrash":true,"driveSize":true,"trashCount":false,"rail":"shown"},"preview":{"column":true,"loadOn":"automatic","thumbnails":"media","thumbSize":"medium","ctrlZoom":true},"columns":["name","date","kind","size"],"foldersFirst":true,"hidden":false}' >/dev/null 2>&1 || true
            ;;
        windows)
            flea --ui-state '{"view":"list","density":"normal","keys":"windows","places":{"sidebarWidth":224,"showHome":true,"showNetwork":true,"showDevices":true,"showTrash":true,"driveSize":true,"trashCount":false,"rail":"shown"},"preview":{"column":false},"columns":["name","date","kind","size"],"foldersFirst":true,"hidden":false}' >/dev/null 2>&1 || true
            ;;
        *)
            flea --ui-state '{"view":"columns","density":"normal","keys":"default","preview":{"column":true}}' >/dev/null 2>&1 || true
            ;;
    esac

    # Prevent Flea from auto-relaunching via handleSceneGraphError fallback on compositor close
    export FLEA_RENDERER_AUTOMATIC="${FLEA_RENDERER_AUTOMATIC:-0}"

    if [[ ${#ARGS[@]} -eq 0 ]]; then
        exec flea "$HOME"
    else
        exec flea "${ARGS[@]}"
    fi
fi

# Fallback: Launch alternative installed file manager
for fm in nautilus thunar dolphin nemo pcmanfm pcmanfm-qt xdg-open; do
    if command -v "$fm" >/dev/null 2>&1; then
        target="${ARGS[0]:-$HOME}"
        exec "$fm" "$target"
    fi
done

echo "omarchy-undercover-filemanager: no supported file manager found" >&2
exit 1
