#!/usr/bin/env bash
# =============================================================================
# 🪟 Windows 11 Fluent Native Quickshell Bluetooth Dispatcher
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

QS_SRC=""
for cand in \
    "${REAL_SCRIPT_DIR}/../configs/quickshell/win11-bluetooth" \
    "${SCRIPT_DIR}/../configs/quickshell/win11-bluetooth" \
    "$HOME/.config/omarchy/plugins/omarchy-undercover/configs/quickshell/win11-bluetooth" \
    "$HOME/omarchy-undercover/configs/quickshell/win11-bluetooth" \
    "/usr/share/omarchy-undercover/configs/quickshell/win11-bluetooth"; do
    if [[ -d "$cand" && -f "$cand/shell.qml" ]]; then
        QS_SRC="$cand"
        break
    fi
done

PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-win11-bluetooth.pid"

if [[ -f "$PID_FILE" ]]; then
    PID=$(cat "$PID_FILE" 2>/dev/null)
    if [[ -n "$PID" ]] && kill -0 "$PID" 2>/dev/null; then
        kill "$PID" 2>/dev/null || true
        rm -f "$PID_FILE"
        exit 0
    fi
    rm -f "$PID_FILE"
fi

if pgrep -f "quickshell.*win11-bluetooth" >/dev/null; then
    pkill -f "quickshell.*win11-bluetooth"
    rm -f "$PID_FILE"
    exit 0
fi

if command -v quickshell >/dev/null 2>&1 && [[ -d "$QS_SRC" ]]; then
    echo $$ > "$PID_FILE"
    exec quickshell -p "$QS_SRC"
else
    exec blueman-manager
fi
