#!/usr/bin/env bash
# ==============================================================================
# Omarchy Hyprland Undercover - Windows 11 Desktop Transformation
# License: GPL-3.0-or-later
# Author: misternegative21
#
# omarchy:summary=Windows 11 desktop transformation tool for Omarchy Hyprland
# omarchy:args=[--enable|--disable|--restore|--verify|--status|--help]
# omarchy:examples=omarchy-undercover --enable | omarchy-undercover --restore
# ==============================================================================

set -euo pipefail

# Resolve symlinks so SCRIPT_DIR points to the actual scripts directory
_SOURCE="${BASH_SOURCE[0]}"
while [ -h "$_SOURCE" ]; do
    _DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
    _SOURCE="$(readlink "$_SOURCE")"
    [[ $_SOURCE != /* ]] && _SOURCE="$_DIR/$_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
unset _SOURCE _DIR

## Source common.sh
if [[ -f "$SCRIPT_DIR/common.sh" ]]; then
    source "$SCRIPT_DIR/common.sh"
fi

# Official Omarchy plugin directory
if [[ -f "${SCRIPT_DIR}/../manifest.json" ]]; then
    PLUGIN_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
elif [[ -d "$HOME/.config/omarchy/plugins/omarchy-undercover" ]]; then
    PLUGIN_DIR="$HOME/.config/omarchy/plugins/omarchy-undercover"
elif [[ -d "$HOME/.config/omarchy/plugins/undercover" ]]; then
    PLUGIN_DIR="$HOME/.config/omarchy/plugins/undercover"
else
    PLUGIN_DIR="${SCRIPT_DIR}/.."
fi

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-undercover"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/undercover"

mkdir -p "$CONFIG_DIR" "$STATE_DIR"

STATE_FILE="$STATE_DIR/state"
BACKUP_DIR="$STATE_DIR/backups"
BASELINE_FILE="$STATE_DIR/baseline"
SETTINGS_FILE="$CONFIG_DIR/settings.conf"

WINDOWS_GTK_THEME="Win11-Dark"
WINDOWS_ICON_THEME="Fluent-dark"
WINDOWS_CURSOR_THEME="Fluent-dark-cursors"
WINDOWS_FONT_NAME="Roboto 10.5"

mkdir -p "$BACKUP_DIR"

# Seed default settings if missing
if [[ ! -f "$SETTINGS_FILE" && -f "$PLUGIN_DIR/settings.conf" ]]; then
    cp "$PLUGIN_DIR/settings.conf" "$SETTINGS_FILE" 2>/dev/null || true
fi

# Seed baseline if migrating from legacy plugin dir
if [[ ! -f "$BASELINE_FILE" && -f "$PLUGIN_DIR/baseline" ]]; then
    cp "$PLUGIN_DIR/baseline" "$BASELINE_FILE" 2>/dev/null || true
fi

if [[ -f "$PLUGIN_DIR/scripts/common.sh" ]]; then
    source "$PLUGIN_DIR/scripts/common.sh"
elif [[ -f "$HOME/.config/omarchy/plugins/omarchy-undercover/scripts/common.sh" ]]; then
    source "$HOME/.config/omarchy/plugins/omarchy-undercover/scripts/common.sh"
elif [[ -f "$HOME/.local/share/omarchy/bin/common.sh" ]]; then
    source "$HOME/.local/share/omarchy/bin/common.sh"
elif [[ -f "$HOME/.local/bin/common.sh" ]]; then
    source "$HOME/.local/bin/common.sh"
elif [[ -f "/usr/share/omarchy-undercover/scripts/common.sh" ]]; then
    source "/usr/share/omarchy-undercover/scripts/common.sh"
else
    msg() { echo -e "\e[1;32m[INFO]\e[0m $1"; }
    warn() { echo -e "\e[1;33m[WARN]\e[0m $1"; }
    error() { echo -e "\e[1;31m[ERROR]\e[0m $1"; exit 1; }
    command_exists() { command -v "$1" >/dev/null 2>&1; }
    omarchy_reload_waybar() {
        pkill -9 -x waybar 2>/dev/null || true
        local retry=0
        while pgrep -x waybar >/dev/null && [[ $retry -lt 8 ]]; do sleep 0.05; ((retry++)); done
        pkill -9 -x waybar 2>/dev/null || true
        local log_dir="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/omarchy-undercover"
        mkdir -p -m 0700 "$log_dir" 2>/dev/null || true
        nohup waybar >"$log_dir/waybar.log" 2>&1 &
        disown 2>/dev/null || true
        sleep 0.35
        local pids=($(pgrep -x waybar))
        if [[ ${#pids[@]} -gt 1 ]]; then
            for ((i=1; i<${#pids[@]}; i++)); do kill -9 "${pids[$i]}" 2>/dev/null || true; done
        fi
    }
    omarchy_reload_hyprland() { hyprctl reload 2>/dev/null || true; }
    omarchy_set_gnome_theme() {
        gsettings set org.gnome.desktop.interface gtk-theme "$1" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface icon-theme "$2" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface cursor-theme "$3" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface font-name "$WINDOWS_FONT_NAME" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" 2>/dev/null || true
    }
    backup_config_dir() {
        local src="$1" dest="$2"
        if [[ -d "$src" ]]; then cp -r "$src" "$dest"; fi
    }
    restore_config_dir() {
        local src="$1" dest="$2"
        if [[ -d "$src" ]]; then rm -rf "$dest"; cp -r "$src" "$dest"; fi
    }
    create_manifest() {
        local file="$1"
        shift
        echo "{\"timestamp\":\"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\"}" > "$file"
    }
fi

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

detect_launcher() {
    if command_exists rofi; then
        echo "rofi"
    elif command_exists wofi; then
        echo "wofi"
    else
        echo "none"
    fi
}

# Ensure a setting exists in settings.conf without overwriting user values
ensure_setting() {
    local key="$1" default="$2"
    local current
    current=$(read_setting "$key" "")
    if [[ -z "$current" ]]; then
        write_setting "$key" "$default"
    fi
}

# Copy a config file/dir from the project presets into the user config dir,
# preferring the repository source under SCRIPT_DIR when available.
project_file() {
    local rel="$1"
    if [[ -e "${SCRIPT_DIR}/../configs/$rel" ]]; then
        echo "${SCRIPT_DIR}/../configs/$rel"
    elif [[ -e "$CONFIG_DIR/$rel" ]]; then
        echo "$CONFIG_DIR/$rel"
    elif [[ -e "/usr/share/omarchy-undercover/configs/$rel" ]]; then
        echo "/usr/share/omarchy-undercover/configs/$rel"
    else
        echo ""
    fi
}

asset_dir() {
    local rel="$1"
    if [[ -e "${SCRIPT_DIR}/../assets/$rel" ]]; then
        echo "${SCRIPT_DIR}/../assets/$rel"
    elif [[ -e "$CONFIG_DIR/$rel" ]]; then
        echo "$CONFIG_DIR/$rel"
    elif [[ -e "/usr/share/omarchy-undercover/assets/$rel" ]]; then
        echo "/usr/share/omarchy-undercover/assets/$rel"
    else
        echo ""
    fi
}




apply_wallpaper() {
    local preset
    preset=$(read_setting "WALLPAPER" "win11_bloom_dark.jpg")
    if command_exists omarchy-undercover-wallpaper; then
        omarchy-undercover-wallpaper "$preset" || true
    else
        local wp_file="$CONFIG_DIR/wallpapers/$preset"
        if [[ ! -f "$wp_file" && -f "${SCRIPT_DIR}/../assets/wallpapers/$preset" ]]; then
            wp_file="${SCRIPT_DIR}/../assets/wallpapers/$preset"
        fi
        if [[ -f "$wp_file" ]]; then
            msg "Applying Windows 11 wallpaper..."
            if command_exists swaybg; then
                killall swaybg 2>/dev/null || true
                swaybg -i "$wp_file" -m fill &>/dev/null &
            elif command_exists hyprpaper; then
                killall hyprpaper 2>/dev/null || true
                hyprpaper &>/dev/null &
            fi
        fi
    fi
}

apply_gtk_windows_theme() {
    rm -rf "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
    mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"

    local win11_gtk4="$HOME/.themes/Win11-Dark/gtk-4.0"
    local win11_gtk3="$HOME/.themes/Win11-Dark/gtk-3.0"

    if [[ -d "$win11_gtk4" ]]; then
        cp -rL "$win11_gtk4/"* "$HOME/.config/gtk-4.0/" 2>/dev/null || true
        cat <<EOF > "$HOME/.config/gtk-4.0/gtk.css"
@import url("file://$win11_gtk4/gtk.css");
EOF
        cat <<EOF > "$HOME/.config/gtk-4.0/gtk-dark.css"
@import url("file://$win11_gtk4/gtk-dark.css");
EOF
    fi

    if [[ -d "$win11_gtk3" ]]; then
        cp -rL "$win11_gtk3/"* "$HOME/.config/gtk-3.0/" 2>/dev/null || true
        cat <<EOF > "$HOME/.config/gtk-3.0/gtk.css"
@import url("file://$win11_gtk3/gtk.css");
EOF
    fi

    local cursor_size
    cursor_size=$(read_setting "CURSOR_SIZE" "24")

    cat <<EOF > "$HOME/.config/gtk-3.0/settings.ini"
[Settings]
gtk-theme-name=$WINDOWS_GTK_THEME
gtk-icon-theme-name=$WINDOWS_ICON_THEME
gtk-cursor-theme-name=$WINDOWS_CURSOR_THEME
gtk-cursor-theme-size=$cursor_size
gtk-font-name=$WINDOWS_FONT_NAME
gtk-application-prefer-dark-theme=1
gtk-decoration-layout=:minimize,maximize,close
EOF

    cat <<EOF > "$HOME/.config/gtk-4.0/settings.ini"
[Settings]
gtk-theme-name=$WINDOWS_GTK_THEME
gtk-icon-theme-name=$WINDOWS_ICON_THEME
gtk-cursor-theme-name=$WINDOWS_CURSOR_THEME
gtk-cursor-theme-size=$cursor_size
gtk-font-name=$WINDOWS_FONT_NAME
gtk-decoration-layout=:minimize,maximize,close
EOF

    # Add a Windows-style "My Computer" (This PC) bookmark to the sidebar
    local bookmarks="$HOME/.config/gtk-3.0/bookmarks"
    mkdir -p "$HOME/.config/gtk-3.0"
    if [[ -f "$bookmarks" ]] && grep -q "computer:///" "$bookmarks"; then
        sed -i 's|^computer:///.*|computer:/// My Computer|' "$bookmarks"
    else
        echo "computer:/// My Computer" >> "$bookmarks"
    fi

    omarchy_set_gnome_theme "$WINDOWS_GTK_THEME" "$WINDOWS_ICON_THEME" "$WINDOWS_CURSOR_THEME" "$cursor_size"
    gsettings set org.gnome.desktop.interface font-name "$WINDOWS_FONT_NAME" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface document-font-name "$WINDOWS_FONT_NAME" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface monospace-font-name "CaskaydiaMono Nerd Font 10" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" 2>/dev/null || true
}

apply_waybar_windows() {
    local src
    src=$(project_file "waybar")
    if [[ -n "$src" && -d "$src" ]]; then
        mkdir -p "$HOME/.config/waybar"
        local visibility
        visibility=$(read_setting "TASKBAR_VISIBILITY" "")
        if [[ -z "$visibility" ]]; then
            visibility="dock"
            [[ "$(read_setting "AUTOHIDE" "0")" == "1" ]] && visibility="autohide"
        fi
        local mode="dock"
        [[ "$visibility" == "overlay" ]] && mode="overlay"
        [[ "$visibility" == "autohide" ]] && mode="hide"

        local cfg_src="$src/config.jsonc"
        [[ -f "$src/config-win.jsonc" ]] && cfg_src="$src/config-win.jsonc"
        local css_src="$src/style.css"
        [[ -f "$src/style-win.css" ]] && css_src="$src/style-win.css"

        cp "$cfg_src" "$HOME/.config/waybar/config.jsonc"
        cp "$css_src" "$HOME/.config/waybar/style.css"

        local is_trans
        is_trans=$(read_setting "WIN11_TRANSPARENCY", "true")
        if [[ "$is_trans" == "false" ]]; then
            sed -i 's/rgba(32, 32, 32, [0-9.]*)/#1f1f1f/g' "$HOME/.config/waybar/style.css" 2>/dev/null || true
        fi

        local align
        align=$(read_setting "TASKBAR_ALIGNMENT" "center")
        if command_exists jq; then
            if [[ "$align" == "left" ]]; then
                jq '.[0]["modules-left"] = ["custom/startmenu", "custom/search", "custom/taskview", "wlr/taskbar"] | .[0]["modules-center"] = ["custom/weather"]' "$HOME/.config/waybar/config.jsonc" > "$HOME/.config/waybar/config.jsonc.tmp" 2>/dev/null && mv "$HOME/.config/waybar/config.jsonc.tmp" "$HOME/.config/waybar/config.jsonc"
            else
                jq '.[0]["modules-left"] = ["custom/weather"] | .[0]["modules-center"] = ["custom/startmenu", "custom/search", "custom/taskview", "wlr/taskbar"]' "$HOME/.config/waybar/config.jsonc" > "$HOME/.config/waybar/config.jsonc.tmp" 2>/dev/null && mv "$HOME/.config/waybar/config.jsonc.tmp" "$HOME/.config/waybar/config.jsonc"
            fi
        fi

        if command -v omarchy-undercover-autohide &>/dev/null; then
            if [[ "$visibility" == "autohide" ]]; then
                omarchy-undercover-autohide --start >/dev/null 2>&1 || true
            else
                omarchy-undercover-autohide --stop >/dev/null 2>&1 || true
            fi
        fi
        msg "Windows 11 waybar taskbar deployed ($visibility, $align)."
    fi
}

apply_shell_windows() {
    local backend
    backend=$(detect_shell_backend)

    if [[ "$backend" == "quickshell" ]]; then
        local src
        src=$(project_file "shell/shell-win.json")
        if [[ -z "$src" || ! -f "$src" ]]; then
            src="${SCRIPT_DIR}/../configs/shell/shell-win.json"
        fi
        if [[ -f "$src" ]]; then
            mkdir -p "$HOME/.config/omarchy"
            local align
            align=$(read_setting "TASKBAR_ALIGNMENT" "center")
            if [[ "$align" == "center" ]]; then
                if command_exists jq; then
                    jq '.bar.centerAnchor = "" | .bar.layout.left = [{"id": "omarchy-undercover.win11-weather"}] | .bar.layout.center = [{"id": "omarchy-undercover.win11-taskbar"}]' "$src" > "$HOME/.config/omarchy/shell.json" 2>/dev/null || cp -f "$src" "$HOME/.config/omarchy/shell.json"
                else
                    cp -f "$src" "$HOME/.config/omarchy/shell.json"
                fi
            else
                # Left-aligned classic Windows layout
                if command_exists jq; then
                    jq '.bar.centerAnchor = "" | .bar.layout.left = [{"id": "omarchy-undercover.win11-taskbar"}] | .bar.layout.center = [{"id": "omarchy-undercover.win11-weather"}]' "$src" > "$HOME/.config/omarchy/shell.json" 2>/dev/null || cp -f "$src" "$HOME/.config/omarchy/shell.json"
                else
                    cp -f "$src" "$HOME/.config/omarchy/shell.json"
                fi
            fi
            msg "Windows 11 Quickshell taskbar applied (alignment: $align)."
        fi
    fi

    # Always prepare Waybar config as well for seamless fallback
    apply_waybar_windows
}

apply_shell_mac() {
    local backend
    backend=$(detect_shell_backend)

    if [[ "$backend" == "quickshell" ]]; then
        local src
        src=$(project_file "shell/shell-mac.json")
        if [[ -z "$src" || ! -f "$src" ]]; then
            src="${SCRIPT_DIR}/../configs/shell/shell-mac.json"
        fi
        if [[ -f "$src" ]]; then
            mkdir -p "$HOME/.config/omarchy" "$CONFIG_DIR/shell"
            cp -f "$src" "$HOME/.config/omarchy/shell.json"
            cp -f "$src" "$CONFIG_DIR/shell/shell-mac.json"
            msg "Apple macOS Sequoia Quickshell menu bar applied (Omarchy 4.0 top bar)."
        fi
    fi

    # Deploy Waybar mac config for fallback/dual support
    if [[ -f "$CONFIG_DIR/waybar/config-mac.jsonc" ]]; then
        mkdir -p "$HOME/.config/waybar"
        cp -f "$CONFIG_DIR/waybar/config-mac.jsonc" "$HOME/.config/waybar/config.jsonc"
        cp -f "$CONFIG_DIR/waybar/style-mac.css" "$HOME/.config/waybar/style.css"
    fi
}

restore_shell_from_baseline() {
    local baseline="${1:-}"
    local restored=false
    if [[ -n "$baseline" && -f "$baseline/omarchy/shell.json" ]]; then
        if ! grep -q "undercover\." "$baseline/omarchy/shell.json"; then
            mkdir -p "$HOME/.config/omarchy"
            cp -f "$baseline/omarchy/shell.json" "$HOME/.config/omarchy/shell.json"
            msg "Restored original Omarchy Quickshell layout."
            restored=true
        fi
    fi

    if [[ "$restored" == "false" ]]; then
        local def_src="/usr/share/omarchy/config/omarchy/shell.json"
        if [[ ! -f "$def_src" ]]; then
            def_src=$(project_file "shell/shell-default.json")
        fi
        if [[ -z "$def_src" || ! -f "$def_src" ]]; then
            def_src="${SCRIPT_DIR}/../configs/shell/shell-default.json"
        fi
        if [[ -f "$def_src" ]]; then
            mkdir -p "$HOME/.config/omarchy"
            cp -f "$def_src" "$HOME/.config/omarchy/shell.json"
            msg "Restored default Omarchy Quickshell layout."
            restored=true
        fi
    fi

    if command_exists omarchy-shell; then
        omarchy-shell shell reloadConfig >/dev/null 2>&1 || true
    fi
}

apply_rofi_windows() {
    local launcher
    launcher=$(detect_launcher)
    local src
    src=$(project_file "rofi")

    if [[ "$launcher" == "rofi" && -n "$src" && -d "$src" ]]; then
        rm -rf "$HOME/.config/rofi"
        cp -r "$src" "$HOME/.config/rofi"
        msg "Windows 11 Start menu (rofi) applied."
    fi
}

apply_mako_windows() {
    local src
    src=$(project_file "mako")
    if [[ -n "$src" && -f "$src/config" ]]; then
        mkdir -p "$HOME/.config/mako"
        cp "$src/config" "$HOME/.config/mako/config"
        omarchy_reload_mako
        msg "Windows 11 notification style applied."
    fi
}

apply_alacritty_windows() {
    local src
    src=$(project_file "alacritty")
    if [[ -n "$src" && -f "$src/windows-terminal.toml" ]]; then
        mkdir -p "$HOME/.config/alacritty"
        cp "$src/windows-terminal.toml" "$HOME/.config/alacritty/alacritty.toml"
        msg "Windows Terminal style applied to Alacritty."
    fi
}

apply_fontconfig_windows() {
    local src
    src=$(project_file "fontconfig")
    if [[ -n "$src" && -f "$src/fonts.conf" ]]; then
        mkdir -p "$HOME/.config/fontconfig"
        cp "$src/fonts.conf" "$HOME/.config/fontconfig/fonts.conf"
        fc-cache -f >/dev/null 2>&1 || true
        msg "Windows 11 font rendering configuration applied."
    fi
}

backup_original_configs() {
    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S)
    local cur_backup="$BACKUP_DIR/$timestamp"
    mkdir -p "$cur_backup"

    msg "Backing up original desktop configs to $cur_backup"

    if [[ -f "$HOME/.config/hypr/hyprland.conf" ]]; then
        mkdir -p "$cur_backup/hypr"
        cp "$HOME/.config/hypr/hyprland.conf" "$cur_backup/hypr/"
    fi
    if [[ -f "$HOME/.config/hypr/hyprland.lua" ]]; then
        mkdir -p "$cur_backup/hypr"
        cp "$HOME/.config/hypr/hyprland.lua" "$cur_backup/hypr/"
    fi

    backup_config_dir "waybar" "$cur_backup"
    if [[ -f "$HOME/.config/omarchy/shell.json" ]]; then
        if ! grep -q "undercover\." "$HOME/.config/omarchy/shell.json"; then
            mkdir -p "$cur_backup/omarchy"
            cp -f "$HOME/.config/omarchy/shell.json" "$cur_backup/omarchy/"
        fi
    fi

    # Capture original Omarchy theme
    if command_exists omarchy; then
        local cur_theme
        cur_theme=$(omarchy theme current 2>/dev/null || true)
        if [[ -n "$cur_theme" && "$cur_theme" != *"Undercover"* && "$cur_theme" != *"Windows"* && "$cur_theme" != *"windows"* && "$cur_theme" != *"Mac"* && "$cur_theme" != *"mac"* ]]; then
            echo "$cur_theme" > "$cur_backup/theme.name"
        fi
    fi
    backup_config_dir "rofi" "$cur_backup"
    backup_config_dir "wofi" "$cur_backup"
    backup_config_dir "gtk-3.0" "$cur_backup"
    backup_config_dir "gtk-4.0" "$cur_backup"
    backup_config_dir "mako" "$cur_backup"
    backup_config_dir "alacritty" "$cur_backup"
    backup_config_dir "fontconfig" "$cur_backup"

    # Capture gtk settings
    local gtk_file="$cur_backup/gtk_settings.conf"
    if command_exists gsettings; then
        echo "GTK_THEME=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null || echo '')" > "$gtk_file"
        echo "ICON_THEME=$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null || echo '')" >> "$gtk_file"
        echo "CURSOR_THEME=$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null || echo '')" >> "$gtk_file"
        echo "FONT_NAME=$(gsettings get org.gnome.desktop.interface font-name 2>/dev/null || echo '')" >> "$gtk_file"
        echo "COLOR_SCHEME=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || echo '')" >> "$gtk_file"
        echo "CURSOR_SIZE=$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null || echo '')" >> "$gtk_file"
    fi

    if type create_manifest >/dev/null 2>&1; then
        create_manifest "$cur_backup"
    fi

    echo "$cur_backup" > "$BASELINE_FILE"
}

restore_gtk_from_baseline() {
    local baseline="$1"
    local gtk_file="$baseline/gtk_settings.conf"
    if [[ -n "$baseline" && -f "$gtk_file" ]]; then
        local GTK_THEME="" ICON_THEME="" CURSOR_THEME="" FONT_NAME="" COLOR_SCHEME="" CURSOR_SIZE=""
        source "$gtk_file"
        omarchy_set_gnome_theme "${GTK_THEME//\'/}" "${ICON_THEME//\'/}" "${CURSOR_THEME//\'/}" "${CURSOR_SIZE//\'/}"
        if [[ -n "${FONT_NAME:-}" ]]; then
            gsettings set org.gnome.desktop.interface font-name "${FONT_NAME//\'/}" 2>/dev/null || true
        fi
        if [[ -n "${COLOR_SCHEME:-}" ]]; then
            gsettings set org.gnome.desktop.interface color-scheme "${COLOR_SCHEME//\'/}" 2>/dev/null || true
        fi
    else
        # Fallback: Restore pristine default Omarchy theme
        omarchy_set_gnome_theme "Adwaita" "Papirus-Dark" "Bibata-Modern-Classic" "24"
        gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface font-name "Sans 10" 2>/dev/null || true
    fi
    # Remove custom Undercover GTK styling and reset button layout
    rm -f "$HOME/.config/gtk-3.0/gtk.css" "$HOME/.config/gtk-4.0/gtk.css" 2>/dev/null || true
    gsettings set org.gnome.desktop.wm.preferences button-layout ":close" 2>/dev/null || true
}

apply_flea_mac() {
    if command_exists flea; then
        flea --ui-state '{"view":"columns","density":"comfortable","keys":"mac","places":{"sidebarWidth":192,"showHome":true,"showNetwork":true,"showDevices":true,"showTrash":true,"driveSize":true,"trashCount":false,"rail":"shown"},"preview":{"column":true,"loadOn":"automatic","thumbnails":"media","thumbSize":"medium","ctrlZoom":true},"columns":["name","date","kind","size"],"foldersFirst":true,"hidden":false}' >/dev/null 2>&1 || true
        msg "Configured Flea for Apple macOS Finder (column view, Mac keymap, preview column)."
    fi
}

apply_flea_windows() {
    if command_exists flea; then
        flea --ui-state '{"view":"list","density":"normal","keys":"windows","places":{"sidebarWidth":224,"showHome":true,"showNetwork":true,"showDevices":true,"showTrash":true,"driveSize":true,"trashCount":false,"rail":"shown"},"preview":{"column":false},"columns":["name","date","kind","size"],"foldersFirst":true,"hidden":false}' >/dev/null 2>&1 || true
        msg "Configured Flea for Windows 11 File Explorer (Details list view, Windows keymap, full width)."
    fi
}

restore_flea_defaults() {
    if command_exists flea; then
        flea --ui-state '{"view":"columns","density":"normal","keys":"default","preview":{"column":true}}' >/dev/null 2>&1 || true
        msg "Restored Flea default UI configuration."
    fi
}

sync_undercover_themes() {
    local src
    src=$(project_file "omarchy-theme")
    if [[ -n "$src" && -d "$src" ]]; then
        mkdir -p "$HOME/.config/omarchy/themes"
        for t in "macos-dark" "macos-light" "windows11-dark" "windows11-light"; do
            if [[ -d "$src/$t" ]]; then
                mkdir -p "$HOME/.config/omarchy/themes/$t"
                cp -r "$src/$t/"* "$HOME/.config/omarchy/themes/$t/" 2>/dev/null || true
            fi
        done
    fi
}

switch_to_mac() {
    local variant="dark"
    if [[ "${1:-}" == "light" || "${1:-}" == "--light" || "${2:-}" == "light" || "${2:-}" == "--light" ]]; then
        variant="light"
    fi

    msg "Switching to Apple macOS Sequoia ($variant)..."
    if [[ ! -f "$BASELINE_FILE" ]]; then
        backup_original_configs
    fi
    echo "mac-$variant" > "$STATE_FILE"
    write_setting "MODE" "mac"
    write_setting "THEME_VARIANT" "$variant"
    write_setting "LAST_UNDERCOVER_MODE" "mac-$variant"
    rm -f "$HOME/.local/state/omarchy/toggles/bar-off" 2>/dev/null || true

    sync_undercover_themes
    if command_exists omarchy-theme-set; then
        omarchy-theme-set "macos-$variant" 2>/dev/null || true
    fi

    local gtk_icon="WhiteSur-dark"
    local gtk_theme="WhiteSur-Dark"
    local wall_img="macOS-Sequoia-Dark.jpg"
    local color_scheme="prefer-dark"
    if [[ "$variant" == "light" ]]; then
        gtk_icon="WhiteSur-light"
        gtk_theme="WhiteSur-Light"
        wall_img="macOS-Sequoia-Light.jpg"
        color_scheme="prefer-light"
    fi

    # 1. GSettings (GNOME / GTK / Flatpak / Libadwaita)
    if command_exists gsettings; then
        gsettings set org.gnome.desktop.wm.preferences button-layout "close,minimize,maximize:" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface icon-theme "$gtk_icon" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface font-name "SF Pro Text 10.5" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface document-font-name "SF Pro Text 10.5" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface monospace-font-name "Liga SFMono Nerd Font 10.5" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface color-scheme "$color_scheme" 2>/dev/null || true
    fi

    # 2. GTK 3.0 & 4.0 settings.ini
    for gtk_dir in "gtk-3.0" "gtk-4.0"; do
        mkdir -p "$HOME/.config/$gtk_dir"
        cat > "$HOME/.config/$gtk_dir/settings.ini" << EOF
[Settings]
gtk-theme-name=$gtk_theme
gtk-icon-theme-name=$gtk_icon
gtk-cursor-theme-name=Fluent-dark-cursors
gtk-cursor-theme-size=24
gtk-font-name=SF Pro Text 10.5
gtk-application-prefer-dark-theme=$([ "$color_scheme" = "prefer-dark" ] && echo 1 || echo 0)
gtk-decoration-layout=close,minimize,maximize:
EOF
    done

    # 3. GTK 2.0 (~/.gtkrc-2.0)
    cat > "$HOME/.gtkrc-2.0" << EOF
gtk-theme-name="$gtk_theme"
gtk-icon-theme-name="$gtk_icon"
gtk-font-name="SF Pro Text 10.5"
gtk-cursor-theme-name="Fluent-dark-cursors"
gtk-cursor-theme-size=24
EOF

    # 4. xsettingsd for X11 & XWayland apps
    mkdir -p "$HOME/.config/xsettingsd"
    cat > "$HOME/.config/xsettingsd/xsettingsd.conf" << EOF
Net/ThemeName "$gtk_theme"
Net/IconThemeName "$gtk_icon"
Gtk/FontName "SF Pro Text 10.5"
Gtk/CursorThemeName "Fluent-dark-cursors"
Gtk/CursorThemeSize 24
Gtk/DecorationLayout "close,minimize,maximize:"
EOF
    killall -HUP xsettingsd 2>/dev/null || true

    apply_flea_mac

    # Deploy macOS Finder file manager icon
    if [[ -f "$HOME/.local/share/icons/hicolor/scalable/apps/mac-finder.svg" ]]; then
        cp -f "$HOME/.local/share/icons/hicolor/scalable/apps/system-file-manager.svg" 2>/dev/null || true
        cp -f "$HOME/.local/share/icons/hicolor/scalable/apps/mac-finder.svg" "$HOME/.local/share/icons/mac-dock/finder.svg" 2>/dev/null || true
        gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true
    fi

    # Deploy macOS traffic light GTK CSS
    if [[ -f "$CONFIG_DIR/gtk/mac-style.css" ]]; then
        cp -f "$CONFIG_DIR/gtk/mac-style.css" "$HOME/.config/gtk-4.0/gtk.css" 2>/dev/null || true
        cp -f "$CONFIG_DIR/gtk/mac-style.css" "$HOME/.config/gtk-3.0/gtk.css" 2>/dev/null || true
    fi

    # Deploy shell configuration (Quickshell or Waybar)
    apply_shell_mac

    # Deploy mac Rofi theme
    if [[ -f "$CONFIG_DIR/rofi/mac.rasi" ]]; then
        cp -f "$CONFIG_DIR/rofi/mac.rasi" "$HOME/.config/rofi/windows11.rasi" 2>/dev/null || true
        cp -f "$CONFIG_DIR/rofi/mac.rasi" "$HOME/.config/rofi/mac.rasi" 2>/dev/null || true
    fi

    # Apply wallpaper
    if [[ -f "$CONFIG_DIR/wallpapers/$wall_img" ]]; then
        killall swaybg 2>/dev/null || true
        nohup swaybg -i "$CONFIG_DIR/wallpapers/$wall_img" -m fill >/dev/null 2>&1 &
        disown 2>/dev/null || true
    fi

    # Dispatch macOS sound effects
    if [[ -d "$CONFIG_DIR/sounds" ]]; then
        cp -f "$CONFIG_DIR/sounds/mac-notify.wav" "$CONFIG_DIR/sounds/current-notify.wav" 2>/dev/null || true
        omarchy-play-sound mac-switch 2>/dev/null || true
    fi

    omarchy_reload_bar
    enable_undercover_hyprland "mac" 2>/dev/null || true
    omarchy_reload_hyprland

    local enable_dock
    enable_dock=$(read_setting "ENABLE_MAC_DOCK" "true")
    if [[ "$enable_dock" == "true" ]]; then
        pkill -f "quickshell.*mac-dock" 2>/dev/null || true
        local dock_dir="$CONFIG_DIR/quickshell/mac-dock"
        mkdir -p "$dock_dir"
        if [[ -f "$PLUGIN_DIR/configs/quickshell/mac-dock/shell.qml" ]]; then
            cp -f "$PLUGIN_DIR/configs/quickshell/mac-dock/shell.qml" "$dock_dir/shell.qml" 2>/dev/null || true
        elif [[ -f "${SCRIPT_DIR}/../configs/quickshell/mac-dock/shell.qml" ]]; then
            cp -f "${SCRIPT_DIR}/../configs/quickshell/mac-dock/shell.qml" "$dock_dir/shell.qml" 2>/dev/null || true
        fi
        setsid -f quickshell -p "$dock_dir" >/dev/null 2>&1 || (nohup quickshell -p "$dock_dir" >/dev/null 2>&1 &)
    fi

    msg "Switched to Apple macOS Sequoia ($variant) — done!"
}

switch_to_win11() {
    local variant="dark"
    if [[ "${1:-}" == "light" || "${1:-}" == "--light" || "${2:-}" == "light" || "${2:-}" == "--light" ]]; then
        variant="light"
    fi

    msg "Switching to Windows 11 ($variant)..."
    pkill -9 -f "mac-dock" 2>/dev/null || true
    pkill -9 -f "omarchy-mac-dock" 2>/dev/null || true
    if [[ ! -f "$BASELINE_FILE" ]]; then
        backup_original_configs
    fi
    echo "win11-$variant" > "$STATE_FILE"
    write_setting "MODE" "windows"
    write_setting "THEME_VARIANT" "$variant"
    write_setting "LAST_UNDERCOVER_MODE" "win11-$variant"
    rm -f "$HOME/.local/state/omarchy/toggles/bar-off" 2>/dev/null || true

    sync_undercover_themes
    if command_exists omarchy-theme-set; then
        omarchy-theme-set "windows11-$variant" 2>/dev/null || true
    fi

    local gtk_icon="Fluent-dark"
    local gtk_theme="Win11-Dark"
    local wall_img="win11_bloom_dark.jpg"
    local color_scheme="prefer-dark"
    if [[ "$variant" == "light" ]]; then
        gtk_icon="Fluent-light"
        gtk_theme="Win11-Light"
        wall_img="win11_bloom_light.jpg"
        color_scheme="prefer-light"
    fi

    # 1. GSettings (GNOME / GTK / Flatpak / Libadwaita)
    if command_exists gsettings; then
        gsettings set org.gnome.desktop.wm.preferences button-layout ":minimize,maximize,close" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface icon-theme "$gtk_icon" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface font-name "Segoe UI 10.5" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface document-font-name "Segoe UI 10.5" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface monospace-font-name "Cascadia Code 10.5" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface color-scheme "$color_scheme" 2>/dev/null || true
    fi

    # 2. GTK 3.0 & 4.0 settings.ini
    for gtk_dir in "gtk-3.0" "gtk-4.0"; do
        mkdir -p "$HOME/.config/$gtk_dir"
        cat > "$HOME/.config/$gtk_dir/settings.ini" << EOF
[Settings]
gtk-theme-name=$gtk_theme
gtk-icon-theme-name=$gtk_icon
gtk-cursor-theme-name=Fluent-dark-cursors
gtk-cursor-theme-size=24
gtk-font-name=Segoe UI 10.5
gtk-application-prefer-dark-theme=$([ "$color_scheme" = "prefer-dark" ] && echo 1 || echo 0)
gtk-decoration-layout=:minimize,maximize,close
EOF
    done

    # 3. GTK 2.0 (~/.gtkrc-2.0)
    cat > "$HOME/.gtkrc-2.0" << EOF
gtk-theme-name="$gtk_theme"
gtk-icon-theme-name="$gtk_icon"
gtk-font-name="Segoe UI 10.5"
gtk-cursor-theme-name="Fluent-dark-cursors"
gtk-cursor-theme-size=24
EOF

    # 4. xsettingsd for X11 & XWayland apps
    mkdir -p "$HOME/.config/xsettingsd"
    cat > "$HOME/.config/xsettingsd/xsettingsd.conf" << EOF
Net/ThemeName "$gtk_theme"
Net/IconThemeName "$gtk_icon"
Gtk/FontName "Segoe UI 10.5"
Gtk/CursorThemeName "Fluent-dark-cursors"
Gtk/CursorThemeSize 24
Gtk/DecorationLayout ":minimize,maximize,close"
EOF
    killall -HUP xsettingsd 2>/dev/null || true

    apply_flea_windows

    # Deploy Windows 11 Fluent File Explorer icon
    if [[ -f "$HOME/.local/share/icons/hicolor/scalable/apps/win11-explorer.svg" ]]; then
        cp -f "$HOME/.local/share/icons/hicolor/scalable/apps/win11-explorer.svg" "$HOME/.local/share/icons/hicolor/scalable/apps/system-file-manager.svg" 2>/dev/null || true
        gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true
    fi

    # Deploy Windows 11 Fluent GTK CSS
    if [[ -f "$CONFIG_DIR/gtk/win11-style.css" ]]; then
        cp -f "$CONFIG_DIR/gtk/win11-style.css" "$HOME/.config/gtk-4.0/gtk.css" 2>/dev/null || true
        cp -f "$CONFIG_DIR/gtk/win11-style.css" "$HOME/.config/gtk-3.0/gtk.css" 2>/dev/null || true
    fi

    # Deploy shell configuration (Quickshell or Waybar)
    apply_shell_windows

    # Deploy win11 Rofi theme
    local rofi_src="$CONFIG_DIR/rofi/win11.rasi"
    if [[ "$variant" == "light" && -f "$CONFIG_DIR/rofi/win11-light.rasi" ]]; then
        rofi_src="$CONFIG_DIR/rofi/win11-light.rasi"
    fi
    if [[ -f "$rofi_src" ]]; then
        cp -f "$rofi_src" "$HOME/.config/rofi/windows11.rasi" 2>/dev/null || true
        cp -f "$rofi_src" "$HOME/.config/rofi/win11.rasi" 2>/dev/null || true
    fi

    # Apply wallpaper
    if [[ -f "$CONFIG_DIR/wallpapers/$wall_img" ]]; then
        killall swaybg 2>/dev/null || true
        nohup swaybg -i "$CONFIG_DIR/wallpapers/$wall_img" -m fill >/dev/null 2>&1 &
        disown 2>/dev/null || true
    fi

    # Dispatch Windows 11 sound effects
    if [[ -d "$CONFIG_DIR/sounds" ]]; then
        cp -f "$CONFIG_DIR/sounds/win11-notify.wav" "$CONFIG_DIR/sounds/current-notify.wav" 2>/dev/null || true
        omarchy-play-sound win11-switch 2>/dev/null || true
    fi

    omarchy_reload_bar
    enable_undercover_hyprland "windows" 2>/dev/null || true
    omarchy_reload_hyprland
    msg "Switched to Windows 11 ($variant) — done!"
}

switch_to_windows() {
    switch_to_win11 "$@"
}

switch_to_ios() {
    switch_to_mac "$@"
}

switch_to_omarchy() {
    msg "Restoring original Omarchy desktop..."
    echo "omarchy" > "$STATE_FILE"
    write_setting "MODE" "omarchy"
    pkill -9 -f "mac-dock" 2>/dev/null || true
    pkill -9 -f "omarchy-mac-dock" 2>/dev/null || true
    pkill -f "quickshell.*mac-settings" 2>/dev/null || true
    pkill -f "quickshell.*win11-settings" 2>/dev/null || true
    pkill -f "quickshell.*win11-start" 2>/dev/null || true
    killall swaybg 2>/dev/null || true
    pkill -x swaybg 2>/dev/null || true
    disable_undercover_hyprland 2>/dev/null || true
    rm -f "$HOME/.config/gtk-4.0/gtk.css" "$HOME/.config/gtk-3.0/gtk.css" 2>/dev/null || true

    # Clear bar-off toggle to ensure Quickshell is not hidden globally
    rm -f "$HOME/.local/state/omarchy/toggles/bar-off" 2>/dev/null || true

    # Stop autohide daemon so it does not hide bar in global/default mode
    if command_exists omarchy-undercover-autohide; then
        omarchy-undercover-autohide --stop 2>/dev/null || true
    fi

    local baseline=""
    local theme_restored=false
    if [[ -f "$BASELINE_FILE" ]]; then
        baseline=$(cat "$BASELINE_FILE")
        if [[ -d "$baseline" ]]; then
            restore_config_dir "waybar" "$baseline"
            restore_config_dir "rofi" "$baseline"
            restore_config_dir "wofi" "$baseline"
            restore_config_dir "gtk-3.0" "$baseline"
            restore_config_dir "gtk-4.0" "$baseline"
            restore_config_dir "mako" "$baseline"
            restore_config_dir "alacritty" "$baseline"
            restore_config_dir "fontconfig" "$baseline"
            restore_gtk_from_baseline "$baseline"

            if [[ -f "$baseline/theme.name" ]]; then
                local saved_theme
                saved_theme=$(cat "$baseline/theme.name" 2>/dev/null | tr -d '\r\n')
                if [[ -n "$saved_theme" ]] && command_exists omarchy; then
                    omarchy theme set "$saved_theme" 2>/dev/null || true
                    theme_restored=true
                fi
            fi
        fi
    fi

    if [[ "$theme_restored" == "false" ]] && command_exists omarchy; then
        local cur_theme
        cur_theme=$(omarchy theme current 2>/dev/null || true)
        if [[ "$cur_theme" == *"Windows"* || "$cur_theme" == *"windows"* || "$cur_theme" == *"Mac"* || "$cur_theme" == *"mac"* || "$cur_theme" == *"Undercover"* ]]; then
            omarchy theme set "Krishna" 2>/dev/null || omarchy theme set "Aether" 2>/dev/null || true
        fi
    fi

    # Crucial: restore shell.json AFTER theme set so omarchy-theme-set IPC doesn't overwrite it
    restore_shell_from_baseline "$baseline"
    restore_flea_defaults

    if command_exists gsettings; then
        gsettings set org.gnome.desktop.wm.preferences button-layout "close:minimize,maximize" 2>/dev/null || true
    fi
    omarchy_reload_bar
    omarchy_reload_hyprland
    msg "Restored original Omarchy desktop!"
}

switch_to_hyprland() {
    switch_to_omarchy
}

restore_baseline() {
    msg "Restoring system from baseline backup..."
    pkill -9 -f "mac-dock" 2>/dev/null || true
    pkill -9 -f "omarchy-mac-dock" 2>/dev/null || true
    pkill -f "quickshell.*mac-settings" 2>/dev/null || true
    pkill -f "quickshell.*win11-settings" 2>/dev/null || true
    pkill -f "quickshell.*win11-start" 2>/dev/null || true
    killall swaybg 2>/dev/null || true
    pkill -x swaybg 2>/dev/null || true
    disable_undercover_hyprland 2>/dev/null || true

    # Clear bar-off toggle
    rm -f "$HOME/.local/state/omarchy/toggles/bar-off" 2>/dev/null || true

    if command_exists omarchy-undercover-autohide; then
        omarchy-undercover-autohide --stop 2>/dev/null || true
    fi

    local baseline=""
    local theme_restored=false
    if [[ -f "$BASELINE_FILE" ]]; then
        baseline=$(cat "$BASELINE_FILE")
        if [[ -d "$baseline" ]]; then
            if [[ -f "$baseline/hypr/hyprland.lua" ]]; then
                mkdir -p "$HOME/.config/hypr"
                cp "$baseline/hypr/hyprland.lua" "$HOME/.config/hypr/"
            fi
            if [[ -f "$baseline/hypr/hyprland.conf" ]]; then
                mkdir -p "$HOME/.config/hypr"
                cp "$baseline/hypr/hyprland.conf" "$HOME/.config/hypr/"
            fi
            restore_config_dir "waybar" "$baseline"
            restore_config_dir "rofi" "$baseline"
            restore_config_dir "wofi" "$baseline"
            restore_config_dir "gtk-3.0" "$baseline"
            restore_config_dir "gtk-4.0" "$baseline"
            restore_config_dir "mako" "$baseline"
            restore_config_dir "alacritty" "$baseline"
            restore_config_dir "fontconfig" "$baseline"
            restore_gtk_from_baseline "$baseline"

            if [[ -f "$baseline/theme.name" ]]; then
                local saved_theme
                saved_theme=$(cat "$baseline/theme.name" 2>/dev/null | tr -d '\r\n')
                if [[ -n "$saved_theme" ]] && command_exists omarchy; then
                    omarchy theme set "$saved_theme" 2>/dev/null || true
                    theme_restored=true
                fi
            fi
        fi
    fi

    if [[ "$theme_restored" == "false" ]] && command_exists omarchy; then
        local cur_theme
        cur_theme=$(omarchy theme current 2>/dev/null || true)
        if [[ "$cur_theme" == *"Windows"* || "$cur_theme" == *"windows"* || "$cur_theme" == *"Mac"* || "$cur_theme" == *"mac"* || "$cur_theme" == *"Undercover"* ]]; then
            omarchy theme set "Krishna" 2>/dev/null || omarchy theme set "Aether" 2>/dev/null || true
        fi
    fi

    # Crucial: restore shell.json AFTER theme set so omarchy-theme-set IPC doesn't overwrite it
    restore_shell_from_baseline "$baseline"
    restore_flea_defaults

    omarchy_reload_bar
    omarchy_reload_hyprland

    rm -f "$STATE_FILE"
    msg "Baseline restored successfully."
}

verify_integrity() {
    msg "Verifying integrity..."
    echo "Omarchy Version: $(detect_omarchy_version)"
    local backend
    backend=$(detect_shell_backend)
    echo "Active Shell Backend: $backend (Quickshell supported: $(is_quickshell_supported && echo 'Yes' || echo 'No'))"
    if [[ -f "$STATE_FILE" ]]; then
        echo "State: $(cat "$STATE_FILE")"
    else
        echo "State: default"
    fi
    if [[ -f "$BASELINE_FILE" ]]; then
        echo "Baseline available: Yes"
    else
        echo "Baseline available: No"
    fi
    if command_exists omarchy-plugin-validate; then
        local plugin_root="${SCRIPT_DIR}/.."
        if [[ -f "$plugin_root/manifest.json" ]] && omarchy-plugin-validate "$plugin_root" >/dev/null 2>&1; then
            echo "Omarchy Plugin Compliance: Valid (schema v1, root & sub-plugins compliant)"
        elif [[ -d "$HOME/.config/omarchy/plugins/omarchy-undercover" ]] && omarchy-plugin-validate "$HOME/.config/omarchy/plugins/omarchy-undercover" >/dev/null 2>&1; then
            echo "Omarchy Plugin Compliance: Valid (installed in ~/.config/omarchy/plugins/omarchy-undercover)"
        elif [[ -d "$HOME/.config/omarchy/plugins/undercover" ]] && omarchy-plugin-validate "$HOME/.config/omarchy/plugins/undercover" >/dev/null 2>&1; then
            echo "Omarchy Plugin Compliance: Valid (installed in ~/.config/omarchy/plugins/undercover)"
        fi
    fi
    echo "Launcher: $(detect_launcher)"
    if grep -q "windows-mode" "$HOME/.config/hypr/hyprland.lua" 2>/dev/null; then
        echo "Hyprland Windows Mode (lua): Active"
    else
        echo "Hyprland Windows Mode (lua): Inactive"
    fi
    if [[ -d "$HOME/.themes/Win11-Dark" || -d "$HOME/.local/share/themes/Win11-Dark" ]]; then
        echo "Win11 GTK Theme: Installed"
    fi
    if [[ -d "$HOME/.icons/Fluent-dark" || -d "$HOME/.icons/Fluent" || -d "$HOME/.local/share/icons/Fluent-dark" ]]; then
        echo "Fluent Icon Theme: Installed"
    fi
    if [[ -d "$HOME/.icons/WhiteSur-dark" || -d "$HOME/.local/share/icons/WhiteSur-dark" ]]; then
        echo "WhiteSur Icon Theme: Installed"
    fi
    if command_exists hyprctl; then
        echo "Hyprland Lua config errors: $(hyprctl configerrors 2>/dev/null | grep -c . || echo 0)"
    fi
}

show_status() {
    if [[ -f "$STATE_FILE" ]]; then
        local state
        state=$(cat "$STATE_FILE")
        echo "Omarchy Undercover: $state mode [Backend: $(detect_shell_backend)]"
    else
        echo "Omarchy Undercover: default mode [Backend: $(detect_shell_backend)]"
    fi
}

show_help() {
    echo "Usage: omarchy-undercover [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -mac, --mac, --macOS, -apple, --apple  Switch to Apple macOS Sequoia (dark by default)"
    echo "  -mac-light, --mac-light                 Switch to Apple macOS Sequoia Light mode"
    echo "  -w11, --w11, --win11, --enable          Switch to Windows 11 (dark by default)"
    echo "  -w11-light, --win11-light               Switch to Windows 11 Light mode"
    echo "  --backend [auto|quickshell|waybar]      Select or show desktop status bar engine"
    echo "  --transparency [on|off]                 Configure desktop frosted glass transparency"
    echo "  --taskbar-transparent [true|false|toggle] Toggle or set taskbar transparency"
    echo "  --toggle                                Toggle between Undercover mode and Default Omarchy"
    echo "  --disable, --omarchy                    Switch to original Omarchy mode & theming"
    echo "  --restore                               Restore from baseline backup"
    echo "  --verify                                Verify integrity of config and state"
    echo "  --status                                Show current status"
    echo "  --help, -h                              Show this help message"
}

toggle_mode() {
    local current=""
    [[ -f "$STATE_FILE" ]] && current=$(cat "$STATE_FILE" 2>/dev/null | tr -d '[:space:]')

    case "$current" in
        mac*|win11*|windows*|apple*|ios*)
            # Currently in an Undercover mode -> save state and restore to default Omarchy desktop
            write_setting "LAST_UNDERCOVER_MODE" "$current"
            switch_to_omarchy
            ;;
        *)
            # Currently in default Omarchy mode -> restore the chosen undercover preset
            local target
            target=$(read_setting "LAST_UNDERCOVER_MODE" "mac-dark")
            case "$target" in
                mac-light) switch_to_mac "light" ;;
                mac*|apple*|ios*) switch_to_mac "dark" ;;
                win11-light|windows-light) switch_to_win11 "light" ;;
                win11*|windows*) switch_to_win11 "dark" ;;
                *) switch_to_mac "dark" ;;
            esac
            ;;
    esac
}

if [[ $# -eq 0 ]]; then
    toggle_mode
    exit 0
fi

case "$1" in
    --toggle)
        toggle_mode
        ;;
    --backend)
        if [[ -n "${2:-}" ]]; then
            case "$2" in
                auto|quickshell|waybar)
                    write_setting "SHELL_BACKEND" "$2"
                    msg "Shell backend set to: $2 (Active: $(detect_shell_backend))"
                    omarchy_reload_bar
                    ;;
                *)
                    error "Invalid backend: $2 (choose: auto, quickshell, waybar)"
                    ;;
            esac
        else
            echo "Current backend preference: $(read_setting "SHELL_BACKEND" "auto") (Active: $(detect_shell_backend))"
        fi
        ;;
    -mac|--mac|--macOS|-apple|--apple|-app|-ios|--ios)
        if [[ "${2:-}" == "--light" || "${2:-}" == "light" ]]; then
            switch_to_mac "light"
        else
            switch_to_mac "dark"
        fi
        ;;
    -mac-light|--mac-light)
        switch_to_mac "light"
        ;;
    -w11|--w11|--win11|--enable)
        if [[ "${2:-}" == "--light" || "${2:-}" == "light" ]]; then
            switch_to_win11 "light"
        else
            switch_to_win11 "dark"
        fi
        ;;
    -w11-light|--win11-light)
        switch_to_win11 "light"
        ;;
    --autohide)
        if [[ "${2:-}" == "off" || "${2:-}" == "disable" || "${2:-}" == "0" ]]; then
            write_setting "AUTOHIDE" "false"
            omarchy-undercover-autohide --stop
            msg "Auto-hide disabled (Bar kept visible)."
        elif [[ "${2:-}" == "status" ]]; then
            omarchy-undercover-autohide --status
        else
            write_setting "AUTOHIDE" "true"
            omarchy-undercover-autohide --start
            msg "Intelligent mouse-edge auto-hide enabled."
        fi
        ;;
    --opacity)
        if [[ -n "${2:-}" ]]; then
            active_op="$2"
            inact_op="${3:-0.85}"
            write_setting "ACTIVE_OPACITY" "$active_op"
            write_setting "INACTIVE_OPACITY" "$inact_op"
            hyprctl keyword decoration:active_opacity "$active_op" >/dev/null 2>&1 || true
            hyprctl keyword decoration:inactive_opacity "$inact_op" >/dev/null 2>&1 || true
            msg "Window opacity set to: active=$active_op, inactive=$inact_op"
        else
            echo "Current opacity: active=$(read_setting "ACTIVE_OPACITY" "0.95"), inactive=$(read_setting "INACTIVE_OPACITY" "0.85")"
        fi
        ;;
    --transparency)
        if [[ "${2:-}" == "off" || "${2:-}" == "false" || "${2:-}" == "0" ]]; then
            write_setting "BAR_TRANSPARENT" "false"
            write_setting "WIN11_TRANSPARENCY" "false"
            write_setting "DOCK_OPACITY" "1.0"
            write_setting "TASKBAR_OPACITY" "1.0"
            if command_exists omarchy; then
                omarchy bar transparent false 2>/dev/null || true
            fi
            msg "Transparency disabled (Solid surfaces)."
        else
            write_setting "BAR_TRANSPARENT" "true"
            write_setting "WIN11_TRANSPARENCY" "true"
            write_setting "DOCK_OPACITY" "${2:-0.85}"
            write_setting "TASKBAR_OPACITY" "${2:-0.90}"
            if command_exists omarchy; then
                omarchy bar transparent true 2>/dev/null || true
            fi
            msg "Transparency enabled (Frosted glass surfaces)."
        fi
        omarchy_reload_bar
        ;;
    --taskbar-transparent|--taskbar-transparency)
        t_val="${2:-}"
        if [[ "$t_val" == "off" || "$t_val" == "false" || "$t_val" == "0" ]]; then
            write_setting "BAR_TRANSPARENT" "false"
            write_setting "WIN11_TRANSPARENCY" "false"
            if command_exists omarchy; then
                omarchy bar transparent false 2>/dev/null || true
            fi
            msg "Taskbar transparency disabled (Solid acrylic plate)."
        elif [[ "$t_val" == "toggle" ]]; then
            if command_exists omarchy; then
                omarchy bar transparent toggle 2>/dev/null || true
                curr_trans=$(cat "$HOME/.config/omarchy/shell.json" 2>/dev/null | jq -r .bar.transparent 2>/dev/null || echo "true")
                write_setting "BAR_TRANSPARENT" "$curr_trans"
                write_setting "WIN11_TRANSPARENCY" "$curr_trans"
                msg "Taskbar transparency toggled: $curr_trans"
            fi
        else
            write_setting "BAR_TRANSPARENT" "true"
            write_setting "WIN11_TRANSPARENCY" "true"
            if command_exists omarchy; then
                omarchy bar transparent true 2>/dev/null || true
            fi
            msg "Taskbar transparency enabled (Clear / Acrylic)."
        fi
        omarchy_reload_bar
        ;;
    --disable|--omarchy)
        switch_to_omarchy
        ;;
    --restore)
        restore_baseline
        ;;
    --sync-hyprland)
        cur_mode=$(read_setting "MODE" "windows")
        enable_undercover_hyprland "$cur_mode"
        ;;
    --verify)
        verify_integrity
        ;;
    --status)
        show_status
        ;;
    --help|-h)
        show_help
        ;;
    *)
        echo "Unknown option: $1"
        show_help
        exit 1
        ;;
esac


exit 0
