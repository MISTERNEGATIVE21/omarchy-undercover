#!/usr/bin/env bash
# ==============================================================================
# omarchy-mac-screensaver — macOS Aerial Video Screen Saver Manager & Downloader
#
# Manages video screensaver preferences, official Apple Aerial 4K/1080p CDN assets,
# and IPC interactions for Omarchy Undercover (macOS Sequoia Camouflage mode).
#
# License: GPL-3.0-or-later
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Config file locations
# Config file locations (prioritize active plugin configuration)
SETTINGS_FILE="$HOME/.config/omarchy/plugins/omarchy-undercover/settings.conf"
if [[ ! -f "$SETTINGS_FILE" ]] && [[ -f "$PLUGIN_DIR/settings.conf" ]]; then
    SETTINGS_FILE="$PLUGIN_DIR/settings.conf"
fi

SCREENSAVER_DIR="$HOME/.local/share/omarchy-undercover/screensavers"
mkdir -p "$SCREENSAVER_DIR"

# Curated Drone & Aerial Video Catalog (YouTube 1080p / 4K / Open Web)
declare -A CATALOG_NAMES
declare -A CATALOG_LOCATIONS
declare -A CATALOG_RES
declare -A CATALOG_SIZES
declare -A CATALOG_URLS

CATALOG_NAMES["sonoma_horizon"]="Sonoma Horizon"
CATALOG_LOCATIONS["sonoma_horizon"]="California, USA"
CATALOG_RES["sonoma_horizon"]="1080p"
CATALOG_SIZES["sonoma_horizon"]="~45MB"
CATALOG_URLS["sonoma_horizon"]="https://www.youtube.com/watch?v=QOLTfZPp3Xs"

CATALOG_NAMES["yosemite"]="Yosemite Valley"
CATALOG_LOCATIONS["yosemite"]="California, USA"
CATALOG_RES["yosemite"]="1080p"
CATALOG_SIZES["yosemite"]="~50MB"
CATALOG_URLS["yosemite"]="https://www.youtube.com/watch?v=5BNnG_GxYVw"

CATALOG_NAMES["patagonia"]="Patagonia Glaciers"
CATALOG_LOCATIONS["patagonia"]="Patagonia, Argentina"
CATALOG_RES["patagonia"]="1080p"
CATALOG_SIZES["patagonia"]="~65MB"
CATALOG_URLS["patagonia"]="https://www.youtube.com/watch?v=TAgg3QptRtQ"

CATALOG_NAMES["greenland"]="Greenland Icebergs"
CATALOG_LOCATIONS["greenland"]="Arctic & Greenland"
CATALOG_RES["greenland"]="1080p"
CATALOG_SIZES["greenland"]="~40MB"
CATALOG_URLS["greenland"]="https://www.youtube.com/watch?v=Pe9rMYYcv5E"

CATALOG_NAMES["grand_canyon"]="Grand Canyon Dawn"
CATALOG_LOCATIONS["grand_canyon"]="Arizona, USA"
CATALOG_RES["grand_canyon"]="1080p"
CATALOG_SIZES["grand_canyon"]="~55MB"
CATALOG_URLS["grand_canyon"]="https://www.youtube.com/watch?v=5yZuaAQKnkY"

CATALOG_NAMES["dubai_night"]="Dubai Night Skyline"
CATALOG_LOCATIONS["dubai_night"]="Dubai, UAE"
CATALOG_RES["dubai_night"]="1080p"
CATALOG_SIZES["dubai_night"]="~60MB"
CATALOG_URLS["dubai_night"]="https://www.youtube.com/watch?v=K11iIAx3Uhc"

read_setting() {
    local key="$1"
    local default_val="$2"
    if [[ -f "$SETTINGS_FILE" ]]; then
        local val
        val="$(grep -E "^${key}=" "$SETTINGS_FILE" | head -n1 | cut -d'=' -f2- | tr -d '\r' || true)"
        if [[ -n "$val" ]]; then
            echo "$val"
            return
        fi
    fi
    echo "$default_val"
}

_update_conf() {
    local conf="$1"
    local key="$2"
    local val="$3"
    mkdir -p "$(dirname "$conf")"
    touch "$conf"
    if grep -q "^${key}=" "$conf"; then
        sed -i "s|^${key}=.*|${key}=${val}|" "$conf"
    else
        echo "${key}=${val}" >> "$conf"
    fi
}

write_setting() {
    local key="$1"
    local val="$2"
    _update_conf "$SETTINGS_FILE" "$key" "$val"
    if [[ -f "$PLUGIN_DIR/settings.conf" && "$PLUGIN_DIR/settings.conf" != "$SETTINGS_FILE" ]]; then
        _update_conf "$PLUGIN_DIR/settings.conf" "$key" "$val"
    fi
}

notify_quickshell() {
    # Notify omarchy-undercover-service via Quickshell IPC if running
    if command -v qs &>/dev/null; then
        qs -p /usr/share/omarchy/shell ipc call omarchy-undercover-service reloadScreensaverConfig &>/dev/null || \
        qs ipc call omarchy-undercover-service reloadScreensaverConfig &>/dev/null || true
    fi
}

dispatch_preview() {
    if command -v qs &>/dev/null; then
        qs -p /usr/share/omarchy/shell ipc call omarchy-undercover-service previewScreensaver &>/dev/null || \
        qs ipc call omarchy-undercover-service previewScreensaver &>/dev/null || true
    fi
}

dispatch_dismiss() {
    if command -v qs &>/dev/null; then
        qs -p /usr/share/omarchy/shell ipc call omarchy-undercover-service dismissScreensaver &>/dev/null || \
        qs ipc call omarchy-undercover-service dismissScreensaver &>/dev/null || true
    fi
}

get_status_json() {
    local enabled
    enabled="$(read_setting "SCREENSAVER_ENABLED" "true")"
    local timeout
    timeout="$(read_setting "SCREENSAVER_TIMEOUT" "300")"
    local active_clip
    active_clip="$(read_setting "SCREENSAVER_VIDEO" "")"

    # If no active clip set, clip does not exist, or points to incidental screenrecording, default to aerial clip
    if [[ -z "$active_clip" || ! -f "$active_clip" || "$active_clip" == *screenrecording* ]]; then
        local first_found
        first_found="$(find "$SCREENSAVER_DIR" "$PLUGIN_DIR/assets/screensavers" -maxdepth 1 -type f \( -name "*.mp4" -o -name "*.webm" \) 2>/dev/null | grep -E "sonoma_horizon|aerial" | head -n1 || true)"
        if [[ -z "$first_found" ]]; then
            first_found="$(find "$SCREENSAVER_DIR" "$PLUGIN_DIR/assets/screensavers" -maxdepth 1 -type f \( -name "*.mp4" -o -name "*.webm" \) 2>/dev/null | head -n1 || true)"
        fi
        if [[ -n "$first_found" ]]; then
            active_clip="$first_found"
            write_setting "SCREENSAVER_VIDEO" "$active_clip"
        fi
    fi

    # Build installed clips JSON array
    local installed_json="[]"
    local files
    files="$(find "$SCREENSAVER_DIR" "$PLUGIN_DIR/assets/screensavers" -maxdepth 1 -type f \( -name "*.mp4" -o -name "*.webm" \) 2>/dev/null || true)"
    if [[ -n "$files" ]]; then
        installed_json="$(echo "$files" | jq -R . | jq -s 'map({
            path: .,
            name: (split("/") | last | sub("\\.(mp4|webm)$"; "") | gsub("_"; " ") | capture("^(?<first>.)(?<rest>.*)$") | (.first | ascii_upcase) + .rest),
            size_mb: (try (1) catch 0)
        })')"
    fi

    # Build catalog JSON array
    local catalog_json
    catalog_json="$(python3 -c '
import json, os

catalog_ids = ["sonoma_horizon", "yosemite", "patagonia", "greenland", "grand_canyon", "dubai_night"]
names = {
    "sonoma_horizon": "Sonoma Horizon",
    "yosemite": "Yosemite Valley",
    "patagonia": "Patagonia Glaciers",
    "greenland": "Greenland Icebergs",
    "grand_canyon": "Grand Canyon Dawn",
    "dubai_night": "Dubai Night Skyline"
}
locations = {
    "sonoma_horizon": "California, USA",
    "yosemite": "California, USA",
    "patagonia": "Patagonia, Argentina",
    "greenland": "Arctic & Greenland",
    "grand_canyon": "Arizona, USA",
    "dubai_night": "Dubai, UAE"
}
sizes = {
    "sonoma_horizon": "~45MB",
    "yosemite": "~50MB",
    "patagonia": "~65MB",
    "greenland": "~40MB",
    "grand_canyon": "~55MB",
    "dubai_night": "~60MB"
}

thumbnails = {
    "sonoma_horizon": "Sonoma-dark.jpg",
    "yosemite": "Ventura-dark.jpg",
    "patagonia": "Monterey-dark.jpg",
    "greenland": "WhiteSur-dark.jpg",
    "grand_canyon": "redsand-default.jpg",
    "dubai_night": "linux-wp14.jpg"
}

urls = {
    "sonoma_horizon": "https://www.youtube.com/watch?v=QOLTfZPp3Xs",
    "yosemite": "https://www.youtube.com/watch?v=5BNnG_GxYVw",
    "patagonia": "https://www.youtube.com/watch?v=TAgg3QptRtQ",
    "greenland": "https://www.youtube.com/watch?v=Pe9rMYYcv5E",
    "grand_canyon": "https://www.youtube.com/watch?v=5yZuaAQKnkY",
    "dubai_night": "https://www.youtube.com/watch?v=K11iIAx3Uhc"
}

screensaver_dir = os.path.expanduser("~/.local/share/omarchy-undercover/screensavers")
items = []
for cid in catalog_ids:
    target_file = os.path.join(screensaver_dir, f"{cid}.mp4")
    installed = os.path.isfile(target_file)
    items.append({
        "id": cid,
        "name": names[cid],
        "location": locations[cid],
        "res": "1080p",
        "size": sizes[cid],
        "source": "YouTube (1080p)",
        "url": urls[cid],
        "thumbnail": thumbnails.get(cid, "macOS-Tahoe-Dark.jpg"),
        "installed": installed,
        "path": target_file if installed else ""
    })
print(json.dumps(items))
')"

    jq -n \
        --argjson enabled "$([[ "$enabled" == "true" ]] && echo true || echo false)" \
        --argjson timeout "$timeout" \
        --arg active_clip "$active_clip" \
        --argjson installed "$installed_json" \
        --argjson catalog "$catalog_json" \
        '{
            enabled: $enabled,
            timeout: $timeout,
            active_clip: $active_clip,
            installed_clips: $installed,
            catalog: $catalog
        }'
}

list_clips() {
    echo "=== Available Aerial Screensaver Catalog (YouTube / High-Def) ==="
    for cid in "sonoma_horizon" "yosemite" "patagonia" "greenland" "grand_canyon" "dubai_night"; do
        local target="$SCREENSAVER_DIR/${cid}.mp4"
        local status="[Available on YouTube]"
        if [[ -f "$target" ]]; then
            status="[Installed: $target]"
        fi
        echo "  - ${cid}: ${CATALOG_NAMES[$cid]} (${CATALOG_LOCATIONS[$cid]}, ${CATALOG_SIZES[$cid]}) $status"
    done
    echo ""
    echo "=== Local Screensaver Files in $SCREENSAVER_DIR ==="
    find "$SCREENSAVER_DIR" -maxdepth 1 -type f \( -name "*.mp4" -o -name "*.webm" \) 2>/dev/null || echo "  (None found yet)"
}

download_clip() {
    local target_arg="$1"
    local url=""
    local cid=""
    local title=""

    if [[ "$target_arg" =~ ^https?:// ]] || [[ "$target_arg" =~ (youtube\.com|youtu\.be) ]]; then
        url="$target_arg"
        cid="web_$(date +%s)"
        title="Custom Web Video"
    elif [[ -n "${CATALOG_URLS[$target_arg]:-}" ]]; then
        cid="$target_arg"
        url="${CATALOG_URLS[$cid]}"
        title="${CATALOG_NAMES[$cid]}"
    else
        echo "Error: Unknown catalog clip ID or invalid URL '$target_arg'." >&2
        echo "Run '$0 --list' to see available presets, or specify a YouTube / direct video URL." >&2
        exit 1
    fi

    local target="$SCREENSAVER_DIR/${cid}.mp4"
    local part="$SCREENSAVER_DIR/${cid}.part"
    rm -f "$part"

    echo "Downloading ${title}..."
    echo "Source: $url"
    echo "Destination: $target"

    local success=false

    # Direct mp4/webm link: try curl with -k (insecure) to ignore cert chain issues
    if [[ "$url" =~ \.(mp4|webm)($|\?) ]] && command -v curl &>/dev/null; then
        echo "Attempting direct download via curl..."
        if curl -k -L --fail --progress-bar --max-time 600 -o "$part" "$url"; then
            if [[ -f "$part" && -s "$part" ]]; then
                mv -f "$part" "$target"
                success=true
            fi
        fi
    fi

    # YouTube or video platforms: use yt-dlp with mp4 muxing
    if [[ "$success" == "false" ]] && command -v yt-dlp &>/dev/null; then
        echo "Downloading video stream via yt-dlp..."
        if yt-dlp --no-playlist \
                  -f "bv*[height<=1080]+ba/b[height<=1080]/b" \
                  --merge-output-format mp4 \
                  -o "${target}.part.%(ext)s" \
                  "$url"; then
            local ytdl_file
            ytdl_file="$(ls "${target}.part."* 2>/dev/null | head -n1 || true)"
            if [[ -n "$ytdl_file" && -f "$ytdl_file" ]]; then
                mv -f "$ytdl_file" "$target"
                success=true
            fi
        elif yt-dlp --no-playlist -f "b" -o "${target}.part.%(ext)s" "$url"; then
            local ytdl_file
            ytdl_file="$(ls "${target}.part."* 2>/dev/null | head -n1 || true)"
            if [[ -n "$ytdl_file" && -f "$ytdl_file" ]]; then
                mv -f "$ytdl_file" "$target"
                success=true
            fi
        fi
    fi

    # Fallback to curl with -k if yt-dlp is not present or failed
    if [[ "$success" == "false" ]] && command -v curl &>/dev/null; then
        echo "Falling back to curl..."
        if curl -k -L --fail --progress-bar --max-time 600 -o "$part" "$url"; then
            if [[ -f "$part" && -s "$part" ]]; then
                mv -f "$part" "$target"
                success=true
            fi
        fi
    fi

    if [[ "$success" == "true" && -f "$target" && -s "$target" ]]; then
        echo "Successfully downloaded ${title}!"
        write_setting "SCREENSAVER_VIDEO" "$target"
        echo "Set as active screensaver: $target"
        notify_quickshell
    else
        rm -f "$part" "${target}.part."*
        echo "Error: Failed to download video from '$url'." >&2
        exit 1
    fi
}

set_clip() {
    local target="$1"
    if [[ -n "${CATALOG_URLS[$target]:-}" ]]; then
        target="$SCREENSAVER_DIR/${target}.mp4"
    fi

    if [[ ! -f "$target" ]]; then
        echo "Error: Video file '$target' does not exist." >&2
        exit 1
    fi

    write_setting "SCREENSAVER_VIDEO" "$target"
    echo "Active screensaver set to: $target"
    notify_quickshell
}

set_timeout() {
    local t="$1"
    if ! [[ "$t" =~ ^[0-9]+$ ]]; then
        echo "Error: Timeout must be an integer (seconds)." >&2
        exit 1
    fi
    write_setting "SCREENSAVER_TIMEOUT" "$t"
    echo "Screensaver timeout set to: ${t}s"
    notify_quickshell
}

set_toggle() {
    local val="$1"
    case "$val" in
        on|true|1|enable)
            write_setting "SCREENSAVER_ENABLED" "true"
            echo "Screensaver enabled"
            ;;
        off|false|0|disable)
            write_setting "SCREENSAVER_ENABLED" "false"
            echo "Screensaver disabled"
            ;;
        *)
            echo "Error: Invalid toggle value '$val'. Use 'on' or 'off'." >&2
            exit 1
            ;;
    esac
    notify_quickshell
}

# CLI Argument parsing
if [[ $# -eq 0 ]]; then
    get_status_json
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --status)
            get_status_json
            exit 0
            ;;
        --list)
            list_clips
            exit 0
            ;;
        --set)
            shift
            if [[ $# -eq 0 ]]; then echo "Error: Missing argument for --set" >&2; exit 1; fi
            set_clip "$1"
            exit 0
            ;;
        --timeout)
            shift
            if [[ $# -eq 0 ]]; then echo "Error: Missing argument for --timeout" >&2; exit 1; fi
            set_timeout "$1"
            exit 0
            ;;
        --toggle)
            shift
            if [[ $# -eq 0 ]]; then echo "Error: Missing argument for --toggle" >&2; exit 1; fi
            set_toggle "$1"
            exit 0
            ;;
        --download)
            shift
            if [[ $# -eq 0 ]]; then echo "Error: Missing clip ID for --download" >&2; exit 1; fi
            download_clip "$1"
            exit 0
            ;;
        --preview)
            dispatch_preview
            exit 0
            ;;
        --dismiss)
            dispatch_dismiss
            exit 0
            ;;
        -h|--help)
            echo "Usage: omarchy-mac-screensaver [OPTIONS]"
            echo "Options:"
            echo "  --status               Print JSON status object"
            echo "  --list                 List aerial preset catalog and local installed videos"
            echo "  --download <id_or_url> Download a preset aerial clip or any YouTube / video URL"
            echo "  --set <path_or_id>     Set active screensaver video"
            echo "  --timeout <seconds>    Set idle timeout threshold"
            echo "  --toggle <on|off>      Enable or disable screensaver"
            echo "  --preview              Trigger fullscreen screensaver preview test"
            echo "  --dismiss              Dismiss active screensaver overlay"
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
    esac
done
