#!/usr/bin/env bash
# =============================================================================
# 🍏 macOS Sequoia Native Quickshell Bluetooth Dispatcher
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SCRIPT_DIR}/../manifest.json" ]]; then
    PLUGIN_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
elif [[ -d "$HOME/.config/omarchy/plugins/omarchy-undercover" ]]; then
    PLUGIN_DIR="$HOME/.config/omarchy/plugins/omarchy-undercover"
elif [[ -d "$HOME/.config/omarchy/plugins/undercover" ]]; then
    PLUGIN_DIR="$HOME/.config/omarchy/plugins/undercover"
else
    PLUGIN_DIR="$HOME/.config/omarchy/plugins/omarchy-undercover"
fi
CONFIG_DIR="$PLUGIN_DIR"

QS_SRC=""
for cand in \
    "$CONFIG_DIR/configs/quickshell/mac-bluetooth" \
    "$CONFIG_DIR/quickshell/mac-bluetooth" \
    "${SCRIPT_DIR}/../configs/quickshell/mac-bluetooth" \
    "${SCRIPT_DIR}/configs/quickshell/mac-bluetooth"; do
    if [[ -d "$cand" ]]; then
        QS_SRC="$cand"
        break
    fi
done

if pgrep -f "quickshell.*mac-bluetooth" >/dev/null; then
    pkill -f "quickshell.*mac-bluetooth"
    exit 0
fi

if command -v quickshell >/dev/null 2>&1 && [[ -d "$QS_SRC" ]]; then
    exec quickshell -p "$QS_SRC"
else
    exec blueman-manager
fi
