#!/usr/bin/env bash
# ==============================================================================
# Copyright (C) 2026 misternegative21
# Omarchy Undercover - Wallpaper Manager (Tahoe, Sequoia & Windows 11)
# License: GPL-3.0-or-later
#
# omarchy:summary=Apply wallpaper for macOS Tahoe, Sequoia, or Windows 11 modes
# omarchy:args=[-s|--set <preset|path>]
# omarchy:examples=omarchy-undercover-wallpaper -s macOS-Tahoe-Dark.jpg
# ==============================================================================

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SCRIPT_DIR}/../manifest.json" ]]; then
    PLUGIN_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
elif [[ -d "$HOME/.config/omarchy/plugins/omarchy-undercover" ]]; then
    PLUGIN_DIR="$HOME/.config/omarchy/plugins/omarchy-undercover"
elif [[ -d "$HOME/.config/omarchy/plugins/undercover" ]]; then
    PLUGIN_DIR="$HOME/.config/omarchy/plugins/undercover"
else
    PLUGIN_DIR="$HOME/.config/omarchy/plugins/omarchy-undercover"
fi

CONFIG_DIR="$PLUGIN_DIR"
SETTINGS_FILE="$CONFIG_DIR/settings.conf"

WP_SEARCH_DIRS=(
    "$CONFIG_DIR/assets/wallpapers"
    "$CONFIG_DIR/wallpapers"
    "${SCRIPT_DIR}/../assets/wallpapers"
    "$HOME/.config/omarchy/themes/macos-dark/backgrounds"
    "$HOME/.config/omarchy/themes/macos-light/backgrounds"
    "$HOME/.config/omarchy/themes/windows11-dark/backgrounds"
    "/usr/share/omarchy-undercover/assets/wallpapers"
)

get_setting() {
    local key="$1" default="$2"
    local value="$default"
    if [[ -f "$SETTINGS_FILE" ]]; then
        value=$(grep -E "^${key}=" "$SETTINGS_FILE" 2>/dev/null | cut -d= -f2- | tail -1 || true)
        [[ -z "$value" ]] && value="$default"
    fi
    printf '%s' "$value"
}

write_setting() {
    local key="$1" value="$2"
    mkdir -p "$(dirname "$SETTINGS_FILE")"
    if [[ -f "$SETTINGS_FILE" ]]; then
        if grep -qE "^${key}=" "$SETTINGS_FILE" 2>/dev/null; then
            sed -i "s|^${key}=.*|${key}=${value}|" "$SETTINGS_FILE"
        else
            printf '%s=%s\n' "$key" "$value" >> "$SETTINGS_FILE"
        fi
    else
        printf '%s=%s\n' "$key" "$value" > "$SETTINGS_FILE"
    fi
}

requested=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -s|--set|--file)
            requested="${2:-}"
            shift 2 2>/dev/null || shift 1
            ;;
        *)
            requested="$1"
            shift
            ;;
    esac
done

if [[ -z "$requested" ]]; then
    requested=$(get_setting "WALLPAPER" "macOS-Tahoe-Dark.jpg")
fi

# Strip surrounding single or double quotes
requested="${requested#\'}"
requested="${requested%\'}"
requested="${requested#\"}"
requested="${requested%\"}"

wp_file=""
if [[ -f "$requested" ]]; then
    wp_file="$(readlink -f "$requested")"
else
    for dir in "${WP_SEARCH_DIRS[@]}"; do
        if [[ -d "$dir" ]]; then
            if [[ -f "$dir/$requested" ]]; then
                wp_file="$dir/$requested"
                break
            elif [[ -f "$dir/${requested}.jpg" ]]; then
                wp_file="$dir/${requested}.jpg"
                break
            elif [[ -f "$dir/${requested}.png" ]]; then
                wp_file="$dir/${requested}.png"
                break
            fi
        fi
    done
fi

if [[ -z "$wp_file" ]]; then
    # Fallback cascade: Tahoe Dark -> Bloom Dark -> Sequoia Dark
    for fallback in "macOS-Tahoe-Dark.jpg" "win11_bloom_dark.jpg" "macOS-Sequoia-Dark.jpg"; do
        for dir in "${WP_SEARCH_DIRS[@]}"; do
            if [[ -f "$dir/$fallback" ]]; then
                wp_file="$dir/$fallback"
                break 2
            fi
        done
    done
fi

if [[ -z "$wp_file" || ! -f "$wp_file" ]]; then
    echo "omarchy-undercover-wallpaper: no wallpaper found for '$requested'" >&2
    exit 1
fi

write_setting "WALLPAPER" "$(basename "$wp_file")"

# 1. Update Omarchy Shell Background Symlink & IPC
if [[ -d "$HOME/.local/state/omarchy" ]]; then
    mkdir -p "$HOME/.local/state/omarchy/current"
    ln -nsf "$wp_file" "$HOME/.local/state/omarchy/current/background" 2>/dev/null || true
fi

# Update theme background state if in mac mode
current_mode=$(get_setting "MODE" "mac")
if [[ "$current_mode" == "mac"* ]]; then
    mkdir -p "$HOME/.local/state/omarchy/theme-backgrounds"
    echo "$wp_file" > "$HOME/.local/state/omarchy/theme-backgrounds/macos-dark" 2>/dev/null || true
    echo "$wp_file" > "$HOME/.local/state/omarchy/theme-backgrounds/macos-light" 2>/dev/null || true
fi

if command -v omarchy-shell >/dev/null 2>&1; then
    omarchy-shell shell background prepare "$wp_file" 2>/dev/null || true
    omarchy-shell shell background apply "$wp_file" 2>/dev/null || true
fi

# 2. Update Swaybg
pkill -x swaybg 2>/dev/null || true
if command -v swaybg >/dev/null 2>&1; then
    setsid swaybg -i "$wp_file" -m fill >/dev/null 2>&1 &
fi

# 3. Update Hyprpaper if active
if pgrep -x hyprpaper >/dev/null 2>&1 && command -v hyprctl >/dev/null 2>&1; then
    hyprctl hyprpaper preload "$wp_file" 2>/dev/null || true
    hyprctl hyprpaper wallpaper ",$wp_file" 2>/dev/null || true
fi

# 4. Update SWWW if active
if pgrep -x swww-daemon >/dev/null 2>&1 && command -v swww >/dev/null 2>&1; then
    swww img "$wp_file" --transition-type fade --transition-duration 1 2>/dev/null || true
fi

echo "Wallpaper applied: $wp_file"
