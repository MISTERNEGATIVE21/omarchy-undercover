}
.action-pill:hover {
    background-color: rgba(255, 255, 255, 0.20);
}

.stock-pill-up {
    background-color: rgba(48, 209, 88, 0.18);
    color: #30d158;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11.5px;
    font-weight: 700;
}

.stock-pill-down {
    background-color: rgba(255, 69, 58, 0.18);
    color: #ff453a;
