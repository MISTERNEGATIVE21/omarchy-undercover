#!/usr/bin/env bash
# =============================================================================
# 🍏 macOS Sequoia Native Quickshell Notification Center & Widgets Dispatcher
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$HOME/.config/omarchy-undercover"

QS_SRC=""
for cand in \
    "$CONFIG_DIR/quickshell/mac-widgets" \
    "$CONFIG_DIR/configs/quickshell/mac-widgets" \
    "${SCRIPT_DIR}/../quickshell/mac-widgets" \
    "${SCRIPT_DIR}/../configs/quickshell/mac-widgets" \
    "${SCRIPT_DIR}/quickshell/mac-widgets" \
    "${SCRIPT_DIR}/configs/quickshell/mac-widgets"; do
    if [[ -d "$cand" ]]; then
        QS_SRC="$cand"
        break
    fi
done

# Toggle logic: if running, kill it; if not, launch it
if pgrep -f "quickshell.*mac-widgets" >/dev/null; then
    pkill -f "quickshell.*mac-widgets"
    exit 0
fi

if command -v quickshell >/dev/null 2>&1 && [[ -d "$QS_SRC" ]]; then
    exec quickshell -p "$QS_SRC"
else
    exec python3 "${SCRIPT_DIR}/omarchy-mac-widgets-gtk" "$@"
fi
