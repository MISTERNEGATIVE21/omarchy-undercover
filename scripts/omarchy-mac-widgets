class MacWidgetsWindow(Gtk.Window):
    def __init__(self, app):
        super().__init__(application=app, title="macOS Notification Center")
        self.set_default_size(440, 860)
        self.set_resizable(True)
        self.add_css_class("mac-widgets")

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.cfg = load_config()

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.set_child(scroll)

        self.main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.main_box.set_margin_top(16)
        self.main_box.set_margin_bottom(16)
        self.main_box.set_margin_start(16)
        self.main_box.set_margin_end(16)
        scroll.set_child(self.main_box)

        self.build_ui()
        GLib.timeout_add_seconds(2, self.refresh_vitals)

        # Key controller
        key_ctrl = Gtk.EventControllerKey()
        key_ctrl.connect("key-pressed", self.on_key_press)
        self.add_controller(key_ctrl)

    def on_key_press(self, controller, keyval, keycode, state):
        if keyval == 65307: # Escape
            self.close()
            return True
        return False

    def build_ui(self):
        while child := self.main_box.get_first_child():
            self.main_box.remove(child)

        # Top Header Bar
        now = datetime.datetime.now()
        date_str = now.strftime("%A, %B %d")

        hdr_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        hdr_box.set_margin_bottom(14)
        
        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        hdr_lbl = Gtk.Label(label="Widgets", xalign=0)
        hdr_lbl.add_css_class("stat-value")
        sub_lbl = Gtk.Label(label=date_str, xalign=0)
        sub_lbl.add_css_class("stat-sub")
        info.append(hdr_lbl)
        info.append(sub_lbl)
        info.set_hexpand(True)
        hdr_box.append(info)

        btn_edit = Gtk.Button(label="⚙️")
        btn_edit.add_css_class("action-pill")
        btn_edit.set_tooltip_text("Edit Widgets")
        btn_edit.connect("clicked", self.open_config_dialog)
        hdr_box.append(btn_edit)

        btn_close = Gtk.Button(label="✕")
        btn_close.add_css_class("action-pill")
        btn_close.connect("clicked", lambda b: self.close())
        hdr_box.append(btn_close)

        self.main_box.append(hdr_box)

        # 1. Weather 2x2 Card with Hourly Forecast
        if self.cfg.get("show_weather", True):
            self.main_box.append(self.create_weather_card())

        # 2. Apple Stocks Watchlist Card
        if self.cfg.get("show_stocks", True):
            self.main_box.append(self.create_stocks_card())

        # 3. Multi-Device Battery Widget
        if self.cfg.get("show_multibattery", True):
            self.main_box.append(self.create_multibattery_card())

        # 4. Screen Time Analytics Card
        if self.cfg.get("show_screentime", True):
            self.main_box.append(self.create_screentime_card())

        # 5. World Clock Widget
        if self.cfg.get("show_worldclock", True):
            self.main_box.append(self.create_worldclock_card())

        # 6. Apple Reminders & Calendar Checklist
        if self.cfg.get("show_reminders", True):
            self.main_box.append(self.create_reminders_card())

        # 7. Now Playing Media Player Card
        if self.cfg.get("show_media", True):
            self.main_box.append(self.create_media_card())

        # 8. Connectivity & Wireless (Wi-Fi + Bluetooth)
        if self.cfg.get("show_connectivity", True):
            self.main_box.append(self.create_connectivity_card())

        # 9. Sound Output & Volume
        if self.cfg.get("show_sound", True):
            self.main_box.append(self.create_sound_card())

        # 10. System Activity & Performance
        if self.cfg.get("show_system", True):
            self.main_box.append(self.create_system_card())

    # ==================== CARD CONSTRUCTORS ====================

    def create_weather_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.add_css_class("widget-card")

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        city = self.cfg.get("weather_city", "Cupertino")
        t_lbl = Gtk.Label(label=f"WEATHER • {city.upper()}", xalign=0)
        t_lbl.add_css_class("widget-title")
        t_lbl.set_hexpand(True)
        top.append(t_lbl)
        card.append(top)

        mid = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        lbl_temp = Gtk.Label(label="72°", xalign=0)
        lbl_temp.set_markup("<span size='xx-large' weight='heavy' color='#ffffff'>72°</span>")
        mid.append(lbl_temp)

        detail = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        lbl_c = Gtk.Label(label="Sunny", xalign=0)
        lbl_c.set_markup("<b>Sunny</b>")
        lbl_hl = Gtk.Label(label="H: 76°  L: 58° • 0% Rain", xalign=0)
        lbl_hl.add_css_class("stat-sub")
        detail.append(lbl_c)
        detail.append(lbl_hl)
        mid.append(detail)
        card.append(mid)

        # 5-Hour Forecast Pills
        h_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        h_box.set_homogeneous(True)
        hours = [("Now", "☀️", "72°"), ("4 PM", "☀️", "75°"), ("5 PM", "🌤️", "73°"), ("6 PM", "⛅", "69°"), ("7 PM", "🌙", "64°")]
        for h, icon, t in hours:
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            col.add_css_class("hour-pill")
            lbl_h = Gtk.Label(label=h)
            lbl_h.add_css_class("stat-sub")
            lbl_i = Gtk.Label(label=icon)
            lbl_t = Gtk.Label(label=t)
            lbl_t.set_markup(f"<b>{t}</b>")
            col.append(lbl_h)
            col.append(lbl_i)
            col.append(lbl_t)
            h_box.append(col)
        card.append(h_box)
        return card

    def create_stocks_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.add_css_class("widget-card")

        t_lbl = Gtk.Label(label="STOCKS • WATCHLIST", xalign=0)
        t_lbl.add_css_class("widget-title")
        card.append(t_lbl)

        stocks = [
            ("AAPL", "Apple Inc.", "$234.15", "+2.14%", True),
            ("NVDA", "NVIDIA Corp.", "$128.50", "+3.42%", True),
            ("MSFT", "Microsoft Corp.", "$448.20", "+1.18%", True),
            ("S&P 500", "S&P 500 Index", "5,620.8", "+0.85%", True),
            ("TSLA", "Tesla Inc.", "$214.20", "-0.62%", False),
        ]

        for sym, name, price, chg, up in stocks:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            col_name = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            lbl_sym = Gtk.Label(label=sym, xalign=0)
            lbl_sym.set_markup(f"<b>{sym}</b>")
            lbl_n = Gtk.Label(label=name, xalign=0)
            lbl_n.add_css_class("stat-sub")
            col_name.append(lbl_sym)
            col_name.append(lbl_n)
            col_name.set_hexpand(True)

            lbl_p = Gtk.Label(label=price)
            lbl_p.set_markup(f"<b>{price}</b>")
            lbl_c = Gtk.Label(label=chg)
            lbl_c.add_css_class("stock-pill-up" if up else "stock-pill-down")

            row.append(col_name)
            row.append(lbl_p)
            row.append(lbl_c)
            card.append(row)
        return card

    def create_multibattery_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.add_css_class("widget-card")

        t_lbl = Gtk.Label(label="BATTERIES • CONNECTED DEVICES", xalign=0)
        t_lbl.add_css_class("widget-title")
        card.append(t_lbl)

        grid = Gtk.Grid()
        grid.set_column_spacing(10)
        grid.set_row_spacing(10)
        grid.set_column_homogeneous(True)

        devices = [
            ("💻 MacBook Pro", "94%", 0.94, "#30d158"),
            ("🎧 AirPods Pro", "100%", 1.00, "#30d158"),
            ("🖱️ Magic Mouse", "85%", 0.85, "#30d158"),
            ("📱 iPhone 16 Pro", "92%", 0.92, "#30d158"),
        ]

        for i, (dev, pct_str, pct_val, col) in enumerate(devices):
            d_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            lbl_d = Gtk.Label(label=dev, xalign=0)
            lbl_d.add_css_class("stat-sub")
            lbl_p = Gtk.Label(label=pct_str, xalign=0)
            lbl_p.set_markup(f"<b>{pct_str}</b>")
            pb = Gtk.ProgressBar()
            pb.set_fraction(pct_val)
            d_box.append(lbl_d)
            d_box.append(lbl_p)
            d_box.append(pb)
            grid.attach(d_box, i % 2, i // 2, 1, 1)

        card.append(grid)
        return card

    def create_screentime_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.add_css_class("widget-card")

        t_lbl = Gtk.Label(label="SCREEN TIME • TODAY", xalign=0)
        t_lbl.add_css_class("widget-title")
        card.append(t_lbl)

        lbl_tot = Gtk.Label(label="4h 18m", xalign=0)
        lbl_tot.set_markup("<span size='large' weight='bold' color='#ffffff'>4h 18m</span>  <span color='#30d158'>▼ 12% vs last week</span>")
        card.append(lbl_tot)

        pb = Gtk.ProgressBar()
        pb.set_fraction(0.68)
        card.append(pb)

        cat_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        cat_box.set_homogeneous(True)
        cats = [("Productivity", "2h 10m", "#007aff"), ("Development", "1h 35m", "#af52de"), ("Social/Other", "33m", "#ff9500")]
        for c, t, col in cats:
            col_b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            lbl_c = Gtk.Label(label=c)
            lbl_c.add_css_class("stat-sub")
            lbl_t = Gtk.Label(label=t)
            lbl_t.set_markup(f"<span weight='bold' color='{col}'>{t}</span>")
            col_b.append(lbl_c)
            col_b.append(lbl_t)
            cat_box.append(col_b)
        card.append(cat_box)
        return card

    def create_worldclock_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.add_css_class("widget-card")

        t_lbl = Gtk.Label(label="WORLD CLOCK", xalign=0)
        t_lbl.add_css_class("widget-title")
        card.append(t_lbl)

        grid = Gtk.Grid()
        grid.set_column_spacing(10)
        grid.set_row_spacing(8)
        grid.set_column_homogeneous(True)

        now_utc = datetime.datetime.now(datetime.timezone.utc)
        clocks = [
            ("Cupertino", (now_utc - datetime.timedelta(hours=7)).strftime("%I:%M %p"), "-7HRS"),
            ("New York", (now_utc - datetime.timedelta(hours=4)).strftime("%I:%M %p"), "-4HRS"),
            ("London", (now_utc + datetime.timedelta(hours=1)).strftime("%I:%M %p"), "+1HR"),
            ("Tokyo", (now_utc + datetime.timedelta(hours=9)).strftime("%I:%M %p"), "+9HRS"),
        ]

        for i, (city, time_str, offset) in enumerate(clocks):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            lbl_c = Gtk.Label(label=city, xalign=0)
            lbl_c.add_css_class("stat-sub")
            lbl_t = Gtk.Label(label=time_str, xalign=0)
            lbl_t.set_markup(f"<b>{time_str}</b>")
            lbl_o = Gtk.Label(label=offset, xalign=0)
            lbl_o.add_css_class("stat-sub")
            box.append(lbl_c)
            box.append(lbl_t)
            box.append(lbl_o)
            grid.attach(box, i % 2, i // 2, 1, 1)

        card.append(grid)
        return card

    def create_reminders_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.add_css_class("widget-card")

        t_lbl = Gtk.Label(label="REMINDERS & CALENDAR", xalign=0)
        t_lbl.add_css_class("widget-title")
        card.append(t_lbl)

        reminders = [
            ("Design review with macOS architecture team", "Today, 10:30 AM", True),
            ("Deploy Omarchy Undercover v2.5 update", "Today, 3:00 PM", False),
            ("Review pull requests & Quickshell QML widgets", "Today, 5:30 PM", False),
        ]

        for text, time_sub, done in reminders:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            chk = Gtk.CheckButton()
            chk.set_active(done)
            tbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            lbl_t = Gtk.Label(label=text, xalign=0)
            lbl_t.set_markup(f"<s>{text}</s>" if done else f"<b>{text}</b>")
            lbl_s = Gtk.Label(label=time_sub, xalign=0)
            lbl_s.add_css_class("stat-sub")
            tbox.append(lbl_t)
            tbox.append(lbl_s)
            tbox.set_hexpand(True)
            row.append(chk)
            row.append(tbox)
            card.append(row)
        return card

    def create_connectivity_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.add_css_class("widget-card")

        t_lbl = Gtk.Label(label="CONNECTIVITY & WIRELESS", xalign=0)
        t_lbl.add_css_class("widget-title")
        card.append(t_lbl)

        # Wi-Fi Row
        wifi_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        wifi_icon = Gtk.Label()
        wifi_icon.set_markup('<span size="large" color="#007aff">󰤨</span>')

        active_ssid = "Connected"
        try:
            out = subprocess.check_output(["nmcli", "-t", "-f", "ACTIVE,SSID", "dev", "wifi"], text=True)
            for line in out.splitlines():
                if line.startswith("yes:"):
                    active_ssid = line.split(":", 1)[1]
                    break
        except Exception:
            pass

        self.lbl_wifi_ssid = Gtk.Label(label=f"Wi-Fi: {active_ssid}", xalign=0)
        self.lbl_wifi_ssid.set_hexpand(True)
        btn_wifi_mgt = Gtk.Button(label="Scan...")
        btn_wifi_mgt.add_css_class("action-pill")
        btn_wifi_mgt.connect("clicked", lambda b: subprocess.Popen(["omarchy-wifi-manager"]))

        wifi_row.append(wifi_icon)
        wifi_row.append(self.lbl_wifi_ssid)
        wifi_row.append(btn_wifi_mgt)
        card.append(wifi_row)

        # Bluetooth Row
        bt_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        bt_icon = Gtk.Label()
        bt_icon.set_markup('<span size="large" color="#af52de">󰂯</span>')

        bt_status = "Active"
        try:
            devs = subprocess.check_output(["bluetoothctl", "devices", "Connected"], text=True)
            if devs.strip():
                bt_status = devs.strip().split("\n")[0].split(" ", 2)[-1]
        except Exception:
            pass

        self.lbl_bt_stat = Gtk.Label(label=f"Bluetooth: {bt_status}", xalign=0)
        self.lbl_bt_stat.set_hexpand(True)
        btn_bt_mgt = Gtk.Button(label="Devices...")
        btn_bt_mgt.add_css_class("action-pill")
        btn_bt_mgt.connect("clicked", lambda b: subprocess.Popen(["omarchy-bluetooth-manager"]))

        bt_row.append(bt_icon)
        bt_row.append(self.lbl_bt_stat)
        bt_row.append(btn_bt_mgt)
        card.append(bt_row)
        return card

    def create_sound_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.add_css_class("widget-card")

        hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        t_lbl = Gtk.Label(label="SOUND & OUTPUT", xalign=0)
        t_lbl.add_css_class("widget-title")
        t_lbl.set_hexpand(True)
        btn_mixer = Gtk.Button(label="Mixer...")
        btn_mixer.add_css_class("action-pill")
        btn_mixer.connect("clicked", lambda b: subprocess.Popen(["pavucontrol"]))
        hdr.append(t_lbl)
        hdr.append(btn_mixer)
        card.append(hdr)

        curr_vol = 50
        try:
            out = subprocess.check_output(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], text=True)
            parts = out.strip().split()
            if len(parts) >= 2:
                curr_vol = int(float(parts[1]) * 100)
        except Exception:
            pass

        slider_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        ico = Gtk.Label()
        ico.set_markup('<span size="large" color="#ffffff">󰕾</span>')
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        scale.set_value(curr_vol)
        scale.set_hexpand(True)
        scale.connect("value-changed", lambda s: subprocess.run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{int(s.get_value())/100.0:.2f}"], check=False))
        slider_box.append(ico)
        slider_box.append(scale)
        card.append(slider_box)
        return card

    def create_system_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.add_css_class("widget-card")

        t_lbl = Gtk.Label(label="SYSTEM VITALS", xalign=0)
        t_lbl.add_css_class("widget-title")
        card.append(t_lbl)

        cpu_pct = psutil.cpu_percent(interval=None)
        self.cpu_lbl = Gtk.Label(label=f"CPU: {cpu_pct:.1f}%", xalign=0)
        self.cpu_bar = Gtk.ProgressBar()
        self.cpu_bar.set_fraction(cpu_pct / 100.0)

        mem = psutil.virtual_memory()
        self.ram_lbl = Gtk.Label(label=f"RAM: {mem.used / (1024**3):.1f} GB / {mem.total / (1024**3):.1f} GB ({mem.percent}%)", xalign=0)
        self.ram_bar = Gtk.ProgressBar()
        self.ram_bar.set_fraction(mem.percent / 100.0)

        disk = shutil.disk_usage("/")
        disk_pct = (disk.used / disk.total) * 100.0
        self.disk_lbl = Gtk.Label(label=f"SSD: {disk.free / (1024**3):.1f} GB free of {disk.total / (1024**3):.1f} GB", xalign=0)
        self.disk_bar = Gtk.ProgressBar()
        self.disk_bar.set_fraction(disk_pct / 100.0)

        card.append(self.cpu_lbl)
        card.append(self.cpu_bar)
        card.append(self.ram_lbl)
        card.append(self.ram_bar)
        card.append(self.disk_lbl)
        card.append(self.disk_bar)
        return card

    def create_media_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.add_css_class("widget-card")

        t_lbl = Gtk.Label(label="NOW PLAYING", xalign=0)
        t_lbl.add_css_class("widget-title")
        card.append(t_lbl)

        track = "Starboy"
        artist = "The Weeknd • Apple Music"
        try:
            out = subprocess.check_output(["playerctl", "metadata", "--format", "{{title}}|||{{artist}}"], text=True).strip()
            if "|||" in out:
                p = out.split("|||")
                track = p[0] or "Playing"
                artist = p[1] or "Media Player"
        except Exception:
            pass

        self.media_title = Gtk.Label(label=track, xalign=0)
        self.media_title.add_css_class("stat-value")
        self.media_title.set_ellipsize(Pango.EllipsizeMode.END)

        self.media_artist = Gtk.Label(label=artist, xalign=0)
        self.media_artist.add_css_class("stat-sub")

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        btn_box.set_halign(Gtk.Align.CENTER)
        btn_box.set_margin_top(6)

        btn_prev = Gtk.Button(label="󰒮")
        btn_prev.add_css_class("media-btn")
        btn_prev.connect("clicked", lambda b: subprocess.run(["playerctl", "previous"], check=False))

        btn_play = Gtk.Button(label="󰐊 / 󰏤")
        btn_play.add_css_class("media-btn")
        btn_play.connect("clicked", lambda b: subprocess.run(["playerctl", "play-pause"], check=False))

        btn_next = Gtk.Button(label="󰒭")
        btn_next.add_css_class("media-btn")
        btn_next.connect("clicked", lambda b: subprocess.run(["playerctl", "next"], check=False))

        btn_box.append(btn_prev)
        btn_box.append(btn_play)
        btn_box.append(btn_next)

        card.append(self.media_title)
        card.append(self.media_artist)
        card.append(btn_box)
        return card

    def refresh_vitals(self):
        try:
            if hasattr(self, "cpu_bar"):
                cpu = psutil.cpu_percent(interval=None)
                self.cpu_lbl.set_text(f"CPU: {cpu:.1f}%")
                self.cpu_bar.set_fraction(cpu / 100.0)

            if hasattr(self, "ram_bar"):
                mem = psutil.virtual_memory()
                self.ram_lbl.set_text(f"RAM: {mem.used / (1024**3):.1f} GB / {mem.total / (1024**3):.1f} GB ({mem.percent}%)")
                self.ram_bar.set_fraction(mem.percent / 100.0)
        except Exception:
            pass
        return True

    def open_config_dialog(self, btn):
        dialog = Adw.PreferencesWindow()
        dialog.set_title("Widget Configuration")
        dialog.set_transient_for(self)
        dialog.set_modal(True)
        dialog.set_default_size(380, 480)

        page = Adw.PreferencesPage()
        group_vis = Adw.PreferencesGroup(title="Active Widgets", description="Toggle visibility of desktop widgets")

        for key, title in [
            ("show_weather", "Weather & Satellite Geolocation"),
            ("show_stocks", "Apple Stocks Watchlist"),
            ("show_multibattery", "Multi-Device Battery Status"),
            ("show_screentime", "Screen Time Analytics"),
            ("show_worldclock", "World Clock Widget"),
            ("show_reminders", "Reminders & Calendar Checklist"),
            ("show_media", "Now Playing Media Player"),
            ("show_connectivity", "Wi-Fi & Bluetooth Connectivity"),
            ("show_sound", "Sound Output & Volume"),
            ("show_system", "System Vitals & Performance"),
        ]:
            sw = Adw.SwitchRow(title=title)
            sw.set_active(self.cfg.get(key, True))
            sw.connect("notify::active", lambda r, p, k=key: self.update_cfg_key(k, r.get_active()))
            group_vis.add(sw)

        page.add(group_vis)
        dialog.add(page)
        dialog.present()

    def update_cfg_key(self, key, val):
        self.cfg[key] = val
        save_config(self.cfg)
        self.build_ui()

class MacWidgetsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.omarchy.undercover.macwidgets", flags=Gio.ApplicationFlags.NON_UNIQUE)

    def do_activate(self):
        win = MacWidgetsWindow(self)
        win.present()

if __name__ == "__main__":
    app = MacWidgetsApp()
    sys.exit(app.run(sys.argv))
