#!/usr/bin/env python3
"""
macOS Sequoia Notification Center & Interactive Widgets Sidebar for Omarchy Hyprland
Authentic Apple macOS Sequoia Widgets Stack:
- Header with Date, Smart Stack & Quick Settings
- Weather 2x2 & Hourly Forecast Card (Cupertino / Local City, H/L, Rain %, 5-hour pill forecast)
- Apple Stocks Watchlist (AAPL, NVDA, MSFT, GOOGL, S&P 500) with trend indicators
- Multi-Device Battery Status (MacBook Pro 94%, AirPods Pro 100%, Magic Mouse 85%, iPhone 16 92%)
- Screen Time Analytics Card (Daily usage breakdown by Productivity, Dev, Social)
- World Clock Widget (Cupertino, New York, London, Tokyo)
- Apple Reminders & Calendar Checklist with interactive checkboxes
- Now Playing MPRIS Media Controller with progress & album info
- Connectivity (Wi-Fi 1-click scan, Bluetooth devices, Sound output sink)
- System Vitals (CPU %, Memory GB, SSD Storage free)
"""

import sys
import os
import subprocess
import time
import json
import psutil
import shutil
import datetime
from pathlib import Path

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw, Gio, GLib, Pango

CONFIG_DIR = Path.home() / ".config" / "omarchy-undercover"
WIDGETS_CONF = CONFIG_DIR / "mac_widgets.conf"

DEFAULT_CONFIG = {
    "show_weather": True,
    "show_stocks": True,
    "show_multibattery": True,
    "show_screentime": True,
    "show_worldclock": True,
    "show_reminders": True,
    "show_media": True,
    "show_connectivity": True,
    "show_sound": True,
    "show_system": True,
    "show_calendar": True,
    "weather_city": "Cupertino",
    "temp_unit": "F"
}

def load_config():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if WIDGETS_CONF.exists():
        try:
            return {**DEFAULT_CONFIG, **json.loads(WIDGETS_CONF.read_text())}
        except Exception:
            pass
    return DEFAULT_CONFIG.copy()

def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    WIDGETS_CONF.write_text(json.dumps(cfg, indent=2))

CSS = """
window.mac-widgets {
    background-color: rgba(22, 22, 30, 0.94);
    border-radius: 26px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: -12px 18px 45px rgba(0, 0, 0, 0.65);
}

.widget-card {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 14px 16px;
    margin-bottom: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all 0.2s ease;
}
.widget-card:hover {
    background-color: rgba(255, 255, 255, 0.11);
    border-color: rgba(255, 255, 255, 0.22);
}

.widget-title {
    font-size: 11px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    margin-bottom: 6px;
}

.stat-value {
    font-size: 20px;
    font-weight: 800;
    color: #ffffff;
}

.stat-sub {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.65);
