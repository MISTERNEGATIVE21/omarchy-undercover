#!/usr/bin/env python3
"""
High-Performance Intelligent Auto-Hide Daemon for Omarchy Undercover
Supports both macOS separate dock autohide and Windows 11 taskbar autohide.
"""
import subprocess
import time
import json
import sys
import os
import signal

CONFIG_DIR = os.path.expanduser("~/.config/omarchy-undercover")
STATE_FILE = os.path.join(CONFIG_DIR, "state")
SETTINGS_FILE = os.path.join(CONFIG_DIR, "settings.conf")

def get_effective_screen_height():
    try:
        out = subprocess.check_output(["hyprctl", "monitors", "-j"], text=True)
        data = json.loads(out)
        if data and len(data) > 0:
            h = data[0].get("height", 1440)
            scale = data[0].get("scale", 1.0)
            return int(h / scale)
    except Exception:
        pass
    return 900

def get_cursor_y():
    try:
        out = subprocess.check_output(["hyprctl", "cursorpos"], text=True)
        parts = out.strip().split(",")
        if len(parts) >= 2:
            return int(parts[1].strip())
    except Exception:
        pass
    return 0

def get_mode():
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "mac-dark"

def signal_dock_toggle():
    mode = get_mode()
    if "mac" in mode or "ios" in mode:
        # Signal specifically the dock process if split, otherwise all waybar
        res = subprocess.run(["pkill", "-SIGUSR1", "-f", "config-dock"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res.returncode != 0:
            subprocess.run(["killall", "-SIGUSR1", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        subprocess.run(["killall", "-SIGUSR1", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def is_dock_visible():
    # Helper to check if dock surface is active
    try:
        out = subprocess.check_output(["hyprctl", "layers"], text=True)
        return "mac-dock" in out or "win11-taskbar" in out or "waybar" in out
    except Exception:
        return True

def main():
    screen_h = get_effective_screen_height()
    trigger_y = screen_h - 20   # bottom 20px of the screen
    leave_y = screen_h - 85     # above dock area

    dock_visible = True
    away_start_time = None

    # Initial hide if starting in autohide mode
    # Let dock start visible, then hide after 2 seconds
    time.sleep(1.5)
    signal_dock_toggle()
    dock_visible = False

    while True:
        time.sleep(0.08)
        y = get_cursor_y()

        if y >= trigger_y:
            away_start_time = None
            if not dock_visible:
                signal_dock_toggle()
                dock_visible = True
        elif y < leave_y:
            if dock_visible:
                if away_start_time is None:
                    away_start_time = time.time()
                elif (time.time() - away_start_time) > 0.45: # 450ms delay before smooth autohide
                    signal_dock_toggle()
                    dock_visible = False
                    away_start_time = None
            else:
                away_start_time = None

if __name__ == "__main__":
    main()
