#!/usr/bin/env bash
# =============================================================================
# 🪟 Windows 11 Native Start Menu Dispatcher & Experience Controller
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SCRIPT_DIR}/../manifest.json" ]]; then
    PLUGIN_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
elif [[ -d "$HOME/.config/omarchy/plugins/omarchy-undercover" ]]; then
    PLUGIN_DIR="$HOME/.config/omarchy/plugins/omarchy-undercover"
elif [[ -d "$HOME/.config/omarchy/plugins/undercover" ]]; then
    PLUGIN_DIR="$HOME/.config/omarchy/plugins/undercover"
else
    PLUGIN_DIR="$HOME/.config/omarchy-undercover"
fi
CONFIG_DIR="$PLUGIN_DIR"

# 1. Toggle if already running
if pgrep -f "quickshell.*win11-start" >/dev/null; then
    pkill -f "quickshell.*win11-start"
    exit 0
fi

if pgrep -f "omarchy-win11-startmenu" >/dev/null; then
    pkill -f "omarchy-win11-startmenu"
    exit 0
fi

QS_SRC=""
for cand in \
    "$CONFIG_DIR/quickshell/win11-start" \
    "$CONFIG_DIR/configs/quickshell/win11-start" \
    "${SCRIPT_DIR}/../quickshell/win11-start" \
    "${SCRIPT_DIR}/../configs/quickshell/win11-start" \
    "${SCRIPT_DIR}/quickshell/win11-start" \
    "${SCRIPT_DIR}/configs/quickshell/win11-start"; do
    if [[ -d "$cand" ]]; then
        QS_SRC="$cand"
        break
    fi
done

# Ensure system applications catalog is indexed
if [[ ! -f "$CONFIG_DIR/apps.json" ]]; then
    if command -v omarchy-undercover-scan-apps >/dev/null 2>&1; then
        omarchy-undercover-scan-apps >/dev/null 2>&1 || true
    elif [[ -x "${SCRIPT_DIR}/omarchy-undercover-scan-apps" ]]; then
        "${SCRIPT_DIR}/omarchy-undercover-scan-apps" >/dev/null 2>&1 || true
    fi
fi

# Detect backend preference
BACKEND="auto"
if [[ -f "$CONFIG_DIR/settings.conf" ]]; then
    BACKEND=$(grep -E "^SHELL_BACKEND=" "$CONFIG_DIR/settings.conf" 2>/dev/null | tail -1 | cut -d= -f2- || echo "auto")
fi

if [[ "$BACKEND" != "waybar" ]] && command -v quickshell >/dev/null 2>&1 && [[ -d "$QS_SRC" ]]; then
    exec quickshell -p "$QS_SRC"
elif command -v omarchy-win11-startmenu >/dev/null 2>&1; then
    exec omarchy-win11-startmenu
elif [[ -f "${SCRIPT_DIR}/omarchy-win11-startmenu" ]]; then
    exec "${SCRIPT_DIR}/omarchy-win11-startmenu"
elif [[ -f "$HOME/.local/bin/omarchy-win11-startmenu" ]]; then
    exec "$HOME/.local/bin/omarchy-win11-startmenu"
else
    exec rofi -show drun -theme ~/.config/rofi/windows11.rasi
fi
