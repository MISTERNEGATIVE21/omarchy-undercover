#!/usr/bin/env bash
# =============================================================================
# 🍏 macOS Activity Monitor & Task Dispatcher
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export PATH="${SCRIPT_DIR}:${REAL_SCRIPT_DIR}:$HOME/.config/omarchy/plugins/omarchy-undercover/scripts:$PATH"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    echo "Usage: omarchy-mac-activitymonitor [--toggle]"
    echo "Launches or toggles the native macOS Tahoe / Sequoia Activity Monitor dashboard."
    exit 0
fi

PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-mac-activitymonitor.pid"

# 1. Instant toggle if already running
if [[ -f "$PID_FILE" ]]; then
    PID=$(cat "$PID_FILE" 2>/dev/null || true)
    if [[ -n "$PID" ]] && kill -0 "$PID" 2>/dev/null; then
        kill "$PID" 2>/dev/null || true
        rm -f "$PID_FILE"
        exit 0
    fi
    rm -f "$PID_FILE"
fi

if pgrep -f "quickshell.*mac-activitymonitor" >/dev/null 2>&1; then
    pkill -f "quickshell.*mac-activitymonitor" 2>/dev/null || true
    rm -f "$PID_FILE"
    exit 0
fi

# 2. Locate native Quickshell Activity Monitor dashboard
QS_SRC=""
for cand in \
    "${REAL_SCRIPT_DIR}/../configs/quickshell/mac-activitymonitor" \
    "${SCRIPT_DIR}/../configs/quickshell/mac-activitymonitor" \
    "$HOME/.config/omarchy/plugins/omarchy-undercover/configs/quickshell/mac-activitymonitor" \
    "$HOME/omarchy-undercover/configs/quickshell/mac-activitymonitor" \
    "/usr/share/omarchy-undercover/configs/quickshell/mac-activitymonitor"; do
    if [[ -d "$cand" && -f "$cand/shell.qml" ]]; then
        QS_SRC="$cand"
        break
    fi
done

# 3. Launch native Activity Monitor
if [[ -n "$QS_SRC" ]] && command -v quickshell >/dev/null 2>&1; then
    echo $$ > "$PID_FILE"
    exec quickshell -p "$QS_SRC"
else
    # Fallback to terminal system monitor
    if command -v btop >/dev/null 2>&1; then
        exec xdg-terminal-exec -e btop
    elif command -v htop >/dev/null 2>&1; then
        exec xdg-terminal-exec -e htop
    else
        notify-send "macOS Activity Monitor" "Could not locate Quickshell dashboard at $QS_SRC" -u low 2>/dev/null || true
        exit 1
    fi
fi
