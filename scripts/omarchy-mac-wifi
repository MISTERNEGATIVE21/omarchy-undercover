#!/usr/bin/env bash
# =============================================================================
# 🍏 macOS Sequoia Native Quickshell Wi-Fi Manager Dispatcher
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$HOME/.config/omarchy-undercover"

QS_SRC=""
for cand in \
    "$CONFIG_DIR/quickshell/mac-wifi" \
    "$CONFIG_DIR/configs/quickshell/mac-wifi" \
    "${SCRIPT_DIR}/../quickshell/mac-wifi" \
    "${SCRIPT_DIR}/../configs/quickshell/mac-wifi" \
    "${SCRIPT_DIR}/quickshell/mac-wifi" \
    "${SCRIPT_DIR}/configs/quickshell/mac-wifi"; do
    if [[ -d "$cand" ]]; then
        QS_SRC="$cand"
        break
    fi
done

if pgrep -f "quickshell.*mac-wifi" >/dev/null; then
    pkill -f "quickshell.*mac-wifi"
    exit 0
fi

if command -v quickshell >/dev/null 2>&1 && [[ -d "$QS_SRC" ]]; then
    exec quickshell -p "$QS_SRC"
else
    exec nm-connection-editor
fi
