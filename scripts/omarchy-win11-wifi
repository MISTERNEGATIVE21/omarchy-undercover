#!/usr/bin/env bash
# =============================================================================
# 🪟 Windows 11 Fluent Native Quickshell Wi-Fi Manager Dispatcher
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$HOME/.config/omarchy-undercover"

QS_SRC="$CONFIG_DIR/quickshell/win11-wifi"
if [[ ! -d "$QS_SRC" && -d "${SCRIPT_DIR}/../configs/quickshell/win11-wifi" ]]; then
    QS_SRC="${SCRIPT_DIR}/../configs/quickshell/win11-wifi"
fi

if pgrep -f "quickshell.*win11-wifi" >/dev/null; then
    pkill -f "quickshell.*win11-wifi"
    exit 0
fi

if command -v quickshell >/dev/null 2>&1 && [[ -d "$QS_SRC" ]]; then
    exec quickshell -p "$QS_SRC"
else
    exec nm-connection-editor
fi
