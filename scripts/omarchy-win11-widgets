#!/usr/bin/env bash
# =============================================================================
# 🪟 Windows 11 Native Quickshell Widgets Board Dispatcher
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$HOME/.config/omarchy-undercover"

QS_SRC="$CONFIG_DIR/quickshell/win11-widgets"
if [[ ! -d "$QS_SRC" && -d "${SCRIPT_DIR}/../configs/quickshell/win11-widgets" ]]; then
    QS_SRC="${SCRIPT_DIR}/../configs/quickshell/win11-widgets"
fi

# Toggle logic: if running, kill it; if not, launch it
if pgrep -f "quickshell.*win11-widgets" >/dev/null; then
    pkill -f "quickshell.*win11-widgets"
    exit 0
fi

if command -v quickshell >/dev/null 2>&1 && [[ -d "$QS_SRC" ]]; then
    exec quickshell -p "$QS_SRC"
else
    # Fallback to python GTK if quickshell isn't installed
    exec python3 "${SCRIPT_DIR}/omarchy-win11-widgets-gtk" "$@"
fi
