class SplashScreenWindow(Gtk.Window):
    """
    Evaporating Splash Screen:
    Disappears after 5 seconds with a smooth progress countdown unless user presses any key or clicks to open settings.
    """
    def __init__(self, app):
        super().__init__(application=app, title="Omarchy Undercover")
        self.app = app
        self.set_default_size(480, 360)
        self.set_resizable(False)
        self.add_css_class("undercover-splash")

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.remaining_ms = 5000
        self.cancelled = False

        # Key controller to capture any keypress
        key_ctrl = Gtk.EventControllerKey()
        key_ctrl.connect("key-pressed", self.on_any_key)
        self.add_controller(key_ctrl)

        # Click controller on main window
        click_ctrl = Gtk.GestureClick()
        click_ctrl.connect("pressed", self.on_window_click)
        self.add_controller(click_ctrl)

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        main_box.set_margin_top(24)
        main_box.set_margin_bottom(20)
        main_box.set_margin_start(24)
        main_box.set_margin_end(24)
        main_box.set_valign(Gtk.Align.CENTER)

        # 1. Centered Icon Emblem
        if ICON_PATH.exists():
            icon_img = Gtk.Image.new_from_file(str(ICON_PATH))
            icon_img.set_pixel_size(72)
            main_box.append(icon_img)

        # 2. Titles
        lbl_title = Gtk.Label(label="OMARCHY UNDERCOVER")
        lbl_title.add_css_class("splash-title")
        lbl_sub = Gtk.Label(label=f"Desktop Transformation Suite v{VERSION}")
        lbl_sub.add_css_class("splash-sub")
        main_box.append(lbl_title)
        main_box.append(lbl_sub)

        # 3. Active Mode Badge
        curr_state = read_state()
        state_names = {
            "mac-dark": "🍏 Apple macOS Sequoia (Dark)",
            "mac-light": "☀️ Apple macOS Sequoia (Light)",
            "win11-dark": "🪟 Windows 11 Fluent (Dark)",
            "win11-light": "🌅 Windows 11 Fluent (Light)",
        }
        badge_text = state_names.get(curr_state, f"Active: {curr_state.upper()}")
        lbl_badge = Gtk.Label(label=badge_text)
        lbl_badge.add_css_class("splash-badge")
        lbl_badge.set_halign(Gtk.Align.CENTER)
        main_box.append(lbl_badge)

        # 4. Action Buttons
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_box.set_halign(Gtk.Align.CENTER)
        btn_box.set_margin_top(6)

        btn_open = Gtk.Button(label="⚙️ Open Control Center")
        btn_open.add_css_class("splash-btn-primary")
        btn_open.connect("clicked", lambda b: self.open_full_settings())

        btn_toggle = Gtk.Button(label="🔄 Quick Toggle Mode")
        btn_toggle.add_css_class("splash-btn-secondary")
        btn_toggle.connect("clicked", self.on_quick_toggle)

        btn_box.append(btn_open)
        btn_box.append(btn_toggle)
        main_box.append(btn_box)

        # 5. Evaporating Countdown Progress Bar
        self.prog_bar = Gtk.ProgressBar()
        self.prog_bar.set_fraction(1.0)
        self.prog_bar.set_margin_top(8)

        self.lbl_timer = Gtk.Label(label="Auto-dismissing in 5s... Press any key or click to open")
        self.lbl_timer.add_css_class("splash-sub")

        main_box.append(self.prog_bar)
        main_box.append(self.lbl_timer)

        self.set_child(main_box)

        # Start 50ms tick timer
        GLib.timeout_add(50, self.on_timer_tick)

    def on_timer_tick(self):
        if self.cancelled:
            return False
        self.remaining_ms -= 50
        if self.remaining_ms <= 0:
            self.evaporate_and_close()
            return False

        fraction = max(0.0, self.remaining_ms / 5000.0)
        self.prog_bar.set_fraction(fraction)
        secs = int(self.remaining_ms / 1000) + 1
        self.lbl_timer.set_text(f"Auto-dismissing in {secs}s... Press any key or click to open")
        return True

    def on_any_key(self, ctrl, keyval, keycode, state):
        self.open_full_settings()
        return True

    def on_window_click(self, gesture, n_press, x, y):
        self.open_full_settings()

    def on_quick_toggle(self, btn):
        self.cancelled = True
        cli = find_cli()
        subprocess.run([cli, "--toggle"], check=False)
        self.open_full_settings()

    def open_full_settings(self):
        self.cancelled = True
        self.destroy()
        win = UndercoverAppWindow(self.app)
        win.present()

    def evaporate_and_close(self):
        self.cancelled = True
        self.destroy()
        self.app.quit()


class UndercoverAppWindow(Adw.ApplicationWindow):
    """
    Comprehensive Omarchy Undercover Control Center Window
    """
    def __init__(self, app):
        super().__init__(application=app, title=f"Omarchy Undercover v{VERSION}")
        self.set_default_size(960, 720)

        self.toast_overlay = Adw.ToastOverlay()
        self.set_content(self.toast_overlay)

        # View Stack & Switcher Header
        self.stack = Adw.ViewStack()

        # Build Tabs
        self.build_presets_page()
        self.build_dock_taskbar_page()
        self.build_wallpapers_page()
        self.build_effects_page()
        self.build_hardware_page()
        self.build_diagnostics_page()

        # Header Bar
        header = Adw.HeaderBar()
        title_widget = Adw.ViewSwitcherTitle()
        title_widget.set_stack(self.stack)
        title_widget.set_title(f"Omarchy Undercover v{VERSION}")
        header.set_title_widget(title_widget)

        # Main Layout
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        vbox.append(header)
        vbox.append(self.stack)
        self.toast_overlay.set_child(vbox)

    def show_toast(self, message):
        toast = Adw.Toast.new(message)
        toast.set_timeout(3)
        self.toast_overlay.add_toast(toast)

    def apply_preset(self, flag, name):
        cli = find_cli()
        try:
            subprocess.run([cli, flag], check=True)
            self.show_toast(f"Switched to {name} successfully!")
            self.refresh_all_states()
        except Exception as e:
            self.show_toast(f"Error applying preset: {e}")

    # ==================== PAGE 1: MODES & PRESETS ====================
    def build_presets_page(self):
        page = Adw.PreferencesPage()
        page.set_title("Modes & Presets")
        page.set_icon_name("preferences-desktop-display-symbolic")

        # Active Presets Group
        group_presets = Adw.PreferencesGroup(
            title="Desktop Camouflage Presets",
            description="Select an environment to transform taskbars, window decorations, icons, and fonts."
        )

        presets = [
            ("mac-dark", "-mac", "🍏 Apple macOS Sequoia (Dark)", "Frosted dark menu bar, dynamic auto-sizing dock, traffic lights & SF Pro fonts."),
            ("mac-light", "-mac-light", "☀️ Apple macOS Sequoia (Light)", "Solar light frosted glass theme with high-vibrancy dock."),
            ("win11-dark", "-w11", "🪟 Windows 11 Fluent (Dark)", "Centered Mica acrylic taskbar, Start menu, Action Center & Segoe UI fonts."),
            ("win11-light", "-w11-light", "🌅 Windows 11 Fluent (Light)", "Fluent Light taskbar, Bloom light background & bright Mica accents."),
        ]

        curr_state = read_state()

        for state_key, flag, title, desc in presets:
            row = Adw.ActionRow(title=title, subtitle=desc)
            btn = Gtk.Button(label="Apply Preset")
            if curr_state == state_key:
                btn.set_label("✔ Active")
                btn.set_sensitive(False)
                row.add_css_class("hero-active")
            btn.connect("clicked", lambda b, f=flag, t=title: self.apply_preset(f, t))
            row.add_suffix(btn)
            group_presets.add(row)

        page.add(group_presets)

        # Mode Cycling & Shortcuts
        group_cycle = Adw.PreferencesGroup(title="Quick Actions & Keybindings")
        
        row_toggle = Adw.ActionRow(
            title="Cycle Transformation Preset",
            subtitle="Shortcut: Super + Alt + U (cycles mac-dark ➔ mac-light ➔ win11-dark ➔ win11-light)"
        )
        btn_toggle = Gtk.Button(label="🔄 Cycle to Next Mode")
        btn_toggle.connect("clicked", lambda b: self.apply_preset("--toggle", "Next Mode"))
        row_toggle.add_suffix(btn_toggle)
        group_cycle.add(row_toggle)

        row_autohide = Adw.SwitchRow(
            title="Smart Edge Dock/Taskbar Auto-Hide",
            subtitle="HiDPI 1.6x calibrated cursor detection for bottom reveal and auto-dismiss"
        )
        autohide_enabled = read_setting("AUTOHIDE", "false").lower() == "true"
        row_autohide.set_active(autohide_enabled)
        row_autohide.connect("notify::active", self.on_autohide_toggled)
        group_cycle.add(row_autohide)

        page.add(group_cycle)
        self.stack.add_titled(page, "presets", "Presets")

    def on_autohide_toggled(self, row, param):
        is_active = row.get_active()
        write_setting("AUTOHIDE", "true" if is_active else "false")
        cli = find_cli()
        subprocess.run([cli, "--autohide", "on" if is_active else "off"], check=False)
        self.show_toast(f"Dock auto-hide {'enabled' if is_active else 'disabled'}")

    # ==================== PAGE: DOCK & TASKBAR ====================
    def build_dock_taskbar_page(self):
        page = Adw.PreferencesPage()
        page.set_title("Dock & Taskbar")
        page.set_icon_name("user-desktop-symbolic")

        # 1. macOS Sequoia Dock Preferences
        group_mac = Adw.PreferencesGroup(
            title="macOS Sequoia Dock Options",
            description="Customize floating dock magnification, size, position, and running apps."
        )

        # Show Mac Dock
        row_mac_dock = Adw.SwitchRow(title="Enable Floating macOS Dock", subtitle="Displays frosted glass application dock at the bottom of the screen")
        row_mac_dock.set_active(read_setting("ENABLE_MAC_DOCK", "true").lower() == "true")
        def on_mac_dock_toggled(row, param):
            write_setting("ENABLE_MAC_DOCK", "true" if row.get_active() else "false")
            if row.get_active():
                subprocess.Popen(["omarchy-mac-dock"])
            else:
                subprocess.run(["pkill", "-f", "omarchy-mac-dock"], check=False)
            self.show_toast("macOS Dock preference updated.")
        row_mac_dock.connect("notify::active", on_mac_dock_toggled)
        group_mac.add(row_mac_dock)

        # Dock Icon Size
        row_dock_size = Adw.ActionRow(title="Dock Icon Size", subtitle="Base pixel size for dock app icons")
        scale_size = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 32, 72, 4)
        scale_size.set_value(int(read_setting("DOCK_SIZE", "52")))
        scale_size.set_size_request(200, -1)
        def on_dock_size_changed(s):
            val = int(s.get_value())
            write_setting("DOCK_SIZE", str(val))
            self.show_toast(f"Dock icon size set to {val}px")
        scale_size.connect("value-changed", on_dock_size_changed)
        row_dock_size.add_suffix(scale_size)
        group_mac.add(row_dock_size)

        # Dock Magnification
        row_mag = Adw.ActionRow(title="Dock Hover Magnification Scale", subtitle="Parabolic scale multiplier on cursor hover")
        scale_mag = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1.0, 1.8, 0.05)
        scale_mag.set_value(float(read_setting("DOCK_MAGNIFICATION", "1.35")))
        scale_mag.set_size_request(200, -1)
        def on_mag_changed(s):
            val = f"{s.get_value():.2f}"
            write_setting("DOCK_MAGNIFICATION", val)
        scale_mag.connect("value-changed", on_mag_changed)
        row_mag.add_suffix(scale_mag)
        group_mac.add(row_mag)

        # Dock Opacity
        row_dock_op = Adw.ActionRow(title="Dock Background Opacity", subtitle="Transparency level of the floating dock container")
        scale_dock_op = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 30, 100, 1)
        scale_dock_op.set_value(int(float(read_setting("DOCK_OPACITY", "0.85")) * 100))
        scale_dock_op.set_size_request(200, -1)
        def on_dock_op_changed(s):
            val = s.get_value() / 100.0
            write_setting("DOCK_OPACITY", f"{val:.2f}")
            self.show_toast(f"Dock opacity set to {int(s.get_value())}%")
        scale_dock_op.connect("value-changed", on_dock_op_changed)
        row_dock_op.add_suffix(scale_dock_op)
        group_mac.add(row_dock_op)

        page.add(group_mac)

        # 2. Windows 11 Fluent Taskbar Preferences
        group_win = Adw.PreferencesGroup(
            title="Windows 11 Taskbar Options",
            description="Customize Start button alignment, search box, Copilot, and widgets."
        )

        # Taskbar Alignment (Centered vs Left)
        curr_align = read_setting("TASKBAR_ALIGNMENT", "center")
        row_align = Adw.ComboRow(title="Taskbar Start & Icons Alignment", subtitle="Choose between Windows 11 centered default or classic left-aligned")
        model_align = Gtk.StringList()
        model_align.append("Centered (Windows 11 Default)")
        model_align.append("Left-Aligned (Classic Windows)")
        row_align.set_model(model_align)
        row_align.set_selected(0 if curr_align == "center" else 1)

        def on_align_changed(combo, param):
            val = "center" if combo.get_selected() == 0 else "left"
            write_setting("TASKBAR_ALIGNMENT", val)
            cli = find_cli()
            subprocess.run([cli, "-w11"], check=False)
            self.show_toast(f"Taskbar alignment switched to: {val.capitalize()}")
        row_align.connect("notify::selected", on_align_changed)
        group_win.add(row_align)

        # Taskbar Opacity
        row_taskbar_op = Adw.ActionRow(title="Taskbar Opacity / Alpha", subtitle="Transparency level of the Windows 11 taskbar")
        scale_taskbar_op = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 30, 100, 1)
        scale_taskbar_op.set_value(int(float(read_setting("TASKBAR_OPACITY", "0.90")) * 100))
        scale_taskbar_op.set_size_request(200, -1)
        def on_taskbar_op_changed(s):
            val = s.get_value() / 100.0
            write_setting("TASKBAR_OPACITY", f"{val:.2f}")
            self.show_toast(f"Taskbar opacity set to {int(s.get_value())}%")
        scale_taskbar_op.connect("value-changed", on_taskbar_op_changed)
        row_taskbar_op.add_suffix(scale_taskbar_op)
        group_win.add(row_taskbar_op)

        # Search Mode
        curr_search = read_setting("SEARCH_MODE", "box")
        row_search_mode = Adw.ComboRow(title="Search on Taskbar", subtitle="Choose between full search box, search icon only, or hidden")
        model_search = Gtk.StringList()
        model_search.append("Search Box (Full Pill)")
        model_search.append("Search Icon Only")
        model_search.append("Hidden")
        row_search_mode.set_model(model_search)
        search_idx = 0 if curr_search == "box" else (1 if curr_search == "icon" else 2)
        row_search_mode.set_selected(search_idx)
        def on_search_mode_changed(combo, param):
            val = "box" if combo.get_selected() == 0 else ("icon" if combo.get_selected() == 1 else "hidden")
            write_setting("SEARCH_MODE", val)
            write_setting("SHOW_WIN_SEARCH", "false" if val == "hidden" else "true")
            cli = find_cli()
            subprocess.run([cli, "-w11"], check=False)
            self.show_toast(f"Search mode set to: {val.capitalize()}")
        row_search_mode.connect("notify::selected", on_search_mode_changed)
        group_win.add(row_search_mode)

        # Show Task View Button
        row_win_taskview = Adw.SwitchRow(title="Show Task View Button", subtitle="Displays virtual desktop & window switcher button next to search")
        row_win_taskview.set_active(read_setting("SHOW_WIN_TASKVIEW", "true").lower() == "true")
        row_win_taskview.connect("notify::active", lambda r, p: write_setting("SHOW_WIN_TASKVIEW", "true" if r.get_active() else "false"))
        group_win.add(row_win_taskview)

        # Show Copilot Button
        row_win_copilot = Adw.SwitchRow(title="Show Copilot AI Button", subtitle="Displays Copilot assistant icon next to search")
        row_win_copilot.set_active(read_setting("SHOW_WIN_COPILOT", "true").lower() == "true")
        row_win_copilot.connect("notify::active", lambda r, p: write_setting("SHOW_WIN_COPILOT", "true" if r.get_active() else "false"))
        group_win.add(row_win_copilot)

        # Show Weather Ticker on Taskbar
        row_win_weather = Adw.SwitchRow(title="Show Weather & Widgets Ticker", subtitle="Displays live temperature on bottom-left and opens Widgets Board on click")
        row_win_weather.set_active(read_setting("SHOW_WIN_WEATHER", "true").lower() == "true")
        row_win_weather.connect("notify::active", lambda r, p: write_setting("SHOW_WIN_WEATHER", "true" if r.get_active() else "false"))
        group_win.add(row_win_weather)

        # Automatically hide taskbar
        row_win_autohide = Adw.SwitchRow(title="Automatically Hide Taskbar", subtitle="Hides taskbar when not in use and reveals on bottom mouse edge contact")
        row_win_autohide.set_active(read_setting("AUTOHIDE", "false").lower() == "true")
        def on_autohide_toggled(r, p):
            val = r.get_active()
            write_setting("AUTOHIDE", "true" if val else "false")
            cli = find_cli()
            subprocess.run([cli, "--autohide", "on" if val else "off"], check=False)
            self.show_toast(f"Taskbar auto-hide {'enabled' if val else 'disabled'}")
        row_win_autohide.connect("notify::active", on_autohide_toggled)
        group_win.add(row_win_autohide)

        page.add(group_win)
        self.stack.add_titled(page, "dock_taskbar", "Dock & Taskbar")

    # ==================== PAGE 2: WALLPAPERS GALLERY ====================
    def build_wallpapers_page(self):
        page = Adw.PreferencesPage()
        page.set_title("Wallpapers")
        page.set_icon_name("preferences-desktop-wallpaper-symbolic")

        group = Adw.PreferencesGroup(
            title="6K & 4K Authentic Wallpapers",
            description="1-Click apply authentic Apple macOS, Windows 11, and iOS wallpapers."
        )

        for filename, label, category in WALLPAPERS:
            wp_path = WALLPAPER_DIR / filename
            row = Adw.ActionRow(title=label, subtitle=f"Resolution: {filename}")
            
            btn_apply = Gtk.Button(label="Apply Wallpaper")
            btn_apply.connect("clicked", lambda b, f=filename, l=label: self.apply_wallpaper(f, l))
            row.add_suffix(btn_apply)
            group.add(row)

        page.add(group)
        self.stack.add_titled(page, "wallpapers", "Wallpapers")

    def apply_wallpaper(self, filename, label):
        wp_path = WALLPAPER_DIR / filename
        if not wp_path.exists():
            self.show_toast(f"Wallpaper file {filename} not found.")
            return
        try:
            subprocess.run(["pkill", "swaybg"], check=False)
            subprocess.Popen(["swaybg", "-i", str(wp_path), "-m", "fill"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            write_setting("CUSTOM_WALLPAPER", str(wp_path))
            self.show_toast(f"Applied: {label}")
        except Exception as e:
            self.show_toast(f"Failed to apply wallpaper: {e}")

    # ==================== PAGE 3: GLASSMORPHISM & EFFECTS ====================
    def build_effects_page(self):
        page = Adw.PreferencesPage()
        page.set_title("Effects & Transparency")
        page.set_icon_name("applications-graphics-symbolic")

        # 1. Window Transparency & Opacity
        group_opacity = Adw.PreferencesGroup(
            title="Window Transparency & Opacity",
            description="Adjust active and background application transparency."
        )

        # Active Window Opacity
        row_active_op = Adw.ActionRow(title="Active Window Opacity", subtitle="Transparency level of focused application window")
        scale_active_op = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 50, 100, 1)
        curr_active = int(float(read_setting("ACTIVE_OPACITY", "0.95")) * 100)
        scale_active_op.set_value(curr_active)
        scale_active_op.set_size_request(200, -1)
        def on_active_op_changed(s):
            val = s.get_value() / 100.0
            write_setting("ACTIVE_OPACITY", f"{val:.2f}")
            subprocess.run(["hyprctl", "keyword", "decoration:active_opacity", f"{val:.2f}"], check=False)
        scale_active_op.connect("value-changed", on_active_op_changed)
        row_active_op.add_suffix(scale_active_op)
        group_opacity.add(row_active_op)

        # Inactive Window Opacity
        row_inact_op = Adw.ActionRow(title="Inactive Window Opacity", subtitle="Transparency level of background unfocused windows")
        scale_inact_op = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 50, 100, 1)
        curr_inact = int(float(read_setting("INACTIVE_OPACITY", "0.85")) * 100)
        scale_inact_op.set_value(curr_inact)
        scale_inact_op.set_size_request(200, -1)
        def on_inact_op_changed(s):
            val = s.get_value() / 100.0
            write_setting("INACTIVE_OPACITY", f"{val:.2f}")
            subprocess.run(["hyprctl", "keyword", "decoration:inactive_opacity", f"{val:.2f}"], check=False)
        scale_inact_op.connect("value-changed", on_inact_op_changed)
        row_inact_op.add_suffix(scale_inact_op)
        group_opacity.add(row_inact_op)

        # Bar Transparency Switch
        row_bar_trans = Adw.SwitchRow(title="Status Bar / Taskbar Transparency", subtitle="Toggles frosted glass translucent background for the taskbar / menu bar")
        bar_trans_val = read_setting("BAR_TRANSPARENT", "true").lower() == "true"
        row_bar_trans.set_active(bar_trans_val)
        def on_bar_trans_toggled(r, p):
            is_trans = r.get_active()
            write_setting("BAR_TRANSPARENT", "true" if is_trans else "false")
            # Update shell.json
            shell_json = Path.home() / ".config/omarchy/shell.json"
            if shell_json.exists():
                try:
                    data = json.loads(shell_json.read_text())
                    if "bar" in data:
                        data["bar"]["transparent"] = is_trans
                        shell_json.write_text(json.dumps(data, indent=2))
                except Exception:
                    pass
            cli = find_cli()
            subprocess.run([cli, "--reload"], check=False)
            self.show_toast(f"Bar transparency {'enabled' if is_trans else 'disabled'}")
        row_bar_trans.connect("notify::active", on_bar_trans_toggled)
        group_opacity.add(row_bar_trans)

        page.add(group_opacity)

        # 2. Glassmorphism & Blur Group
        group_blur = Adw.PreferencesGroup(
            title="Hyprland Glassmorphism & Aesthetics",
            description="Fine-tune window corner rounding, Mica blur radius, and shadow depth."
        )

        # Enable Blur Switch
        row_blur_en = Adw.SwitchRow(title="Enable Compositor Blur", subtitle="Applies multi-pass Gaussian blur behind transparent surfaces")
        blur_enabled = read_setting("BLUR_ENABLED", "true").lower() == "true"
        row_blur_en.set_active(blur_enabled)
        def on_blur_en_toggled(r, p):
            write_setting("BLUR_ENABLED", "true" if r.get_active() else "false")
            subprocess.run(["hyprctl", "keyword", "decoration:blur:enabled", "true" if r.get_active() else "false"], check=False)
        row_blur_en.connect("notify::active", on_blur_en_toggled)
        group_blur.add(row_blur_en)

        # Blur Size
        row_blur = Adw.ActionRow(title="Blur Size (Radius)", subtitle="Controls frosted glass blur dispersion")
        scale_blur = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 20, 1)
        scale_blur.set_value(int(read_setting("BLUR_SIZE", "10")))
        scale_blur.set_size_request(200, -1)
        scale_blur.connect("value-changed", lambda s: self.on_blur_changed(int(s.get_value())))
        row_blur.add_suffix(scale_blur)
        group_blur.add(row_blur)

        # Blur Passes
        row_passes = Adw.ActionRow(title="Blur Passes (Vibrancy)", subtitle="Number of blur filtration passes")
        scale_passes = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 5, 1)
        scale_passes.set_value(int(read_setting("BLUR_PASSES", "3")))
        scale_passes.set_size_request(200, -1)
        scale_passes.connect("value-changed", lambda s: self.on_passes_changed(int(s.get_value())))
        row_passes.add_suffix(scale_passes)
        group_blur.add(row_passes)

        # Window Rounding
        row_round = Adw.ActionRow(title="Window Corner Rounding", subtitle="Corner squircle radius for app windows")
        scale_round = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 24, 1)
        scale_round.set_value(int(read_setting("ROUNDING", "14")))
        scale_round.set_size_request(200, -1)
        scale_round.connect("value-changed", lambda s: self.on_rounding_changed(int(s.get_value())))
        row_round.add_suffix(scale_round)
        group_blur.add(row_round)

        page.add(group_blur)
        self.stack.add_titled(page, "effects", "Effects & Transparency")

    def on_blur_changed(self, val):
        write_setting("BLUR_SIZE", str(val))
        subprocess.run(["hyprctl", "keyword", "decoration:blur:size", str(val)], check=False)

    def on_passes_changed(self, val):
        write_setting("BLUR_PASSES", str(val))
        subprocess.run(["hyprctl", "keyword", "decoration:blur:passes", str(val)], check=False)

    def on_rounding_changed(self, val):
        write_setting("ROUNDING", str(val))
        subprocess.run(["hyprctl", "keyword", "decoration:rounding", str(val)], check=False)

    # ==================== PAGE 4: HARDWARE & RADIOS ====================
    def build_hardware_page(self):
        page = Adw.PreferencesPage()
        page.set_title("Hardware & Radios")
        page.set_icon_name("network-wireless-symbolic")

        group_radio = Adw.PreferencesGroup(title="Wireless & Radios", description="Real hardware network switches")

        # Wi-Fi
        row_wifi = Adw.SwitchRow(title="Wi-Fi Radio")
        wifi_on = False
        try:
            wifi_on = "enabled" in subprocess.check_output(["nmcli", "radio", "wifi"], text=True)
        except Exception:
            pass
        row_wifi.set_active(wifi_on)
        row_wifi.connect("notify::active", lambda r, p: subprocess.run(["nmcli", "radio", "wifi", "on" if r.get_active() else "off"], check=False))
        group_radio.add(row_wifi)

        # Bluetooth
        row_bt = Adw.SwitchRow(title="Bluetooth Power")
        bt_on = False
        try:
            bt_on = "Powered: yes" in subprocess.check_output(["bluetoothctl", "show"], text=True)
        except Exception:
            pass
        row_bt.set_active(bt_on)
        row_bt.connect("notify::active", lambda r, p: subprocess.run(["bluetoothctl", "power", "on" if r.get_active() else "off"], check=False))
        group_radio.add(row_bt)

        page.add(group_radio)

        # Display & Sound Sliders
        group_media = Adw.PreferencesGroup(title="Display & Audio Controls")

        row_vol = Adw.ActionRow(title="Master Audio Volume")
        scale_vol = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        scale_vol.set_value(50)
        scale_vol.set_size_request(200, -1)
        scale_vol.connect("value-changed", lambda s: subprocess.run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{int(s.get_value())/100.0:.2f}"], check=False))
        row_vol.add_suffix(scale_vol)
        group_media.add(row_vol)

        row_bri = Adw.ActionRow(title="Display Brightness")
        scale_bri = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 10, 100, 1)
        scale_bri.set_value(80)
        scale_bri.set_size_request(200, -1)
        scale_bri.connect("value-changed", lambda s: subprocess.run(["brightnessctl", "set", f"{int(s.get_value())}%"], check=False))
        row_bri.add_suffix(scale_bri)
        group_media.add(row_bri)

        page.add(group_media)
        self.stack.add_titled(page, "hardware", "Hardware")

    # ==================== PAGE 5: SYSTEM DIAGNOSTICS ====================
    def build_diagnostics_page(self):
        page = Adw.PreferencesPage()
        page.set_title("Diagnostics")
        page.set_icon_name("utilities-system-monitor-symbolic")

        group = Adw.PreferencesGroup(
            title="Desktop Shell & Protocol Integrity",
            description="Inspect active desktop status bar engine (Quickshell / Waybar), socket health, and configuration state."
        )

        # Backend Selector
        curr_backend = read_setting("SHELL_BACKEND", "auto")
        row_engine = Adw.ComboRow(title="Shell Engine Backend", subtitle="Select status bar architecture (Quickshell for Omarchy 4.0+, Waybar for legacy)")
        model = Gtk.StringList()
        model.append("Automatic Detection (Quickshell / Waybar)")
        model.append("Quickshell (Omarchy 4.0+ Native)")
        model.append("Waybar (Legacy)")
        row_engine.set_model(model)

        if curr_backend == "quickshell":
            row_engine.set_selected(1)
        elif curr_backend == "waybar":
            row_engine.set_selected(2)
        else:
            row_engine.set_selected(0)

        def on_engine_changed(combo, param):
            idx = combo.get_selected()
            val = "auto"
            if idx == 1:
                val = "quickshell"
            elif idx == 2:
                val = "waybar"
            write_setting("SHELL_BACKEND", val)
            cli = find_cli()
            subprocess.run([cli, "--backend", val], check=False)
            self.show_toast(f"Shell backend switched to: {val}")

        row_engine.connect("notify::selected", on_engine_changed)
        group.add(row_engine)

        row_stat = Adw.ActionRow(title="System Integrity Verifier", subtitle="Run deep verification on configs, fonts, and assets")
        btn_verify = Gtk.Button(label="Run Diagnostics")
        btn_verify.connect("clicked", self.run_diagnostics)
        row_stat.add_suffix(btn_verify)
        group.add(row_stat)

        row_wb = Adw.ActionRow(title="Status Bar / Shell Reload", subtitle="Enforce clean reload of Quickshell or Waybar")
        btn_wb = Gtk.Button(label="Restart Bar")
        btn_wb.connect("clicked", lambda b: (subprocess.run(["omarchy-detect-backend", "--reload-bar"], check=False), self.show_toast("Status bar reloaded cleanly!")))
        row_wb.add_suffix(btn_wb)
        group.add(row_wb)

        page.add(group)
        self.stack.add_titled(page, "diagnostics", "Diagnostics")

    def run_diagnostics(self, btn):
        cli = find_cli()
        try:
            out = subprocess.check_output([cli, "--verify"], text=True)
            self.show_toast("Diagnostics: All protocols passed integrity check!")
        except Exception as e:
            self.show_toast(f"Diagnostics error: {e}")

    def refresh_all_states(self):
        # Rebuild presets view
        self.stack.remove(self.stack.get_child_by_name("presets"))
        self.build_presets_page()

class UndercoverSettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        # Check command line flags to bypass splash if requested
        if "--settings" in sys.argv or "-s" in sys.argv:
            win = UndercoverAppWindow(self)
            win.present()
        else:
            # Show evaporating splash screen with 5s countdown
            splash = SplashScreenWindow(self)
            splash.present()

if __name__ == "__main__":
    app = UndercoverSettingsApp()
    sys.exit(app.run(sys.argv))
