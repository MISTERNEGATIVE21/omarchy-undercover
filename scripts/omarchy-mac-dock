#!/usr/bin/env bash
# =============================================================================
# 🍏 macOS Sequoia Native Quickshell Floating Dock Dispatcher
# Anchors the dock at the bottom of the screen via Quickshell Layer-Shell
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$HOME/.config/omarchy-undercover"

QS_DOCK_SRC="$CONFIG_DIR/quickshell/mac-dock"
if [[ ! -d "$QS_DOCK_SRC" && -d "${SCRIPT_DIR}/../configs/quickshell/mac-dock" ]]; then
    QS_DOCK_SRC="${SCRIPT_DIR}/../configs/quickshell/mac-dock"
fi

# Kill any previous instance of the dock
pkill -f "quickshell.*mac-dock" 2>/dev/null || true
pkill -f "omarchy-mac-dock-gtk" 2>/dev/null || true

if command -v quickshell >/dev/null 2>&1 && [[ -d "$QS_DOCK_SRC" ]]; then
    exec quickshell -p "$QS_DOCK_SRC"
else
    # Fallback to python GTK layer if needed
    echo "Quickshell not available or dock config missing." >&2
    exit 1
fi
