#!/usr/bin/env python3
"""
omarchy-bluetooth-dbus — Bluetooth control via BlueZ D-Bus API with bluetoothctl fallbacks.

Subcommands (used by Quickshell flyouts & menus):
  power          -> prints "yes" / "no"
  on / off       -> powers the adapter on/off
  scan           -> runs discovery (~1.5s) then prints in mac|connected|name format
  discover       -> runs discovery (~1.5s) then prints in Device MAC NAME format
  list           -> prints known devices in Device MAC NAME format
  listwin        -> prints known devices in mac|connected|name format
  connect <mac>  -> connects a device
  disconnect <mac> -> disconnects a device
  pair <mac>     -> pairs a device
"""

import subprocess
import sys
import time

import dbus

BLUEZ_BUS = "org.bluez"
DBUS_OM = "org.freedesktop.DBus.ObjectManager"
DBUS_PROPS = "org.freedesktop.DBus.Properties"
ADAPTER_IFACE = "org.bluez.Adapter1"
DEVICE_IFACE = "org.bluez.Device1"


def get_bus():
    return dbus.SystemBus()


def get_managed():
    try:
        bus = get_bus()
        om = bus.get_object(BLUEZ_BUS, "/")
        return dbus.Interface(om, DBUS_OM).GetManagedObjects()
    except Exception:
        return {}


def get_adapter(managed):
    for path, ifaces in managed.items():
        if ADAPTER_IFACE in ifaces:
            return path, ifaces[ADAPTER_IFACE]
    return None, None


def get_devices(managed):
    devs = []
    for path, ifaces in managed.items():
        if DEVICE_IFACE in ifaces:
            devs.append((path, ifaces[DEVICE_IFACE]))
    return devs


def adapter_powered():
    try:
        managed = get_managed()
        _, props = get_adapter(managed)
        if props is not None:
            return bool(props.get("Powered", False))
    except Exception:
        pass
    res = subprocess.run(["bluetoothctl", "show"], capture_output=True, text=True)
    return "Powered: yes" in res.stdout


def set_adapter_powered(enabled):
    try:
        bus = get_bus()
        managed = get_managed()
        path, _ = get_adapter(managed)
        if path is not None:
            obj = bus.get_object(BLUEZ_BUS, path)
            dbus.Interface(obj, DBUS_PROPS).Set(ADAPTER_IFACE, "Powered", enabled)
            return
    except Exception:
        pass
    subprocess.run(["bluetoothctl", "power", "on" if enabled else "off"], check=False)


def cmd_power():
    print("yes" if adapter_powered() else "no")


def cmd_set(kind):
    set_adapter_powered(kind == "on")
    print("ok")


def _trigger_discovery(duration=1.5):
    try:
        bus = get_bus()
        managed = get_managed()
        path, _ = get_adapter(managed)
        if path is not None:
            obj = bus.get_object(BLUEZ_BUS, path)
            adapter = dbus.Interface(obj, ADAPTER_IFACE)
            try:
                adapter.StartDiscovery()
            except Exception:
                pass
            time.sleep(duration)
            try:
                adapter.StopDiscovery()
            except Exception:
                pass
    except Exception:
        pass


def cmd_discover():
    _trigger_discovery(1.5)
    cmd_list()


def cmd_scan():
    _trigger_discovery(1.5)
    cmd_listwin()


def cmd_list():
    managed = get_managed()
    devices = get_devices(managed)
    if devices:
        for path, props in devices:
            name = props.get("Alias") or props.get("Name") or ""
            mac = props.get("Address", "")
            if not mac:
                continue
            print("Device %s %s" % (mac, name))
    else:
        res = subprocess.run(["bluetoothctl", "devices"], capture_output=True, text=True)
        for line in res.stdout.splitlines():
            line = line.strip()
            if line:
                print(line)


def cmd_listwin():
    managed = get_managed()
    devices = get_devices(managed)
    seen = set()
    if devices:
        for path, props in devices:
            name = props.get("Alias") or props.get("Name") or ""
            mac = props.get("Address", "")
            if not mac:
                continue
            connected = "1" if props.get("Connected", False) else "0"
            seen.add(mac)
            print("%s|%s|%s" % (mac, connected, name))

    # Fallback/complement with bluetoothctl devices
    res = subprocess.run(["bluetoothctl", "devices"], capture_output=True, text=True)
    for line in res.stdout.splitlines():
        parts = line.strip().split(" ", 2)
        if len(parts) >= 3 and parts[0] == "Device":
            mac = parts[1]
            if mac not in seen:
                name = parts[2]
                print("%s|0|%s" % (mac, name))


def _device_call(mac, method, fallback_cmd=None):
    bus = get_bus()
    managed = get_managed()
    target = None
    for path, props in get_devices(managed):
        if props.get("Address") == mac:
            target = path
            break
    if target is not None:
        try:
            obj = bus.get_object(BLUEZ_BUS, target)
            iface = dbus.Interface(obj, DEVICE_IFACE)
            getattr(iface, method)()
            print("ok")
            return
        except Exception:
            pass

    # Fallback to bluetoothctl
    if fallback_cmd:
        res = subprocess.run(["bluetoothctl", fallback_cmd, mac], capture_output=True, text=True)
        if res.returncode == 0:
            print("ok")
        else:
            print(res.stdout.strip() or res.stderr.strip() or "failed")
    else:
        print("failed")


def cmd_connect(mac):
    _device_call(mac, "Connect", "connect")


def cmd_disconnect(mac):
    _device_call(mac, "Disconnect", "disconnect")


def cmd_pair(mac):
    _device_call(mac, "Pair", "pair")


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "power"
    if cmd == "power":
        cmd_power()
    elif cmd in ("on", "off"):
        cmd_set(cmd)
    elif cmd in ("discover", "scan_mac"):
        cmd_discover()
    elif cmd in ("scan", "discoverwin"):
        cmd_scan()
    elif cmd == "list":
        cmd_list()
    elif cmd == "listwin":
        cmd_listwin()
    elif cmd == "connect" and len(args) > 1:
        cmd_connect(args[1])
    elif cmd == "disconnect" and len(args) > 1:
        cmd_disconnect(args[1])
    elif cmd == "pair" and len(args) > 1:
        cmd_pair(args[1])
    else:
        cmd_power()


if __name__ == "__main__":
    main()