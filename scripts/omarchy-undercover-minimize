#!/usr/bin/env bash
# ==============================================================================
# Copyright (C) 2026 misternegative21
# Omarchy Undercover - Minimize Window (Win+M)
# License: GPL-3.0-or-later
#
# omarchy:summary=Minimize the active window to the minimized scratchpad (toggle)
# omarchy:args=[toggle]
# omarchy:examples=omarchy-undercover-minimize
# ==============================================================================
#
# Hyprland has no native minimize, so the active window is moved to the
# special:minimized workspace. Pressing Win+M again restores it.
#
# Dispatch uses the Hyprland Lua form first (0.55+) and falls back to the
# legacy hyprlang syntax for older releases.

CONFIG_DIR="$HOME/.config/omarchy-undercover"
STATE_FILE="$CONFIG_DIR/minimize_state"

mkdir -p "$CONFIG_DIR"

if ! command -v hyprctl >/dev/null 2>&1; then
    exit 1
fi

move_window_to_ws() {
    local addr="$1" ws="$2"
    if hyprctl dispatch "hl.dsp.window.move({ window = \"address:$addr\", workspace = \"$ws\", follow = false })" >/dev/null 2>&1; then
        return 0
    fi
    hyprctl dispatch movetoworkspacesilent "$ws,address:$addr" >/dev/null 2>&1 || true
}

if [[ -f "$STATE_FILE" ]]; then
    while read -r address workspace; do
        [[ -n "$address" ]] && move_window_to_ws "$address" "$workspace"
    done < "$STATE_FILE"
    rm -f "$STATE_FILE"
    hyprctl dispatch "hl.dsp.workspace.toggle_special(\"minimized\")" >/dev/null 2>&1 || true
    exit 0
fi

active=$(hyprctl activewindow -j 2>/dev/null)
read -r address workspace <<< "$(printf '%s' "$active" | python3 -c '
import json, sys
try:
    w = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if w.get("mapped"):
    print(w.get("address", ""), w.get("workspace", {}).get("id", 1))
')"

if [[ -z "$address" || "$address" == "null" ]]; then
    exit 0
fi
[[ -z "$workspace" ]] && workspace="1"

echo "$address $workspace" > "$STATE_FILE"
move_window_to_ws "$address" "special:minimized"
