#!/usr/bin/env bash
# =============================================================================
# 🪟 Windows 11 Native Quickshell Task Manager Dispatcher
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export PATH="${SCRIPT_DIR}:${REAL_SCRIPT_DIR}:$HOME/.config/omarchy/plugins/omarchy-undercover/scripts:$PATH"

PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-win11-taskmanager.pid"

# 1. Instant toggle if already running
if [[ -f "$PID_FILE" ]]; then
    PID=$(cat "$PID_FILE" 2>/dev/null)
    if [[ -n "$PID" ]] && kill -0 "$PID" 2>/dev/null; then
        kill "$PID" 2>/dev/null || true
        rm -f "$PID_FILE"
        exit 0
    fi
    rm -f "$PID_FILE"
fi

if pgrep -f "quickshell.*win11-taskmanager" >/dev/null 2>&1; then
    pkill -f "quickshell.*win11-taskmanager" 2>/dev/null || true
    rm -f "$PID_FILE"
    exit 0
fi

# 2. Locate native Quickshell Task Manager dashboard
QS_SRC=""
for cand in \
    "${REAL_SCRIPT_DIR}/../configs/quickshell/win11-taskmanager" \
    "${SCRIPT_DIR}/../configs/quickshell/win11-taskmanager" \
    "$HOME/.config/omarchy/plugins/omarchy-undercover/configs/quickshell/win11-taskmanager" \
    "$HOME/omarchy-undercover/configs/quickshell/win11-taskmanager" \
    "/usr/share/omarchy-undercover/configs/quickshell/win11-taskmanager"; do
    if [[ -d "$cand" && -f "$cand/shell.qml" ]]; then
        QS_SRC="$cand"
        break
    fi
done

# 3. Launch native Task Manager
if [[ -n "$QS_SRC" ]] && command -v quickshell >/dev/null 2>&1; then
    echo $$ > "$PID_FILE"
    exec quickshell -p "$QS_SRC"
else
    # Fallback to btop or htop in terminal if quickshell is unavailable
    if command -v btop >/dev/null 2>&1; then
        exec xdg-terminal-exec -e btop
    elif command -v htop >/dev/null 2>&1; then
        exec xdg-terminal-exec -e htop
    else
        notify-send "Windows 11 Task Manager" "Could not locate Quickshell dashboard at $QS_SRC" -u low 2>/dev/null || true
        exit 1
    fi
fi
