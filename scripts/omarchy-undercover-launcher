#!/usr/bin/env bash
# ==============================================================================
# Copyright (C) 2026 misternegative21
# Omarchy Hyprland Undercover Launcher Dispatcher
# License: GPL-3.0-or-later
#
# omarchy:summary=Application launcher dispatcher styled for active camouflage preset
# omarchy:args=[]
# omarchy:examples=omarchy-undercover-launcher
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# 1. Instant toggle if already running
if pkill -f "quickshell.*win11-start" 2>/dev/null; then
    exit 0
fi
if pkill -f "omarchy-win11-startmenu" 2>/dev/null; then
    exit 0
fi
if pkill -x rofi 2>/dev/null; then
    exit 0
fi

# 2. Check current mode
STATE_FILE="$HOME/.config/omarchy/plugins/omarchy-undercover/state"
[[ ! -f "$STATE_FILE" && -f "${SCRIPT_DIR}/../state" ]] && STATE_FILE="${SCRIPT_DIR}/../state"

MODE="omarchy"
if [[ -f "$STATE_FILE" ]]; then
    MODE=$(cat "$STATE_FILE" 2>/dev/null | tr -d '[:space:]' || echo "omarchy")
fi

# Omarchy baseline: launch standard Omarchy launcher
if [[ "$MODE" == "omarchy" || "$MODE" == "default" ]]; then
    if command -v omarchy-menu &>/dev/null; then
        exec omarchy-menu
    elif command -v omarchy-launch &>/dev/null; then
        exec omarchy-launch
    elif command -v walker &>/dev/null; then
        exec walker
    elif command -v rofi &>/dev/null; then
        exec rofi -show drun
    else
        exit 0
    fi
fi

# Windows 11 mode: trigger Start menu
if [[ "$MODE" == *"win11"* ]] || [[ "$MODE" == *"windows"* ]]; then
    if [[ -x "${SCRIPT_DIR}/omarchy-win11-start" ]]; then
        exec "${SCRIPT_DIR}/omarchy-win11-start"
    elif [[ -x "${REAL_SCRIPT_DIR}/omarchy-win11-start" ]]; then
        exec "${REAL_SCRIPT_DIR}/omarchy-win11-start"
    elif command -v omarchy-win11-start &>/dev/null; then
        exec omarchy-win11-start
    elif [[ -f "$HOME/.local/bin/omarchy-win11-start" ]]; then
        exec "$HOME/.local/bin/omarchy-win11-start"
    fi
fi

# macOS mode: Spotlight search
ROFI_THEME=""
THEME_CANDIDATES=(
    "$HOME/.config/rofi/mac.rasi"
    "${REAL_SCRIPT_DIR}/../configs/rofi/mac.rasi"
    "${SCRIPT_DIR}/../configs/rofi/mac.rasi"
    "$HOME/.config/omarchy/plugins/omarchy-undercover/configs/rofi/mac.rasi"
    "$HOME/omarchy-undercover/configs/rofi/mac.rasi"
    "/usr/share/omarchy-undercover/configs/rofi/mac.rasi"
)

if [[ "$MODE" == *"win11"* ]]; then
    THEME_CANDIDATES=(
        "$HOME/.config/rofi/win11.rasi"
        "$HOME/.config/rofi/windows11.rasi"
        "${REAL_SCRIPT_DIR}/../configs/rofi/win11.rasi"
        "${SCRIPT_DIR}/../configs/rofi/win11.rasi"
        "$HOME/.config/omarchy/plugins/omarchy-undercover/configs/rofi/win11.rasi"
        "$HOME/omarchy-undercover/configs/rofi/win11.rasi"
    )
fi

for cand in "${THEME_CANDIDATES[@]}"; do
    if [[ -f "$cand" ]]; then
        ROFI_THEME="$cand"
        break
    fi
done

if command -v rofi &>/dev/null; then
    if [[ -n "$ROFI_THEME" && -f "$ROFI_THEME" ]]; then
        exec rofi -show drun -theme "$ROFI_THEME"
    else
        exec rofi -show drun
    fi
elif command -v omarchy-menu &>/dev/null; then
    exec omarchy-menu
elif command -v walker &>/dev/null; then
    exec walker
fi
