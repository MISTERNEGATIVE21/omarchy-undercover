#!/usr/bin/env bash
# ==============================================================================
# Copyright (C) 2026 John Varghese
# Omarchy Hyprland Undercover Launcher
# License: GPL-3.0-or-later
#
# omarchy:summary=Start menu launcher wrapper for Omarchy Undercover (with toggle/retract)
# omarchy:args=[drun|run|window]
# omarchy:examples=omarchy-undercover-launcher
# ==============================================================================

# Instant retract if rofi or wofi is already running
if pkill -x rofi 2>/dev/null; then
    exit 0
fi

if pkill -x wofi 2>/dev/null; then
    exit 0
fi

if command -v rofi &>/dev/null; then
    ROFI_THEME="$HOME/.config/rofi/windows11.rasi"
    if [[ ! -f "$ROFI_THEME" ]]; then
        ROFI_THEME="$HOME/.config/omarchy-undercover/rofi/windows11.rasi"
    fi

    if [[ -f "$ROFI_THEME" ]]; then
        rofi -show drun -theme "$ROFI_THEME"
    else
        rofi -show drun
    fi
elif command -v wofi &>/dev/null; then
    WOFI_CONF="$HOME/.config/omarchy-undercover/wofi/config"
    WOFI_STYLE="$HOME/.config/omarchy-undercover/wofi/style.css"
    if [[ -f "$WOFI_CONF" ]] && [[ -f "$WOFI_STYLE" ]]; then
        wofi --show drun --conf "$WOFI_CONF" --style "$WOFI_STYLE"
    else
        wofi --show drun
    fi
elif command -v omarchy-launch-walker &>/dev/null; then
    omarchy-launch-walker
else
    if command -v omarchy-notification-send &>/dev/null; then
        omarchy-notification-send "Omarchy Undercover Error" "No application launcher found (rofi, wofi, or walker)" -g "󰅙" -u "critical"
    else
        notify-send "Omarchy Undercover Error" "No launcher found (rofi, wofi, or walker)"
    fi
fi
