# 1. Instant toggle if already running
if pkill -f "omarchy-win11-startmenu" 2>/dev/null; then
    exit 0
fi
if pkill -x rofi 2>/dev/null; then
    exit 0
fi

# 2. Check current mode
STATE_FILE="$HOME/.config/omarchy-undercover/state"
MODE="mac-dark"
if [[ -f "$STATE_FILE" ]]; then
    MODE=$(cat "$STATE_FILE")
fi

if [[ "$MODE" == *"win11"* ]] || [[ "$MODE" == *"windows"* ]]; then
    if command -v omarchy-win11-start &>/dev/null; then
        exec omarchy-win11-start
    elif [[ -f "$HOME/.local/bin/omarchy-win11-start" ]]; then
        exec "$HOME/.local/bin/omarchy-win11-start"
    fi
fi

# Default to Spotlight macOS Rofi
ROFI_THEME="$HOME/.config/rofi/mac.rasi"
if [[ "$MODE" == *"win11"* ]] && [[ -f "$HOME/.config/rofi/win11.rasi" ]]; then
    ROFI_THEME="$HOME/.config/rofi/win11.rasi"
fi

if command -v rofi &>/dev/null && [[ -f "$ROFI_THEME" ]]; then
    exec rofi -show drun -theme "$ROFI_THEME"
else
    exec rofi -show drun
fi
