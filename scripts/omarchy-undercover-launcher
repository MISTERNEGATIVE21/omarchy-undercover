# License: GPL-3.0-or-later
# ==============================================================================

# 1. Instant toggle if already running
if pkill -f "quickshell.*win11-start" 2>/dev/null; then
    exit 0
fi
if pkill -f "omarchy-win11-startmenu" 2>/dev/null; then
    exit 0
fi
if pkill -x rofi 2>/dev/null; then
    exit 0
fi

# 2. Check current mode
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/undercover/state"
[[ ! -f "$STATE_FILE" && -f "$HOME/.config/omarchy-undercover/state" ]] && STATE_FILE="$HOME/.config/omarchy-undercover/state"

MODE="omarchy"
if [[ -f "$STATE_FILE" ]]; then
    MODE=$(cat "$STATE_FILE" 2>/dev/null | tr -d '[:space:]' || echo "omarchy")
fi

if [[ "$MODE" == "omarchy" || "$MODE" == "default" ]]; then
    if command -v omarchy-menu &>/dev/null; then
        exec omarchy-menu
    elif command -v omarchy-launch &>/dev/null; then
        exec omarchy-launch
    elif command -v walker &>/dev/null; then
        exec walker
    elif command -v rofi &>/dev/null; then
        exec rofi -show drun
    else
        exit 0
    fi
fi

if [[ "$MODE" == *"win11"* ]] || [[ "$MODE" == *"windows"* ]]; then
    if [[ -x "$(dirname "$0")/omarchy-win11-start" ]]; then
        exec "$(dirname "$0")/omarchy-win11-start"
    elif command -v omarchy-win11-start &>/dev/null; then
        exec omarchy-win11-start
    elif [[ -f "$HOME/.local/bin/omarchy-win11-start" ]]; then
        exec "$HOME/.local/bin/omarchy-win11-start"
    fi
fi

# Default to Spotlight macOS Rofi
ROFI_THEME="$HOME/.config/rofi/mac.rasi"
if [[ "$MODE" == *"win11"* ]] && [[ -f "$HOME/.config/rofi/win11.rasi" ]]; then
    ROFI_THEME="$HOME/.config/rofi/win11.rasi"
fi

if command -v rofi &>/dev/null && [[ -f "$ROFI_THEME" ]]; then
    exec rofi -show drun -theme "$ROFI_THEME"
else
    exec rofi -show drun
fi
